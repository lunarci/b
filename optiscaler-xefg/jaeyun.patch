+        // R3 uses the warning log level so routine existing trace/info traffic stays
+        // disabled. This explicitly tagged diagnostic is not a claim of a GPU fault.
+        LOG_WARN("[LongSession] t={}s changed={} pressure={} hitch={} "
+                 "local_valid={} local_MiB={:.1f}/{:.1f} nonlocal_valid={} nonlocal_MiB={:.1f}/{:.1f} "
+                 "private_valid={} private_MiB={:.1f} ram_valid={} available_ram_MiB={:.1f} "
+                 "present_max_ms={:.2f} gap_max_ms={:.2f} "
+                 "pacing_max_ms={:.2f} fence_max_ms={:.2f} tracking_max_ms={:.2f} fg_call_max_ms={:.2f} "
+                 "lifecycle_cpu_max_ms={:.2f} native_present_cpu_max_ms={:.2f} "
+                 "timing_calls_pacing_fence_tracking_fg_lifecycle_native={}/{}/{}/{}/{}/{} "
+                 "xefg_scope=owned_resourceCopy_global xefg_live_peak_copies={}/{} "
+                 "xefg_live_peak_alloc_est_MiB={:.2f}/{:.2f} xefg_unknown_size_copies={} "
+                 "xefg_alloc_release={}/{} xefg_cum_alloc_release_est_MiB={:.2f}/{:.2f} "
+                 "xefg_alloc_fail={} xefg_alias_preserved={} xefg_missing_depth_velocity_both={}/{}/{} "
+                 "xefg_missing_bursts_recovered_peak={}/{}/{} xefg_accounting_errors={} "
+                 "observer_ever_attempt_ok_fail_seen_masks={:X}/{:X}/{:X}/{:X} "
+                 "observer_calls_submit_reset_release={}/{}/{} "
+                 "work_scope=latest_published_context work_valid={} work_context={} work_snapshot_age_ms={} "
+                 "pending_current_peak={}/{} pending_registered_submitted_reset_destroyed={}/{}/{}/{} "
+                 "pending_age_known={} pending_oldest_observed_age_ms={} "
+                 "cleanup_state={} cleanup_reason={} cleanup_attempt_defer_complete_recover={}/{}/{}/{}",
+                 sample.elapsedMs / 1000, changed, pressure, sample.hitch,
+                 sample.localValid, sample.localUsage / mib, sample.localBudget / mib,
+                 sample.nonlocalValid, sample.nonlocalUsage / mib, sample.nonlocalBudget / mib,
+                 sample.processValid, sample.processPrivateBytes / mib,
+                 sample.physicalValid, sample.availablePhysicalBytes / mib,
+                 sample.presentMaxMs, sample.gapMaxMs,
+                 sample.waitMaxMs[0], sample.waitMaxMs[1], sample.waitMaxMs[2], sample.waitMaxMs[3],
+                 sample.waitMaxMs[4], sample.waitMaxMs[5],
