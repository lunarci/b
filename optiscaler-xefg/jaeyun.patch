+void XeFG_Dx12::ObservePresentStatus(UINT64 token, HRESULT nativeResult, int32_t queryResult,
+                                    uint32_t framesPresented, int32_t frameGenResult, bool enabled)
+{
+    auto work = AcquireWork();
+    if (!work) return;
+    const auto outcome = _recovery.Presented(token, nativeResult == S_OK, queryResult, framesPresented,
+                                            frameGenResult, enabled);
+    if (outcome > 0)
+        LOG_WARN("XeFG recovery confirmed by native Present: frames_presented={}, internal_frame={}",
+                 framesPresented, _frameCount);
+    else if (outcome < 0)
+        NoteRecoveryFault(_frameCount, enabled ? "provider_present" : "provider_disabled", frameGenResult);
 }
 
