+UINT64 XeFG_Dx12::PresentRecoveryToken()
+{
+    auto work = AcquireWork();
+    if (!work) return 0;
+    const bool expectedEnabled = _isActive && !IsPaused() && !_lifecycleFailed &&
+                                 _fgContext != nullptr && _swapChainContext != nullptr &&
+                                 Config::Instance()->FGEnabled.value_or_default();
+    return _recovery.PresentToken(expectedEnabled);
+}
