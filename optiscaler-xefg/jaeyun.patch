+void XeFG_Dx12::ReportFormatTransition(bool accepted, DXGI_FORMAT oldFormat, DXGI_FORMAT newFormat, UINT64 frame,
+                                      int slot, UINT64 width, UINT height)
+{
+    const unsigned index = accepted ? 1 : 0;
+    const auto count = _formatTransitions[index].fetch_add(1, std::memory_order_relaxed) + 1;
+    const auto now = XeFGDiagnostics::WorkNowMs();
+    auto last = _lastFormatLogMs[index].load(std::memory_order_relaxed);
+    if ((count == 1 || now - last >= 5000) &&
+        _lastFormatLogMs[index].compare_exchange_strong(last, now, std::memory_order_relaxed))
+        LOG_WARN("XeFG hudless format {}: old={} new={} slot={} internal_frame={} size={}x{} transitions={}",
+                 accepted ? "accepted" : "observed", static_cast<unsigned>(oldFormat),
+                 static_cast<unsigned>(newFormat), slot, frame, width, height, count);
+}
+
+void XeFG_Dx12::NoteRecoveryFault(UINT64 frame, const char* stage, int32_t result)
+{
+    const bool terminal = IsTerminalXeFGResult(result);
+    if (!_recovery.Fault(frame, XeFGDiagnostics::WorkNowMs(), terminal)) return;
+    RequestHistoryReset();
+    const auto now = XeFGDiagnostics::WorkNowMs();
+    auto last = _lastRecoveryLogMs.load(std::memory_order_relaxed);
+    if ((terminal || last == 0 || now - last >= 5000) &&
+        _lastRecoveryLogMs.compare_exchange_strong(last, now, std::memory_order_relaxed))
+        LOG_WARN("XeFG recovery requested: stage={}, result={}, internal_frame={}, needs_new_context={}; "
+                 "no resource release or multiplier change", stage, result, frame, terminal);
+}
+
+void XeFG_Dx12::PreparePresent()
+{
+    PollGpuProgress();
+    auto work = AcquireWork();
+    if (!work || _swapChainContext == nullptr || _lifecycleFailed) return;
+    _recovery.PreparePresent();
+    std::unique_lock action(_recoveryActionMutex, std::try_to_lock);
+    if (!action.owns_lock()) return;
+    const auto now = XeFGDiagnostics::WorkNowMs();
+    const auto ticket = _recovery.DisableTicket(now);
+    if (ticket == 0) return;
+    // No resource-map lock is held across this provider lifecycle call.
+    const auto result = XeFGProxy::SetEnabled()(_swapChainContext, false);
+    XeFGDiagnostics::RecordActivation(false, static_cast<int32_t>(result),
+                                       XeFGDiagnostics::ActivationReason::RecoveryDisable);
+    const bool success = result == XEFG_SWAPCHAIN_RESULT_SUCCESS;
+    if (success)
+    {
+        _isActive = false;
+        _waitingNewFrameData = false;
     }
+    const bool terminal = IsTerminalXeFGResult(static_cast<int32_t>(result));
+    _recovery.Disabled(ticket, success, now, terminal);
+    if (terminal)
+        LOG_WARN("XeFG recovery stopped: stage=disable result={} needs_new_context=true", static_cast<int32_t>(result));
+}
