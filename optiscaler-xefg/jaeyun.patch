diff --git a/OptiScaler/framegen/FGWorkGate.h b/OptiScaler/framegen/FGWorkGate.h
new file mode 100644
index 00000000..dddf44c1
--- /dev/null
+++ b/OptiScaler/framegen/FGWorkGate.h
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <mutex>
+#include <utility>
+
+// Admission, not a lock around driver calls. Closing rejects new work immediately
+// and waits for existing callers to leave without holding the mutex they need.
+class FGWorkGate
+{
+    std::mutex _mutex;
+    std::condition_variable _idle;
+    size_t _active = 0;
+    bool _closed = false;
+
+    void Leave()
+    {
+        std::lock_guard lock(_mutex);
+        if (--_active == 0)
+            _idle.notify_all();
+    }
+
+  public:
+    class Scope
+    {
+        friend class FGWorkGate;
+        FGWorkGate* _gate = nullptr;
+        explicit Scope(FGWorkGate* gate) : _gate(gate) {}
+
+      public:
+        Scope() = default;
+        Scope(const Scope&) = delete;
+        Scope& operator=(const Scope&) = delete;
+        Scope(Scope&& other) noexcept : _gate(std::exchange(other._gate, nullptr)) {}
+        Scope& operator=(Scope&& other) noexcept
+        {
+            if (this != &other)
+            {
+                if (_gate != nullptr)
+                    _gate->Leave();
+                _gate = std::exchange(other._gate, nullptr);
+            }
+            return *this;
+        }
+        ~Scope()
+        {
+            if (_gate != nullptr)
+                _gate->Leave();
+        }
+        explicit operator bool() const { return _gate != nullptr; }
+    };
+
+    Scope TryEnter()
+    {
+        std::lock_guard lock(_mutex);
+        if (_closed)
+            return {};
+        ++_active;
+        return Scope(this);
+    }
+
+    bool CloseAndWait(std::chrono::milliseconds timeout)
+    {
+        std::unique_lock lock(_mutex);
+        _closed = true;
+        return _idle.wait_for(lock, timeout, [this] { return _active == 0; });
+    }
+
+    // Recoverable lifecycle changes must never stall a render callback. Failure
+    // leaves admission unchanged so existing and new work can continue normally.
+    bool TryCloseWhenIdle()
+    {
+        std::lock_guard lock(_mutex);
+        if (_active != 0)
+            return false;
+        _closed = true;
+        return true;
+    }
+
+    // For object destruction only: the owner must not destroy this gate while a
+    // CPU caller still holds a Scope. Never call while holding the loader lock.
+    void CloseAndWait()
+    {
+        std::unique_lock lock(_mutex);
+        _closed = true;
+        _idle.wait(lock, [this] { return _active == 0; });
+    }
+
+    bool Open()
+    {
+        std::lock_guard lock(_mutex);
+        if (_active != 0)
+            return false;
+        _closed = false;
+        return true;
+    }
+
+    bool IsClosed()
+    {
+        std::lock_guard lock(_mutex);
+        return _closed;
+    }
+};
