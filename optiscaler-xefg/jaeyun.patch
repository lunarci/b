+// Put one scope around an original game Present/Present1 call. Nested calls on
+// the same thread are intentionally ignored; do not instrument generated frames.
+class PresentScope
+{
+  public:
+    PresentScope(IDXGISwapChain* swapchain, ID3D12Device* device) :
+        _swapchain(swapchain), _device(device), _outermost(Depth()++ == 0)
+    {
+        if (_outermost)
+            _start = Clock::now();
+    }
+
+    ~PresentScope()
+    {
+        --Depth();
+        if (_outermost)
+            Monitor::Instance().Observe(_swapchain, _device,
+                std::chrono::duration<double, std::milli>(Clock::now() - _start).count());
+    }
+
+    PresentScope(const PresentScope&) = delete;
+    PresentScope& operator=(const PresentScope&) = delete;
+
+  private:
+    static unsigned& Depth()
+    {
+        static thread_local unsigned depth = 0;
+        return depth;
+    }
+    IDXGISwapChain* _swapchain;
+    ID3D12Device* _device;
+    bool _outermost;
+    Clock::time_point _start {};
+};
