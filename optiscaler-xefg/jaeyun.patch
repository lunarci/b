+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+// No Windows types here: the state transitions can be tested without a GPU.
+namespace LongSession
+{
+enum class Pressure : unsigned char
+{
+    Normal,
+    Elevated,
+    Critical
+};
+
+class PressureState
+{
+  public:
+    Pressure Update(std::uint64_t usage, std::uint64_t budget)
+    {
+        // An unavailable/zero budget is not evidence that pressure has recovered.
+        if (budget == 0)
+        {
+            _recoverySamples = 0;
+            return _value;
+        }
+
+        const double fraction = static_cast<double>(usage) / static_cast<double>(budget);
+        if (fraction >= 0.95)
+        {
+            _value = Pressure::Critical;
+            _recoverySamples = 0;
+        }
+        else if (_value == Pressure::Normal && fraction >= 0.90)
+        {
+            _value = Pressure::Elevated;
+            _recoverySamples = 0;
+        }
+        else
+        {
+            const bool canRecover = (_value == Pressure::Critical && fraction < 0.90) ||
+                                    (_value == Pressure::Elevated && fraction < 0.85);
+            if (canRecover && ++_recoverySamples >= 3)
+            {
+                _value = fraction < 0.85 ? Pressure::Normal : Pressure::Elevated;
+                _recoverySamples = 0;
+            }
+            else if (!canRecover)
+                _recoverySamples = 0;
+        }
+        return _value;
+    }
+
+    Pressure Value() const { return _value; }
+    unsigned RecoverySamples() const { return _recoverySamples; }
+
+  private:
+    Pressure _value = Pressure::Normal;
+    unsigned _recoverySamples = 0;
+};
+
+class HitchState
+{
+  public:
+    bool Update(double presentMaxMs, double gapMaxMs)
+    {
+        const bool bad = (std::isfinite(presentMaxMs) && presentMaxMs >= 250.0) ||
+                         (std::isfinite(gapMaxMs) && gapMaxMs >= 500.0);
+        if (bad)
+        {
+            _active = true;
+            _recoverySamples = 0;
+        }
+        else if (_active && ++_recoverySamples >= 3)
+        {
+            _active = false;
+            _recoverySamples = 0;
+        }
+        return _active;
+    }
+
+  private:
+    bool _active = false;
+    unsigned _recoverySamples = 0;
+};
+
+struct MemoryWindowSnapshot
+{
+    std::uint64_t samples = 0, firstTickMs = 0, lastTickMs = 0;
+    std::uint64_t usageMin = 0, usageMax = 0, budgetMin = 0, budgetMax = 0;
+    std::uint64_t observedIncrease = 0, observedDecrease = 0;
+    std::uint64_t increaseIntervalMs = 0, decreaseIntervalMs = 0;
+};
+
+// Fixed-size observations, not a continuous memory trace. A delta spans two
+// successful samples; an unavailable sample breaks that comparison chain.
+class MemoryWindow
+{
+  public:
+    void Observe(std::uint64_t tickMs, bool valid, std::uint64_t usage, std::uint64_t budget)
+    {
+        _latestChange = 0;
+        if (!valid || budget == 0)
+        {
+            _previousValid = false;
+            return;
+        }
+        if (_summary.samples++ == 0)
+        {
+            _summary.firstTickMs = tickMs;
+            _summary.usageMin = _summary.usageMax = usage;
+            _summary.budgetMin = _summary.budgetMax = budget;
+        }
+        _summary.lastTickMs = tickMs;
+        if (usage < _summary.usageMin) _summary.usageMin = usage;
+        if (usage > _summary.usageMax) _summary.usageMax = usage;
+        if (budget < _summary.budgetMin) _summary.budgetMin = budget;
+        if (budget > _summary.budgetMax) _summary.budgetMax = budget;
+        if (_previousValid && tickMs >= _previousTickMs)
+        {
+            const auto interval = tickMs - _previousTickMs;
+            if (usage >= _previousUsage)
+            {
+                _latestChange = usage - _previousUsage;
+                if (_latestChange > _summary.observedIncrease)
+                {
+                    _summary.observedIncrease = _latestChange;
+                    _summary.increaseIntervalMs = interval;
+                }
+            }
+            else
+            {
+                _latestChange = _previousUsage - usage;
+                if (_latestChange > _summary.observedDecrease)
+                {
+                    _summary.observedDecrease = _latestChange;
+                    _summary.decreaseIntervalMs = interval;
+                }
+            }
+        }
+        _previousValid = true;
+        _previousUsage = usage;
+        _previousTickMs = tickMs;
+    }
+    MemoryWindowSnapshot Snapshot() const { return _summary; }
+    std::uint64_t LatestObservedChange() const { return _latestChange; }
+    void ResetWindow() { _summary = {}; }
+  private:
+    MemoryWindowSnapshot _summary;
+    std::uint64_t _previousTickMs = 0, _previousUsage = 0, _latestChange = 0;
+    bool _previousValid = false;
+};
+
+enum class CaptureEvent : unsigned char
+{
+    None, Initial, PressureEnter, PressureWorsened, PressureEased, PressureNormalized,
+    HitchStart, HitchEnd, NativeSlow, MemoryStep, Periodic
+};
+
+inline const char* CaptureEventName(CaptureEvent event)
+{
+    switch (event)
+    {
+    case CaptureEvent::Initial: return "initial";
+    case CaptureEvent::PressureEnter: return "pressure_enter";
+    case CaptureEvent::PressureWorsened: return "pressure_worsened";
+    case CaptureEvent::PressureEased: return "pressure_eased";
+    case CaptureEvent::PressureNormalized: return "pressure_normalized";
+    case CaptureEvent::HitchStart: return "cpu_hitch_start";
+    case CaptureEvent::HitchEnd: return "cpu_hitch_end";
+    case CaptureEvent::NativeSlow: return "native_cpu_slow";
+    case CaptureEvent::MemoryStep: return "observed_memory_step";
+    case CaptureEvent::Periodic: return "periodic";
+    default: return "none";
+    }
+}
+
+// Logging decisions only. A pressure epoch ends after hysteresis reports normal;
+// "eased/normalized" describes sampled budget pressure, never gameplay recovery.
+class CapturePolicy
+{
+  public:
+    CaptureEvent Observe(std::uint64_t now, Pressure pressure, bool hitch,
+                         double nativeCpuMaxMs, std::uint64_t observedMemoryChange)
+    {
+        if (_initialized && now < _lastObservedMs) *this = {};
+        _lastObservedMs = now;
+        const auto previousPressure = _pressure;
+        const bool previousHitch = _hitch;
+        _pressure = pressure;
+        _hitch = hitch;
+        if (previousPressure == Pressure::Normal && pressure != Pressure::Normal)
+        {
+            ++_epoch;
+            _pressureSinceMs = now;
+        }
+        CaptureEvent event = CaptureEvent::None;
+        if (!_initialized) event = CaptureEvent::Initial;
+        else if (pressure != previousPressure)
+        {
+            if (pressure == Pressure::Normal) event = CaptureEvent::PressureNormalized;
+            else if (previousPressure == Pressure::Normal) event = CaptureEvent::PressureEnter;
+            else if (static_cast<unsigned>(pressure) > static_cast<unsigned>(previousPressure))
+                event = CaptureEvent::PressureWorsened;
+            else event = CaptureEvent::PressureEased;
+        }
+        else if (hitch != previousHitch) event = hitch ? CaptureEvent::HitchStart : CaptureEvent::HitchEnd;
+        else if (now - _lastEventLogMs >= 10000)
+        {
+            if (std::isfinite(nativeCpuMaxMs) && nativeCpuMaxMs >= 75.0)
+                event = CaptureEvent::NativeSlow;
+            else if (observedMemoryChange >= 512ULL * 1024 * 1024)
+                event = CaptureEvent::MemoryStep;
+        }
+        if (event == CaptureEvent::None && now - _lastLogMs >= 30000) event = CaptureEvent::Periodic;
+        _initialized = true;
+        if (event != CaptureEvent::None)
+        {
+            _lastLogMs = now;
+            _lastEventLogMs = now;
+        }
+        return event;
+    }
+    std::uint64_t Epoch() const { return _epoch; }
+    std::uint64_t PressureAgeMs(std::uint64_t now) const
+    {
+        return _pressure != Pressure::Normal && now >= _pressureSinceMs ? now - _pressureSinceMs : 0;
+    }
+  private:
+    bool _initialized = false, _hitch = false;
+    Pressure _pressure = Pressure::Normal;
+    std::uint64_t _epoch = 0, _pressureSinceMs = 0, _lastLogMs = 0, _lastEventLogMs = 0, _lastObservedMs = 0;
+};
+
+// Limit this feature's contribution to the existing log, including its final cap message.
+class LogBudget
+{
+  public:
+    static constexpr unsigned MaximumEntries = 1024;
+
+    bool Take()
+    {
+        if (_entries >= MaximumEntries)
+            return false;
+        ++_entries;
+        return true;
+    }
+
+    bool IsFinalEntry() const { return _entries == MaximumEntries; }
+
+  private:
+    unsigned _entries = 0;
+};
+} // namespace LongSession
diff --git a/OptiScaler/misc/LongSessionTiming.h b/OptiScaler/misc/LongSessionTiming.h
new file mode 100644
index 00000000..52d3cae0
--- /dev/null
+++ b/OptiScaler/misc/LongSessionTiming.h
@@ -0,0 +1,114 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+
+// Small, platform-neutral CPU timing counters. No logger, graphics API, or waits.
+namespace LongSession
+{
+using Clock = std::chrono::steady_clock;
+
+enum class WaitStage : unsigned char
+{
+    Pacing,
+    GpuFence,
+    ResourceTracking,
+    FrameGeneration,
+    Lifecycle,
+    NativePresent,
+    ProviderStatus,
+    DiagnosticSample,
+    DiagnosticLog,
+    GpuProgress,
+    TrackedReleaseMutex,
+    TrackedReleaseProbe,
+    TrackedReleaseNative,
+    Count
+};
+
+struct WaitCounter
+{
+    std::atomic<std::uint64_t> maximumUs { 0 };
+    std::atomic<std::uint64_t> calls { 0 };
+    std::atomic<std::uint64_t> totalUs { 0 };
+};
+
+inline std::array<WaitCounter, static_cast<unsigned>(WaitStage::Count)>& WaitCounters()
+{
+    static std::array<WaitCounter, static_cast<unsigned>(WaitStage::Count)> counters {};
+    return counters;
+}
+
+inline void RecordWait(WaitStage stage, double milliseconds)
+{
+    const auto index = static_cast<unsigned>(stage);
+    if (index >= static_cast<unsigned>(WaitStage::Count) || !std::isfinite(milliseconds) || milliseconds < 0.0)
+        return;
+
+    WaitCounters()[index].calls.fetch_add(1, std::memory_order_relaxed);
+
+    // Saturate before converting to an integer. A 24-hour stall is ample range.
+    constexpr double maximumMs = 86400000.0;
+    const auto us = static_cast<std::uint64_t>((milliseconds < maximumMs ? milliseconds : maximumMs) * 1000.0);
+    // Independently sampled atomics give an approximate CPU mean at a window
+    // boundary. No lock or per-call allocation is introduced for diagnostics.
+    WaitCounters()[index].totalUs.fetch_add(us, std::memory_order_relaxed);
+    auto& maximum = WaitCounters()[index].maximumUs;
+    auto old = maximum.load(std::memory_order_relaxed);
+    // Diagnostic contention must not extend a render critical section.
+    for (unsigned attempt = 0; attempt < 4 && old < us; ++attempt)
+        if (maximum.compare_exchange_weak(old, us, std::memory_order_relaxed))
+            break;
+}
+
+class WaitScope
+{
+  public:
+    explicit WaitScope(WaitStage stage) : _stage(stage), _start(Clock::now()) {}
+    ~WaitScope()
+    {
+        RecordWait(_stage, std::chrono::duration<double, std::milli>(Clock::now() - _start).count());
+    }
+    WaitScope(const WaitScope&) = delete;
+    WaitScope& operator=(const WaitScope&) = delete;
+
+  private:
+    WaitStage _stage;
+    Clock::time_point _start;
+};
+
+// Share one decision across related scopes in a hot callback. Unselected calls
+// perform no clock reads; sampled maxima cannot represent unsampled calls.
+inline bool ShouldSampleWait(WaitStage identity)
+{
+    const auto index = static_cast<unsigned>(identity);
+    if (index >= static_cast<unsigned>(WaitStage::Count)) return false;
+    static thread_local std::array<unsigned char, static_cast<unsigned>(WaitStage::Count)> calls {};
+    calls[index] = static_cast<unsigned char>((calls[index] + 1) & 63);
+    return calls[index] == 0;
+}
+
+class SampledWaitScope
+{
+  public:
+    SampledWaitScope(WaitStage stage, bool selected) : _stage(stage), _selected(selected)
+    {
+        if (_selected) _start = Clock::now();
+    }
+    ~SampledWaitScope()
+    {
+        if (_selected)
+            RecordWait(_stage, std::chrono::duration<double, std::milli>(Clock::now() - _start).count());
+    }
+    SampledWaitScope(const SampledWaitScope&) = delete;
+    SampledWaitScope& operator=(const SampledWaitScope&) = delete;
+  private:
+    WaitStage _stage;
+    bool _selected;
+    Clock::time_point _start {};
+};
+
+} // namespace LongSession
diff --git a/OptiScaler/misc/ResidencyDiagnostics.h b/OptiScaler/misc/ResidencyDiagnostics.h
new file mode 100644
index 00000000..f5d61d52
--- /dev/null
+++ b/OptiScaler/misc/ResidencyDiagnostics.h
@@ -0,0 +1,87 @@
+#pragma once
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <cstddef>
+#include <mutex>
+
+namespace ResidencyDiagnostics
+{
+enum class Caller : uint8_t { XeFG, XeSS, Other, Unknown };
+struct Snapshot
+{
+    uint64_t calls = 0, failures = 0, compatibilityMasks = 0;
+    int32_t lastFailure = 0;
+    uint32_t lastObjects = 0;
+    Caller lastCaller = Caller::Unknown;
+    bool lastMasked = false;
+};
+inline std::atomic<uint64_t> calls { 0 }, failures { 0 }, compatibilityMasks { 0 };
+inline std::array<std::atomic<uint32_t>, 8> logCounts {};
+inline std::mutex detailMutex;
+inline Snapshot lastDetail;
+inline bool ShouldApplyCompatibility(int32_t result, Caller caller, bool knownAmd)
+{
+    return result == static_cast<int32_t>(0x80070057u) && knownAmd &&
+           (caller == Caller::XeFG || caller == Caller::XeSS);
+}
+inline size_t FailureClass(int32_t result, bool masked)
+{
+    if (masked) return 0;
+    switch (static_cast<uint32_t>(result))
+    {
+    case 0x80070057u: return 1; // E_INVALIDARG
+    case 0x8007000Eu: return 2; // E_OUTOFMEMORY
+    case 0x887A0005u: return 3; // DXGI_ERROR_DEVICE_REMOVED
+    case 0x887A0006u: return 4; // DXGI_ERROR_DEVICE_HUNG
+    case 0x887A0007u: return 5; // DXGI_ERROR_DEVICE_RESET
+    case 0x887A0001u: return 6; // DXGI_ERROR_INVALID_CALL
+    default: return 7;
+    }
+}
+// No COM calls or input-array reads. Four logs per error class, 32 total, so
+// repeated compatibility failures cannot hide a later device-removed error.
+inline bool Record(int32_t originalResult, Caller caller, uint32_t objects, bool masked)
+{
+    calls.fetch_add(1, std::memory_order_relaxed);
+    if (originalResult >= 0)
+        return false;
+    failures.fetch_add(1, std::memory_order_relaxed);
+    if (masked)
+        compatibilityMasks.fetch_add(1, std::memory_order_relaxed);
+    {
+        std::lock_guard lock(detailMutex);
+        lastDetail.lastFailure = originalResult;
+        lastDetail.lastObjects = objects;
+        lastDetail.lastCaller = caller;
+        lastDetail.lastMasked = masked;
+    }
+    auto& logs = logCounts[FailureClass(originalResult, masked)];
+    auto count = logs.load(std::memory_order_relaxed);
+    while (count < 4)
+        if (logs.compare_exchange_weak(count, count + 1, std::memory_order_relaxed))
+            return true;
+    return false;
+}
+inline const char* CallerName(Caller caller)
+{
+    switch (caller)
+    {
+    case Caller::XeFG: return "xefg";
+    case Caller::XeSS: return "xess";
+    case Caller::Other: return "other";
+    default: return "unknown";
+    }
+}
+inline bool TryReadSnapshot(Snapshot& snapshot)
+{
+    std::unique_lock lock(detailMutex, std::try_to_lock);
+    if (!lock.owns_lock())
+        return false;
+    snapshot = lastDetail;
+    snapshot.calls = calls.load(std::memory_order_relaxed);
+    snapshot.failures = failures.load(std::memory_order_relaxed);
+    snapshot.compatibilityMasks = compatibilityMasks.load(std::memory_order_relaxed);
+    return true;
+}
+}
diff --git a/OptiScaler/misc/XeFGPresentDiagnostics.h b/OptiScaler/misc/XeFGPresentDiagnostics.h
new file mode 100644
index 00000000..f0378625
--- /dev/null
+++ b/OptiScaler/misc/XeFGPresentDiagnostics.h
@@ -0,0 +1,303 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+
+// Observations only. No SDK calls, locks, resource references or recovery policy.
+// Totals are process-cumulative; a concurrent snapshot is approximate.
+namespace XeFGDiagnostics
+{
+enum class InputKind : unsigned char { Depth, Velocity, Hudless, UI, Distortion, Other, Count };
+enum class InputReason : unsigned char
+{
+    Accepted, AdmissionClosed, ContextUnavailable, Inactive, InvalidInput, InvalidIndex,
+    DuplicateOrPolicy, Unsupported, ObserverUnavailable, CopyFailure, MissingCommandList,
+    ProviderRejected, RecoveryBackoff, StaleFrame, Other, Count
+};
+enum class ActivationReason : unsigned char
+{
+    Normal, RecoveryDisable, RecoveryEnable, LifecycleDisable, LifecycleRestore, ForceXeLL, Count
+};
+
+struct PresentSnapshot
+{
+    std::uint64_t calls = 0, testCalls = 0, nativeFailures = 0, nativeNonzeroSuccess = 0;
+    std::uint64_t apiUnavailable = 0, querySuccess = 0, queryWarnings = 0, queryErrors = 0;
+    std::uint64_t ambiguous = 0, validSamples = 0, enabledSamples = 0, disabledSamples = 0;
+    std::uint64_t frameSuccess = 0, frameWarnings = 0, frameErrors = 0;
+    std::uint64_t queuedFrames = 0;
+    // Number of provider-reported queued frames: 0,1,2,3,4,5,6,greater than 6.
+    std::array<std::uint64_t, 8> queuedHistogram {};
+    std::int32_t lastNative = 0, lastQuery = 0, lastFrameResult = 0;
+    std::int32_t lastNonzeroQuery = 0, lastNonzeroFrameResult = 0;
+    std::uint32_t lastQueuedFrames = 0;
+    bool lastEnabled = false;
+    std::array<std::uint64_t, static_cast<unsigned>(InputKind::Count)> inputAccepted {}, inputRejected {};
+    std::array<std::uint64_t, static_cast<unsigned>(InputReason::Count)> inputReasons {};
+    std::array<std::uint64_t, static_cast<unsigned>(InputKind::Count)> tagsAccepted {}, tagsRejected {};
+    std::uint64_t tagWarnings = 0;
+    std::int32_t lastTagResult = 0, lastNonzeroTagResult = 0;
+    std::array<std::uint64_t, static_cast<unsigned>(ActivationReason::Count)> activationReasons {};
+    std::uint64_t enableRequests = 0, disableRequests = 0, activationWarnings = 0, activationErrors = 0;
+    std::int32_t lastActivationResult = 0;
+    ActivationReason lastActivationReason = ActivationReason::Normal;
+    bool activationKnown = false, lastRequestedEnabled = false, lastAcceptedEnabled = false;
+    bool versionKnown = false, heapRequirementsKnown = false;
+    std::uint16_t versionMajor = 0, versionMinor = 0, versionPatch = 0;
+    std::uint64_t requiredBufferBytes = 0, requiredTextureBytes = 0, requiredConstantBytes = 0;
+    bool interpolationKnown = false, configuredExplicit = false;
+    std::uint32_t maxInitializedInterpolations = 0, activeInterpolations = 0;
+    std::int32_t configuredInterpolations = 0;
+};
+
+namespace PresentDetail
+{
+struct Counters
+{
+    std::atomic<std::uint64_t> inFlight { 0 }, overlapGeneration { 0 };
+    std::atomic<std::uint64_t> calls { 0 }, testCalls { 0 }, nativeFailures { 0 }, nativeNonzeroSuccess { 0 };
+    std::atomic<std::uint64_t> apiUnavailable { 0 }, querySuccess { 0 }, queryWarnings { 0 }, queryErrors { 0 };
+    std::atomic<std::uint64_t> ambiguous { 0 }, validSamples { 0 }, enabledSamples { 0 }, disabledSamples { 0 };
+    std::atomic<std::uint64_t> frameSuccess { 0 }, frameWarnings { 0 }, frameErrors { 0 }, queuedFrames { 0 };
+    std::array<std::atomic<std::uint64_t>, 8> queuedHistogram {};
+    std::atomic<std::int32_t> lastNative { 0 }, lastQuery { 0 }, lastFrameResult { 0 };
+    std::atomic<std::int32_t> lastNonzeroQuery { 0 }, lastNonzeroFrameResult { 0 };
+    std::atomic<std::uint32_t> lastQueuedFrames { 0 };
+    std::atomic<bool> lastEnabled { false };
+    std::array<std::atomic<std::uint64_t>, static_cast<unsigned>(InputKind::Count)> inputAccepted {}, inputRejected {};
+    std::array<std::atomic<std::uint64_t>, static_cast<unsigned>(InputReason::Count)> inputReasons {};
+    std::array<std::atomic<std::uint64_t>, static_cast<unsigned>(InputKind::Count)> tagsAccepted {}, tagsRejected {};
+    std::atomic<std::uint64_t> tagWarnings { 0 };
+    std::atomic<std::int32_t> lastTagResult { 0 }, lastNonzeroTagResult { 0 };
+    std::array<std::atomic<std::uint64_t>, static_cast<unsigned>(ActivationReason::Count)> activationReasons {};
+    std::atomic<std::uint64_t> enableRequests { 0 }, disableRequests { 0 }, activationWarnings { 0 }, activationErrors { 0 };
+    std::atomic<std::int32_t> lastActivationResult { 0 };
+    std::atomic<ActivationReason> lastActivationReason { ActivationReason::Normal };
+    std::atomic<bool> activationKnown { false }, lastRequestedEnabled { false }, lastAcceptedEnabled { false };
+    std::atomic<bool> versionKnown { false }, heapRequirementsKnown { false };
+    std::atomic<std::uint16_t> versionMajor { 0 }, versionMinor { 0 }, versionPatch { 0 };
+    std::atomic<std::uint64_t> requiredBufferBytes { 0 }, requiredTextureBytes { 0 }, requiredConstantBytes { 0 };
+    std::atomic<bool> interpolationKnown { false }, configuredExplicit { false };
+    std::atomic<std::uint32_t> maxInitializedInterpolations { 0 }, activeInterpolations { 0 };
+    std::atomic<std::int32_t> configuredInterpolations { 0 };
+};
+inline Counters& State() { static Counters counters; return counters; }
+inline unsigned KindIndex(InputKind kind)
+{
+    const auto value = static_cast<unsigned>(kind);
+    return value < static_cast<unsigned>(InputKind::Count) ? value : static_cast<unsigned>(InputKind::Other);
+}
+} // namespace PresentDetail
+
+// Scope the real native Present AND its immediate last-status query. TEST calls
+// also participate: the SDK documents that TEST overwrites last-present status.
+// Overlap is marked conservatively, never serialized just for diagnostics.
+class PresentObservation
+{
+  public:
+    explicit PresentObservation(bool test = false) : _test(test)
+    {
+        auto& state = PresentDetail::State();
+        _generation = state.overlapGeneration.load(std::memory_order_seq_cst);
+        _enteredOverlapping = state.inFlight.fetch_add(1, std::memory_order_seq_cst) != 0;
+        if (_enteredOverlapping)
+            state.overlapGeneration.fetch_add(1, std::memory_order_seq_cst);
+    }
+    ~PresentObservation() { PresentDetail::State().inFlight.fetch_sub(1, std::memory_order_seq_cst); }
+    PresentObservation(const PresentObservation&) = delete;
+    PresentObservation& operator=(const PresentObservation&) = delete;
+
+    // True means this sample can be associated with this successful non-TEST
+    // native Present. A positive SDK warning is not an error, but does not prove
+    // the output structure is valid (warning 5 means missing present status).
+    bool Record(std::int32_t nativeResult, bool apiAvailable, std::int32_t queryResult,
+                std::uint32_t framesPresented, std::int32_t frameGenResult, bool enabled)
+    {
+        if (_recorded)
+            return _trustworthy;
+        _recorded = true;
+        auto& state = PresentDetail::State();
+        _ambiguous = _enteredOverlapping ||
+            state.overlapGeneration.load(std::memory_order_seq_cst) != _generation ||
+            state.inFlight.load(std::memory_order_seq_cst) != 1;
+        if (_ambiguous)
+            state.ambiguous.fetch_add(1, std::memory_order_relaxed);
+        if (_test)
+        {
+            state.testCalls.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        }
+        state.calls.fetch_add(1, std::memory_order_relaxed);
+        state.lastNative.store(nativeResult, std::memory_order_relaxed);
+        if (nativeResult < 0)
+            state.nativeFailures.fetch_add(1, std::memory_order_relaxed);
+        else if (nativeResult > 0)
+            state.nativeNonzeroSuccess.fetch_add(1, std::memory_order_relaxed);
+        if (!apiAvailable)
+        {
+            state.apiUnavailable.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        }
+        state.lastQuery.store(queryResult, std::memory_order_relaxed);
+        if (queryResult != 0)
+            state.lastNonzeroQuery.store(queryResult, std::memory_order_relaxed);
+        if (queryResult == 0)
+            state.querySuccess.fetch_add(1, std::memory_order_relaxed);
+        else if (queryResult > 0)
+            state.queryWarnings.fetch_add(1, std::memory_order_relaxed);
+        else
+            state.queryErrors.fetch_add(1, std::memory_order_relaxed);
+        _trustworthy = nativeResult == 0 && queryResult == 0 && !_ambiguous;
+        if (!_trustworthy)
+            return false;
+        state.validSamples.fetch_add(1, std::memory_order_relaxed);
+        (enabled ? state.enabledSamples : state.disabledSamples).fetch_add(1, std::memory_order_relaxed);
+        state.lastEnabled.store(enabled, std::memory_order_relaxed);
+        state.lastQueuedFrames.store(framesPresented, std::memory_order_relaxed);
+        state.queuedFrames.fetch_add(framesPresented, std::memory_order_relaxed);
+        state.queuedHistogram[framesPresented <= 6 ? framesPresented : 7].fetch_add(1, std::memory_order_relaxed);
+        state.lastFrameResult.store(frameGenResult, std::memory_order_relaxed);
+        if (frameGenResult != 0)
+            state.lastNonzeroFrameResult.store(frameGenResult, std::memory_order_relaxed);
+        if (frameGenResult == 0)
+            state.frameSuccess.fetch_add(1, std::memory_order_relaxed);
+        else if (frameGenResult > 0)
+            state.frameWarnings.fetch_add(1, std::memory_order_relaxed);
+        else
+            state.frameErrors.fetch_add(1, std::memory_order_relaxed);
+        return true;
+    }
+    bool IsAmbiguous() const { return _ambiguous; }
+
+  private:
+    std::uint64_t _generation = 0;
+    bool _test = false, _enteredOverlapping = false, _recorded = false, _ambiguous = false, _trustworthy = false;
+};
+
+class InputObservation
+{
+  public:
+    explicit InputObservation(InputKind kind) : _kind(kind) {}
+    ~InputObservation()
+    {
+        auto& state = PresentDetail::State();
+        const auto kind = PresentDetail::KindIndex(_kind);
+        auto reason = static_cast<unsigned>(_reason);
+        if (reason >= static_cast<unsigned>(InputReason::Count))
+            reason = static_cast<unsigned>(InputReason::Other);
+        (_reason == InputReason::Accepted ? state.inputAccepted[kind] : state.inputRejected[kind])
+            .fetch_add(1, std::memory_order_relaxed);
+        state.inputReasons[reason].fetch_add(1, std::memory_order_relaxed);
+    }
+    InputObservation(const InputObservation&) = delete;
+    InputObservation& operator=(const InputObservation&) = delete;
+    void Accept() { _reason = InputReason::Accepted; }
+    void Reject(InputReason reason) { _reason = reason == InputReason::Accepted ? InputReason::Other : reason; }
+  private:
+    InputKind _kind;
+    InputReason _reason = InputReason::Other;
+};
+
+inline void RecordTagResult(InputKind kind, std::int32_t result)
+{
+    auto& state = PresentDetail::State();
+    const auto index = PresentDetail::KindIndex(kind);
+    (result >= 0 ? state.tagsAccepted[index] : state.tagsRejected[index]).fetch_add(1, std::memory_order_relaxed);
+    if (result > 0) state.tagWarnings.fetch_add(1, std::memory_order_relaxed);
+    state.lastTagResult.store(result, std::memory_order_relaxed);
+    if (result != 0) state.lastNonzeroTagResult.store(result, std::memory_order_relaxed);
+}
+
+inline void RecordActivation(bool requestedEnabled, std::int32_t providerResult, ActivationReason reason)
+{
+    auto& state = PresentDetail::State();
+    const auto index = static_cast<unsigned>(reason);
+    if (index < state.activationReasons.size()) state.activationReasons[index].fetch_add(1, std::memory_order_relaxed);
+    (requestedEnabled ? state.enableRequests : state.disableRequests).fetch_add(1, std::memory_order_relaxed);
+    if (providerResult > 0) state.activationWarnings.fetch_add(1, std::memory_order_relaxed);
+    if (providerResult < 0) state.activationErrors.fetch_add(1, std::memory_order_relaxed);
+    state.lastActivationReason.store(reason, std::memory_order_relaxed);
+    state.lastActivationResult.store(providerResult, std::memory_order_relaxed);
+    state.lastRequestedEnabled.store(requestedEnabled, std::memory_order_relaxed);
+    // A warning is not an API error, but does not prove the enable state changed.
+    if (providerResult == 0)
+    {
+        state.lastAcceptedEnabled.store(requestedEnabled, std::memory_order_relaxed);
+        state.activationKnown.store(true, std::memory_order_relaxed);
+    }
+}
+
+inline void RecordProviderVersion(std::uint16_t major, std::uint16_t minor, std::uint16_t patch, bool valid = true)
+{
+    auto& state = PresentDetail::State();
+    state.versionMajor.store(major, std::memory_order_relaxed);
+    state.versionMinor.store(minor, std::memory_order_relaxed);
+    state.versionPatch.store(patch, std::memory_order_relaxed);
+    state.versionKnown.store(valid, std::memory_order_relaxed);
+}
+
+inline void RecordHeapRequirements(std::uint64_t bufferBytes, std::uint64_t textureBytes, std::uint64_t constantBytes)
+{
+    auto& state = PresentDetail::State();
+    state.requiredBufferBytes.store(bufferBytes, std::memory_order_relaxed);
+    state.requiredTextureBytes.store(textureBytes, std::memory_order_relaxed);
+    state.requiredConstantBytes.store(constantBytes, std::memory_order_relaxed);
+    state.heapRequirementsKnown.store(true, std::memory_order_relaxed);
+}
+
+inline void RecordInterpolationCapacity(std::uint32_t maximum, std::int32_t configured, bool explicitValue)
+{
+    auto& state = PresentDetail::State();
+    state.maxInitializedInterpolations.store(maximum, std::memory_order_relaxed);
+    state.configuredInterpolations.store(configured, std::memory_order_relaxed);
+    state.configuredExplicit.store(explicitValue, std::memory_order_relaxed);
+}
+
+inline void RecordInterpolationActive(std::uint32_t acceptedInterpolatedFrames)
+{
+    auto& state = PresentDetail::State();
+    state.activeInterpolations.store(acceptedInterpolatedFrames, std::memory_order_relaxed);
+    state.interpolationKnown.store(true, std::memory_order_relaxed);
+}
+
+inline PresentSnapshot ReadPresentSnapshot()
+{
+    auto& state = PresentDetail::State();
+    PresentSnapshot result;
+#define XEFG_PRESENT_LOAD(field) result.field = state.field.load(std::memory_order_relaxed)
+    XEFG_PRESENT_LOAD(calls); XEFG_PRESENT_LOAD(testCalls); XEFG_PRESENT_LOAD(nativeFailures);
+    XEFG_PRESENT_LOAD(nativeNonzeroSuccess); XEFG_PRESENT_LOAD(apiUnavailable);
+    XEFG_PRESENT_LOAD(querySuccess); XEFG_PRESENT_LOAD(queryWarnings); XEFG_PRESENT_LOAD(queryErrors);
+    XEFG_PRESENT_LOAD(ambiguous); XEFG_PRESENT_LOAD(validSamples); XEFG_PRESENT_LOAD(enabledSamples);
+    XEFG_PRESENT_LOAD(disabledSamples); XEFG_PRESENT_LOAD(frameSuccess); XEFG_PRESENT_LOAD(frameWarnings);
+    XEFG_PRESENT_LOAD(frameErrors); XEFG_PRESENT_LOAD(queuedFrames); XEFG_PRESENT_LOAD(lastNative);
+    XEFG_PRESENT_LOAD(lastQuery); XEFG_PRESENT_LOAD(lastFrameResult); XEFG_PRESENT_LOAD(lastNonzeroQuery);
+    XEFG_PRESENT_LOAD(lastNonzeroFrameResult); XEFG_PRESENT_LOAD(lastQueuedFrames); XEFG_PRESENT_LOAD(lastEnabled);
+    XEFG_PRESENT_LOAD(tagWarnings); XEFG_PRESENT_LOAD(lastTagResult); XEFG_PRESENT_LOAD(lastNonzeroTagResult);
+    XEFG_PRESENT_LOAD(enableRequests); XEFG_PRESENT_LOAD(disableRequests); XEFG_PRESENT_LOAD(activationWarnings);
+    XEFG_PRESENT_LOAD(activationErrors); XEFG_PRESENT_LOAD(lastActivationResult);
+    XEFG_PRESENT_LOAD(lastActivationReason); XEFG_PRESENT_LOAD(activationKnown);
+    XEFG_PRESENT_LOAD(lastRequestedEnabled); XEFG_PRESENT_LOAD(lastAcceptedEnabled);
+    XEFG_PRESENT_LOAD(versionKnown); XEFG_PRESENT_LOAD(versionMajor); XEFG_PRESENT_LOAD(versionMinor);
+    XEFG_PRESENT_LOAD(versionPatch); XEFG_PRESENT_LOAD(heapRequirementsKnown);
+    XEFG_PRESENT_LOAD(requiredBufferBytes); XEFG_PRESENT_LOAD(requiredTextureBytes); XEFG_PRESENT_LOAD(requiredConstantBytes);
+    XEFG_PRESENT_LOAD(interpolationKnown); XEFG_PRESENT_LOAD(configuredExplicit);
+    XEFG_PRESENT_LOAD(maxInitializedInterpolations); XEFG_PRESENT_LOAD(configuredInterpolations); XEFG_PRESENT_LOAD(activeInterpolations);
+#undef XEFG_PRESENT_LOAD
+    for (unsigned i = 0; i < result.queuedHistogram.size(); ++i)
+        result.queuedHistogram[i] = state.queuedHistogram[i].load(std::memory_order_relaxed);
+    for (unsigned i = 0; i < result.inputAccepted.size(); ++i)
+    {
+        result.inputAccepted[i] = state.inputAccepted[i].load(std::memory_order_relaxed);
+        result.inputRejected[i] = state.inputRejected[i].load(std::memory_order_relaxed);
+        result.tagsAccepted[i] = state.tagsAccepted[i].load(std::memory_order_relaxed);
+        result.tagsRejected[i] = state.tagsRejected[i].load(std::memory_order_relaxed);
+    }
+    for (unsigned i = 0; i < result.inputReasons.size(); ++i)
+        result.inputReasons[i] = state.inputReasons[i].load(std::memory_order_relaxed);
+    for (unsigned i = 0; i < result.activationReasons.size(); ++i)
+        result.activationReasons[i] = state.activationReasons[i].load(std::memory_order_relaxed);
+    return result;
+}
+} // namespace XeFGDiagnostics
diff --git a/OptiScaler/misc/XeFGProgressDiagnostics.h b/OptiScaler/misc/XeFGProgressDiagnostics.h
new file mode 100644
index 00000000..39b40c80
--- /dev/null
+++ b/OptiScaler/misc/XeFGProgressDiagnostics.h
@@ -0,0 +1,83 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+// Sparse observations of queues already held for XeFG lifetime tracking.
+// These markers never authorize cleanup, infer residency, or prove global GPU
+// idle. Signal-to-observed-completion includes polling/CPU scheduling latency.
+namespace XeFGProgress
+{
+inline constexpr unsigned MaxQueues = 8;
+inline constexpr uint64_t IntervalMs = 1000;
+struct QueueSnapshot
+{
+    bool tracked = false, fenceReady = false, stopped = false;
+    uint64_t queueId = 0;
+    uint32_t queueType = UINT32_MAX;
+    uint64_t signalCount = 0, completionCount = 0;
+    uint64_t lastSignalTickMs = 0, lastCompletionObservedTickMs = 0, lastPollTickMs = 0;
+    uint64_t pendingSinceMs = 0, lastSubmissionTickMs = 0;
+    uint64_t coalesced = 0, createFailures = 0, signalFailures = 0, deviceRemoved = 0;
+    uint64_t completionObservationMaxMs = 0;
+    int32_t lastError = 0;
+};
+struct Snapshot
+{
+    bool valid = false, queueTrackingComplete = false;
+    uint64_t contextId = 0, sampledAtMs = 0, trackedQueues = 0, skippedBusy = 0;
+    std::array<QueueSnapshot, MaxQueues> queues {};
+};
+namespace Detail
+{
+inline std::mutex snapshotMutex;
+inline Snapshot latest;
+inline std::atomic<uint64_t> nextQueueId { 0 };
+}
+inline uint64_t NextQueueId() { return Detail::nextQueueId.fetch_add(1, std::memory_order_relaxed) + 1; }
+inline void Publish(const Snapshot& snapshot)
+{
+    std::unique_lock lock(Detail::snapshotMutex, std::try_to_lock);
+    if (lock.owns_lock()) Detail::latest = snapshot;
+}
+inline Snapshot ReadSnapshot()
+{
+    std::unique_lock lock(Detail::snapshotMutex, std::try_to_lock);
+    return lock.owns_lock() ? Detail::latest : Snapshot {};
+}
+
+enum class DeactivateReason : unsigned
+{
+    External, ConfigurationDisabled, SettingsChanged, ProviderSettingsToggle,
+    HudlessChanged, AliasReset, FullShutdown, Count
+};
+inline constexpr unsigned ReasonCount = static_cast<unsigned>(DeactivateReason::Count);
+struct LifecycleSnapshot
+{
+    std::array<uint64_t, ReasonCount> attempted {}, accepted {}, nonzero {};
+};
+namespace Detail
+{
+inline std::array<std::atomic<uint64_t>, ReasonCount> attempted {}, accepted {}, nonzero {};
+}
+inline void RecordDeactivate(DeactivateReason reason, int32_t result)
+{
+    const auto index = static_cast<unsigned>(reason);
+    if (index >= ReasonCount) return;
+    Detail::attempted[index].fetch_add(1, std::memory_order_relaxed);
+    (result == 0 ? Detail::accepted[index] : Detail::nonzero[index]).fetch_add(1, std::memory_order_relaxed);
+}
+inline LifecycleSnapshot ReadLifecycleSnapshot()
+{
+    LifecycleSnapshot snapshot;
+    for (unsigned i = 0; i < ReasonCount; ++i)
+    {
+        snapshot.attempted[i] = Detail::attempted[i].load(std::memory_order_relaxed);
+        snapshot.accepted[i] = Detail::accepted[i].load(std::memory_order_relaxed);
+        snapshot.nonzero[i] = Detail::nonzero[i].load(std::memory_order_relaxed);
+    }
+    return snapshot;
+}
+}
diff --git a/OptiScaler/misc/XeFGResourceDiagnostics.h b/OptiScaler/misc/XeFGResourceDiagnostics.h
new file mode 100644
index 00000000..db2479ae
--- /dev/null
+++ b/OptiScaler/misc/XeFGResourceDiagnostics.h
@@ -0,0 +1,347 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <limits>
+
+// Observational accounting for XeFG_Dx12::_resourceCopy only. These are owned
+// references and D3D12 allocation-size estimates, NOT resident VRAM readings.
+// Game resources, shader-helper buffers and Intel's internal allocations are excluded.
+// No Windows, logger, graphics API, dynamic allocation, or synchronization waits.
+namespace XeFGDiagnostics
+{
+struct Snapshot
+{
+    std::uint64_t liveCopies = 0;
+    std::uint64_t peakCopies = 0;
+    std::uint64_t liveBytes = 0;
+    std::uint64_t peakBytes = 0;
+    std::uint64_t unknownSizeCopies = 0;
+    std::uint64_t allocations = 0;
+    std::uint64_t releases = 0;
+    std::uint64_t allocatedBytes = 0;
+    std::uint64_t releasedBytes = 0;
+    std::uint64_t allocationFailures = 0;
+    std::uint64_t aliasPreserved = 0;
+    std::uint64_t missingDepthOnly = 0;
+    std::uint64_t missingVelocityOnly = 0;
+    std::uint64_t missingBoth = 0;
+    std::uint64_t missingFrames = 0;
+    std::uint64_t missingBursts = 0;
+    std::uint64_t recoveredBursts = 0;
+    std::uint64_t currentMissingBurst = 0;
+    std::uint64_t peakMissingBurst = 0;
+    std::uint64_t accountingErrors = 0;
+};
+
+namespace Detail
+{
+inline void RaisePeak(std::atomic<std::uint64_t>& peak, std::uint64_t value)
+{
+    auto previous = peak.load(std::memory_order_relaxed);
+    while (previous < value &&
+           !peak.compare_exchange_weak(previous, value, std::memory_order_relaxed))
+    {
+    }
+}
+
+class Counters
+{
+  public:
+    void Allocate(std::uint64_t bytes, bool known)
+    {
+        const auto copies = _liveCopies.fetch_add(1, std::memory_order_relaxed) + 1;
+        RaisePeak(_peakCopies, copies);
+        _allocations.fetch_add(1, std::memory_order_relaxed);
+        if (known)
+        {
+            const auto total = _liveBytes.fetch_add(bytes, std::memory_order_relaxed) + bytes;
+            RaisePeak(_peakBytes, total);
+            _allocatedBytes.fetch_add(bytes, std::memory_order_relaxed);
+        }
+        else
+            _unknownSizeCopies.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    bool Release(std::uint64_t bytes, bool known)
+    {
+        // Defensive accounting guard only; it never changes a resource lifetime.
+        if (!Subtract(_liveCopies, 1))
+        {
+            _accountingErrors.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        }
+        _releases.fetch_add(1, std::memory_order_relaxed);
+        if (known)
+        {
+            if (Subtract(_liveBytes, bytes))
+                _releasedBytes.fetch_add(bytes, std::memory_order_relaxed);
+            else
+                _accountingErrors.fetch_add(1, std::memory_order_relaxed);
+        }
+        else if (!Subtract(_unknownSizeCopies, 1))
+            _accountingErrors.fetch_add(1, std::memory_order_relaxed);
+        return true;
+    }
+
+    void AllocationFailure() { _allocationFailures.fetch_add(1, std::memory_order_relaxed); }
+    void AliasPreserved() { _aliasPreserved.fetch_add(1, std::memory_order_relaxed); }
+    void AccountingError() { _accountingErrors.fetch_add(1, std::memory_order_relaxed); }
+
+    void Missing(bool depth, bool velocity)
+    {
+        _missingFrames.fetch_add(1, std::memory_order_relaxed);
+        if (depth && velocity)
+            _missingBoth.fetch_add(1, std::memory_order_relaxed);
+        else if (depth)
+            _missingDepthOnly.fetch_add(1, std::memory_order_relaxed);
+        else if (velocity)
+            _missingVelocityOnly.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    std::uint64_t ExtendBurst()
+    {
+        const auto count = _currentMissingBurst.fetch_add(1, std::memory_order_relaxed) + 1;
+        RaisePeak(_peakMissingBurst, count);
+        if (count == 1)
+            _missingBursts.fetch_add(1, std::memory_order_relaxed);
+        return count;
+    }
+
+    void RecordContextBurst(std::uint64_t count)
+    {
+        // Global longest burst is the longest single-context burst, not a mixture
+        // of unrelated contexts. The global currentMissingBurst stays zero.
+        RaisePeak(_peakMissingBurst, count);
+        if (count == 1)
+            _missingBursts.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    bool EndBurst()
+    {
+        if (_currentMissingBurst.exchange(0, std::memory_order_relaxed) == 0)
+            return false;
+        _recoveredBursts.fetch_add(1, std::memory_order_relaxed);
+        return true;
+    }
+
+    void RecordContextRecovery() { _recoveredBursts.fetch_add(1, std::memory_order_relaxed); }
+
+    Snapshot Read() const
+    {
+        // Individual atomic readings can straddle a concurrent allocation/release.
+        // No lock is held and no transactionally consistent snapshot is claimed.
+        Snapshot result;
+        result.liveCopies = _liveCopies.load(std::memory_order_relaxed);
+        result.peakCopies = _peakCopies.load(std::memory_order_relaxed);
+        result.liveBytes = _liveBytes.load(std::memory_order_relaxed);
+        result.peakBytes = _peakBytes.load(std::memory_order_relaxed);
+        result.unknownSizeCopies = _unknownSizeCopies.load(std::memory_order_relaxed);
+        result.allocations = _allocations.load(std::memory_order_relaxed);
+        result.releases = _releases.load(std::memory_order_relaxed);
+        result.allocatedBytes = _allocatedBytes.load(std::memory_order_relaxed);
+        result.releasedBytes = _releasedBytes.load(std::memory_order_relaxed);
+        result.allocationFailures = _allocationFailures.load(std::memory_order_relaxed);
+        result.aliasPreserved = _aliasPreserved.load(std::memory_order_relaxed);
+        result.missingDepthOnly = _missingDepthOnly.load(std::memory_order_relaxed);
+        result.missingVelocityOnly = _missingVelocityOnly.load(std::memory_order_relaxed);
+        result.missingBoth = _missingBoth.load(std::memory_order_relaxed);
+        result.missingFrames = _missingFrames.load(std::memory_order_relaxed);
+        result.missingBursts = _missingBursts.load(std::memory_order_relaxed);
+        result.recoveredBursts = _recoveredBursts.load(std::memory_order_relaxed);
+        result.currentMissingBurst = _currentMissingBurst.load(std::memory_order_relaxed);
+        result.peakMissingBurst = _peakMissingBurst.load(std::memory_order_relaxed);
+        result.accountingErrors = _accountingErrors.load(std::memory_order_relaxed);
+        return result;
+    }
+
+    // BeginContext is called only at a serialized provider-context lifecycle
+    // boundary. Retain live owned copies, which are not freed by a counter reset.
+    Snapshot ResetContext()
+    {
+        const auto start = Read();
+        _peakCopies.store(start.liveCopies, std::memory_order_relaxed);
+        _peakBytes.store(start.liveBytes, std::memory_order_relaxed);
+        _allocations.store(0, std::memory_order_relaxed);
+        _releases.store(0, std::memory_order_relaxed);
+        _allocatedBytes.store(0, std::memory_order_relaxed);
+        _releasedBytes.store(0, std::memory_order_relaxed);
+        _allocationFailures.store(0, std::memory_order_relaxed);
+        _aliasPreserved.store(0, std::memory_order_relaxed);
+        _missingDepthOnly.store(0, std::memory_order_relaxed);
+        _missingVelocityOnly.store(0, std::memory_order_relaxed);
+        _missingBoth.store(0, std::memory_order_relaxed);
+        _missingFrames.store(0, std::memory_order_relaxed);
+        _missingBursts.store(0, std::memory_order_relaxed);
+        _recoveredBursts.store(0, std::memory_order_relaxed);
+        _currentMissingBurst.store(0, std::memory_order_relaxed);
+        _peakMissingBurst.store(0, std::memory_order_relaxed);
+        _accountingErrors.store(0, std::memory_order_relaxed);
+        return start;
+    }
+
+  private:
+    static bool Subtract(std::atomic<std::uint64_t>& counter, std::uint64_t amount)
+    {
+        auto previous = counter.load(std::memory_order_relaxed);
+        while (previous >= amount)
+            if (counter.compare_exchange_weak(previous, previous - amount, std::memory_order_relaxed))
+                return true;
+        return false;
+    }
+
+    std::atomic<std::uint64_t> _liveCopies { 0 }, _peakCopies { 0 }, _liveBytes { 0 }, _peakBytes { 0 };
+    std::atomic<std::uint64_t> _unknownSizeCopies { 0 }, _allocations { 0 }, _releases { 0 };
+    std::atomic<std::uint64_t> _allocatedBytes { 0 }, _releasedBytes { 0 }, _allocationFailures { 0 };
+    std::atomic<std::uint64_t> _aliasPreserved { 0 }, _missingDepthOnly { 0 }, _missingVelocityOnly { 0 };
+    std::atomic<std::uint64_t> _missingBoth { 0 }, _missingFrames { 0 }, _missingBursts { 0 };
+    std::atomic<std::uint64_t> _recoveredBursts { 0 }, _currentMissingBurst { 0 }, _peakMissingBurst { 0 };
+    std::atomic<std::uint64_t> _accountingErrors { 0 };
+};
+
+inline Counters& GlobalCounters()
+{
+    static Counters counters;
+    return counters;
+}
+
+inline std::uint64_t NextContextId()
+{
+    static std::atomic<std::uint64_t> generation { 0 };
+    return generation.fetch_add(1, std::memory_order_relaxed) + 1;
+}
+
+inline bool TakeGlobalLogEntry()
+{
+    static std::atomic<unsigned> entries { 0 };
+    auto previous = entries.load(std::memory_order_relaxed);
+    while (previous < 1024)
+        if (entries.compare_exchange_weak(previous, previous + 1, std::memory_order_relaxed))
+            return true;
+    return false;
+}
+} // namespace Detail
+
+inline Snapshot GlobalSnapshot() { return Detail::GlobalCounters().Read(); }
+
+// Pure clock-driven gate: first report, then at most once per five seconds for
+// a new burst/recovery/failure, otherwise once per 30 seconds. No per-frame log.
+class ReportGate
+{
+  public:
+    bool Take(std::uint64_t nowMs, bool changed)
+    {
+        constexpr auto unset = (std::numeric_limits<std::uint64_t>::max)();
+        auto previous = _lastMs.load(std::memory_order_relaxed);
+        if (previous != unset &&
+            (nowMs < previous || nowMs - previous < (changed ? 5000ULL : 30000ULL)))
+            return false;
+        return _lastMs.compare_exchange_strong(previous, nowMs, std::memory_order_relaxed);
+    }
+
+  private:
+    std::atomic<std::uint64_t> _lastMs { (std::numeric_limits<std::uint64_t>::max)() };
+};
+
+struct Report
+{
+    std::uint64_t contextId = 0;
+    std::uint64_t startLiveCopies = 0;
+    std::uint64_t startLiveBytes = 0;
+    std::uint64_t startUnknownSizeCopies = 0;
+    Snapshot counters;
+};
+
+class Context
+{
+  public:
+    void BeginContext()
+    {
+        const auto start = _counters.ResetContext();
+        _startLiveCopies.store(start.liveCopies, std::memory_order_relaxed);
+        _startLiveBytes.store(start.liveBytes, std::memory_order_relaxed);
+        _startUnknownSizeCopies.store(start.unknownSizeCopies, std::memory_order_relaxed);
+        _contextId.store(Detail::NextContextId(), std::memory_order_relaxed);
+        _revision.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    void OnAllocate(std::uint64_t allocationEstimateBytes, bool sizeKnown = true)
+    {
+        _counters.Allocate(allocationEstimateBytes, sizeKnown);
+        Detail::GlobalCounters().Allocate(allocationEstimateBytes, sizeKnown);
+    }
+
+    void OnRelease(std::uint64_t allocationEstimateBytes, bool sizeKnown = true)
+    {
+        if (_counters.Release(allocationEstimateBytes, sizeKnown))
+            Detail::GlobalCounters().Release(allocationEstimateBytes, sizeKnown);
+        else
+            Detail::GlobalCounters().AccountingError();
+    }
+
+    void OnAllocationFailure()
+    {
+        _counters.AllocationFailure();
+        Detail::GlobalCounters().AllocationFailure();
+        _revision.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    void OnAliasPreserved()
+    {
+        _counters.AliasPreserved();
+        Detail::GlobalCounters().AliasPreserved();
+    }
+
+    void OnMissingInputs(bool depthMissing, bool velocityMissing)
+    {
+        if (!depthMissing && !velocityMissing)
+            return;
+        _counters.Missing(depthMissing, velocityMissing);
+        Detail::GlobalCounters().Missing(depthMissing, velocityMissing);
+        const auto count = _counters.ExtendBurst();
+        Detail::GlobalCounters().RecordContextBurst(count);
+        if (count == 1)
+            _revision.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    void OnInputsReady()
+    {
+        if (_counters.EndBurst())
+        {
+            Detail::GlobalCounters().RecordContextRecovery();
+            _revision.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+
+    Report Read() const
+    {
+        Report report;
+        report.contextId = _contextId.load(std::memory_order_relaxed);
+        report.startLiveCopies = _startLiveCopies.load(std::memory_order_relaxed);
+        report.startLiveBytes = _startLiveBytes.load(std::memory_order_relaxed);
+        report.startUnknownSizeCopies = _startUnknownSizeCopies.load(std::memory_order_relaxed);
+        report.counters = _counters.Read();
+        return report;
+    }
+
+    bool TryReport(std::uint64_t nowMs, Report& report)
+    {
+        const auto revision = _revision.load(std::memory_order_relaxed);
+        const bool changed = revision != _reportedRevision.load(std::memory_order_relaxed);
+        if (!_gate.Take(nowMs, changed) || !Detail::TakeGlobalLogEntry())
+            return false;
+        _reportedRevision.store(revision, std::memory_order_relaxed);
+        report = Read();
+        return true;
+    }
+
+    // Deliberately no destructor decrement: destroying an owner is not evidence
+    // that an undrained or deliberately retained GPU allocation was released.
+
+  private:
+    Detail::Counters _counters;
+    ReportGate _gate;
+    std::atomic<std::uint64_t> _contextId { 0 }, _startLiveCopies { 0 }, _startLiveBytes { 0 };
+    std::atomic<std::uint64_t> _startUnknownSizeCopies { 0 }, _revision { 0 }, _reportedRevision { 0 };
+};
+} // namespace XeFGDiagnostics
diff --git a/OptiScaler/misc/XeFGWorkDiagnostics.h b/OptiScaler/misc/XeFGWorkDiagnostics.h
new file mode 100644
index 00000000..8df886a7
--- /dev/null
+++ b/OptiScaler/misc/XeFGWorkDiagnostics.h
@@ -0,0 +1,295 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+// Observation only. No resource lifetime decisions, age-based expiry, waits,
+// dynamic containers, or logger dependencies. All ages use WorkNowMs().
+namespace XeFGDiagnostics
+{
+inline std::uint64_t WorkNowMs()
+{
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+enum class LifetimeObserver : unsigned
+{
+    CommandSubmission = 1u,
+    CommandReset = 2u,
+    CommandRelease = 4u
+};
+
+struct ObserverSnapshot
+{
+    // Cumulative observations in this process, not proof that every native
+    // implementation currently has coverage. Readiness remains the hook owner's
+    // decision. A Release callback counts entry, not final destruction.
+    unsigned attemptedMask = 0;
+    unsigned installedMask = 0;
+    unsigned failedMask = 0;
+    unsigned observedMask = 0;
+    std::array<std::uint64_t, 3> callbacks {};
+};
+
+namespace WorkDetail
+{
+struct ObserverCounters
+{
+    std::atomic<unsigned> attempted { 0 }, installed { 0 }, failed { 0 }, observed { 0 };
+    std::array<std::atomic<std::uint64_t>, 3> callbacks {};
+};
+
+inline ObserverCounters& Observers()
+{
+    static ObserverCounters counters;
+    return counters;
+}
+
+inline unsigned ObserverIndex(LifetimeObserver observer)
+{
+    switch (observer)
+    {
+    case LifetimeObserver::CommandSubmission: return 0;
+    case LifetimeObserver::CommandReset: return 1;
+    case LifetimeObserver::CommandRelease: return 2;
+    default: return 3;
+    }
+}
+} // namespace WorkDetail
+
+inline void RecordObserverInstallation(LifetimeObserver observer, bool success)
+{
+    if (WorkDetail::ObserverIndex(observer) >= 3)
+        return;
+    const auto bit = static_cast<unsigned>(observer);
+    auto& counters = WorkDetail::Observers();
+    counters.attempted.fetch_or(bit, std::memory_order_relaxed);
+    (success ? counters.installed : counters.failed).fetch_or(bit, std::memory_order_relaxed);
+}
+
+inline void RecordObserverCallback(LifetimeObserver observer)
+{
+    const auto index = WorkDetail::ObserverIndex(observer);
+    if (index >= 3)
+        return;
+    auto& counters = WorkDetail::Observers();
+    counters.observed.fetch_or(static_cast<unsigned>(observer), std::memory_order_relaxed);
+    counters.callbacks[index].fetch_add(1, std::memory_order_relaxed);
+}
+
+inline ObserverSnapshot ReadObserverSnapshot()
+{
+    auto& counters = WorkDetail::Observers();
+    ObserverSnapshot snapshot;
+    snapshot.attemptedMask = counters.attempted.load(std::memory_order_relaxed);
+    snapshot.installedMask = counters.installed.load(std::memory_order_relaxed);
+    snapshot.failedMask = counters.failed.load(std::memory_order_relaxed);
+    snapshot.observedMask = counters.observed.load(std::memory_order_relaxed);
+    for (unsigned i = 0; i < snapshot.callbacks.size(); ++i)
+        snapshot.callbacks[i] = counters.callbacks[i].load(std::memory_order_relaxed);
+    return snapshot;
+}
+
+enum class CleanupReason : unsigned char
+{
+    None,
+    CpuBusy,
+    ObserverUnavailable,
+    PendingUnsubmitted,
+    GpuIncomplete,
+    ProviderDisableFailed
+};
+
+enum class CleanupState : unsigned char
+{
+    Running,
+    Attempting,
+    Deferred,
+    Recovered
+};
+
+inline const char* CleanupReasonName(CleanupReason reason)
+{
+    switch (reason)
+    {
+    case CleanupReason::None: return "none";
+    case CleanupReason::CpuBusy: return "cpu_busy";
+    case CleanupReason::ObserverUnavailable: return "observer_unavailable";
+    case CleanupReason::PendingUnsubmitted: return "pending_unsubmitted";
+    case CleanupReason::GpuIncomplete: return "gpu_incomplete";
+    case CleanupReason::ProviderDisableFailed: return "provider_disable_failed";
+    default: return "unknown";
+    }
+}
+
+inline const char* CleanupStateName(CleanupState state)
+{
+    switch (state)
+    {
+    case CleanupState::Running: return "running";
+    case CleanupState::Attempting: return "attempting";
+    case CleanupState::Deferred: return "deferred";
+    case CleanupState::Recovered: return "recovered";
+    default: return "unknown";
+    }
+}
+
+struct PendingSnapshot
+{
+    std::uint64_t current = 0;
+    std::uint64_t peak = 0;
+    std::uint64_t registered = 0;
+    std::uint64_t submitted = 0;
+    std::uint64_t resetDiscarded = 0;
+    std::uint64_t destroyed = 0;
+    // 0 means unknown. This must describe an actual observed pending record,
+    // not the age of a nonempty registry containing continually changing work.
+    std::uint64_t oldestObservedTickMs = 0;
+};
+
+struct WorkSnapshot
+{
+    std::uint64_t contextId = 0;
+    std::uint64_t publishedTickMs = 0;
+    PendingSnapshot pending;
+    std::uint64_t cleanupAttempts = 0;
+    std::uint64_t cleanupDeferred = 0;
+    std::uint64_t cleanupCompleted = 0;
+    std::uint64_t cleanupRecovered = 0;
+    CleanupState state = CleanupState::Running;
+    CleanupReason reason = CleanupReason::None;
+};
+
+namespace WorkDetail
+{
+struct LatestWork
+{
+    std::atomic_flag guard = ATOMIC_FLAG_INIT;
+    WorkSnapshot snapshot;
+    bool hasData = false;
+};
+
+inline LatestWork& Latest()
+{
+    static LatestWork latest;
+    return latest;
+}
+
+inline void PublishLatest(const WorkSnapshot& snapshot)
+{
+    auto& latest = Latest();
+    // Best-effort diagnostic publication: contention never waits on rendering.
+    if (latest.guard.test_and_set(std::memory_order_acquire))
+        return;
+    latest.snapshot = snapshot;
+    latest.hasData = true;
+    latest.guard.clear(std::memory_order_release);
+}
+} // namespace WorkDetail
+
+inline bool TryReadLatestWorkSnapshot(WorkSnapshot& snapshot)
+{
+    auto& latest = WorkDetail::Latest();
+    if (latest.guard.test_and_set(std::memory_order_acquire))
+        return false;
+    const bool valid = latest.hasData;
+    if (valid)
+        snapshot = latest.snapshot;
+    latest.guard.clear(std::memory_order_release);
+    return valid;
+}
+
+class WorkDiagnostics
+{
+  public:
+    // Lifecycle boundary, serialized by the owner. Pending values are published
+    // by the authoritative registry; starting a context does not free/reset it.
+    void BeginContext(std::uint64_t contextId)
+    {
+        _contextId.store(contextId, std::memory_order_relaxed);
+        _attempts.store(0, std::memory_order_relaxed);
+        _deferred.store(0, std::memory_order_relaxed);
+        _completed.store(0, std::memory_order_relaxed);
+        _recovered.store(0, std::memory_order_relaxed);
+        _needsRecovery.store(false, std::memory_order_relaxed);
+        _state.store(CleanupState::Running, std::memory_order_relaxed);
+        _reason.store(CleanupReason::None, std::memory_order_relaxed);
+        Publish();
+    }
+
+    void PublishPendingSnapshot(const PendingSnapshot& pending)
+    {
+        _pendingCurrent.store(pending.current, std::memory_order_relaxed);
+        _pendingPeak.store(pending.peak, std::memory_order_relaxed);
+        _registered.store(pending.registered, std::memory_order_relaxed);
+        _submitted.store(pending.submitted, std::memory_order_relaxed);
+        _resetDiscarded.store(pending.resetDiscarded, std::memory_order_relaxed);
+        _destroyed.store(pending.destroyed, std::memory_order_relaxed);
+        _oldestTick.store(pending.oldestObservedTickMs, std::memory_order_relaxed);
+        Publish();
+    }
+
+    void OnCleanupAttempt()
+    {
+        _attempts.fetch_add(1, std::memory_order_relaxed);
+        _state.store(CleanupState::Attempting, std::memory_order_relaxed);
+        _reason.store(CleanupReason::None, std::memory_order_relaxed);
+        Publish();
+    }
+
+    void OnCleanupDeferred(CleanupReason reason)
+    {
+        _deferred.fetch_add(1, std::memory_order_relaxed);
+        _needsRecovery.store(true, std::memory_order_relaxed);
+        _reason.store(reason, std::memory_order_relaxed);
+        _state.store(CleanupState::Deferred, std::memory_order_relaxed);
+        Publish();
+    }
+
+    void OnCleanupRecovered()
+    {
+        _completed.fetch_add(1, std::memory_order_relaxed);
+        if (_needsRecovery.exchange(false, std::memory_order_relaxed))
+            _recovered.fetch_add(1, std::memory_order_relaxed);
+        _reason.store(CleanupReason::None, std::memory_order_relaxed);
+        _state.store(CleanupState::Recovered, std::memory_order_relaxed);
+        Publish();
+    }
+
+    WorkSnapshot Read() const
+    {
+        // Approximate concurrent observation, not a transaction with the registry.
+        WorkSnapshot snapshot;
+        snapshot.contextId = _contextId.load(std::memory_order_relaxed);
+        snapshot.publishedTickMs = WorkNowMs();
+        snapshot.pending.current = _pendingCurrent.load(std::memory_order_relaxed);
+        snapshot.pending.peak = _pendingPeak.load(std::memory_order_relaxed);
+        snapshot.pending.registered = _registered.load(std::memory_order_relaxed);
+        snapshot.pending.submitted = _submitted.load(std::memory_order_relaxed);
+        snapshot.pending.resetDiscarded = _resetDiscarded.load(std::memory_order_relaxed);
+        snapshot.pending.destroyed = _destroyed.load(std::memory_order_relaxed);
+        snapshot.pending.oldestObservedTickMs = _oldestTick.load(std::memory_order_relaxed);
+        snapshot.cleanupAttempts = _attempts.load(std::memory_order_relaxed);
+        snapshot.cleanupDeferred = _deferred.load(std::memory_order_relaxed);
+        snapshot.cleanupCompleted = _completed.load(std::memory_order_relaxed);
+        snapshot.cleanupRecovered = _recovered.load(std::memory_order_relaxed);
+        snapshot.state = _state.load(std::memory_order_relaxed);
+        snapshot.reason = _reason.load(std::memory_order_relaxed);
+        return snapshot;
+    }
+
+  private:
+    void Publish() { WorkDetail::PublishLatest(Read()); }
+
+    std::atomic<std::uint64_t> _contextId { 0 };
+    std::atomic<std::uint64_t> _pendingCurrent { 0 }, _pendingPeak { 0 }, _registered { 0 }, _submitted { 0 };
+    std::atomic<std::uint64_t> _resetDiscarded { 0 }, _destroyed { 0 }, _oldestTick { 0 };
+    std::atomic<std::uint64_t> _attempts { 0 }, _deferred { 0 }, _completed { 0 }, _recovered { 0 };
+    std::atomic<bool> _needsRecovery { false };
+    std::atomic<CleanupState> _state { CleanupState::Running };
+    std::atomic<CleanupReason> _reason { CleanupReason::None };
+};
+} // namespace XeFGDiagnostics
