+    // Recoverable lifecycle changes must never stall a render callback. Failure
+    // leaves admission unchanged so existing and new work can continue normally.
+    bool TryCloseWhenIdle()
+    {
+        std::lock_guard lock(_mutex);
+        if (_active != 0)
+            return false;
+        _closed = true;
+        return true;
+    }
+
+    // For object destruction only: the owner must not destroy this gate while a
+    // CPU caller still holds a Scope. Never call while holding the loader lock.
+    void CloseAndWait()
+    {
+        std::unique_lock lock(_mutex);
+        _closed = true;
+        _idle.wait(lock, [this] { return _active == 0; });
+    }
+
+    bool Open()
+    {
+        std::lock_guard lock(_mutex);
+        if (_active != 0)
+            return false;
+        _closed = false;
+        return true;
+    }
+
+    bool IsClosed()
+    {
+        std::lock_guard lock(_mutex);
+        return _closed;
+    }
+};
