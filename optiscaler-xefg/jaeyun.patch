+        NoteRecoveryFault(frame, "trial_deactivated", 0);
+        return false;
+    }
+    const auto ticket = _recovery.BeginTrial(frame, now);
+    if (ticket != 0)
+    {
+        const auto result = XeFGProxy::SetEnabled()(_swapChainContext, true);
+        XeFGDiagnostics::RecordActivation(true, static_cast<int32_t>(result),
+                                           XeFGDiagnostics::ActivationReason::RecoveryEnable);
+        const bool success = result == XEFG_SWAPCHAIN_RESULT_SUCCESS;
+        const bool terminal = IsTerminalXeFGResult(static_cast<int32_t>(result));
+        _recovery.Enabled(ticket, success, now, terminal);
+        if (terminal)
+            LOG_WARN("XeFG recovery stopped: stage=enable result={} needs_new_context=true", static_cast<int32_t>(result));
+        if (success)
+        {
+            _isActive = true;
+            _waitingNewFrameData = false;
+            _lastDispatchedFrame = 0;
