+using Committed3Fn = rewrite_signature<decltype(&ID3D12Device10::CreateCommittedResource3)>::type;
+using Heap0Fn = rewrite_signature<decltype(&ID3D12Device::CreateHeap)>::type;
+using Heap1Fn = rewrite_signature<decltype(&ID3D12Device4::CreateHeap1)>::type;
+inline Committed1Fn committed1 = nullptr;
+inline Committed2Fn committed2 = nullptr;
+inline Committed3Fn committed3 = nullptr;
+inline Heap0Fn heap0 = nullptr;
+inline Heap1Fn heap1 = nullptr;
+inline bool baseCommittedHooked = false;
+inline std::mutex installationMutex;
+inline unsigned installationAttempts = 0;
+inline bool installed = false;
+inline uint32_t currentApiMask = 0;
+inline thread_local unsigned creationDepth = 0;
+struct CreationScope
+{
+    bool outermost;
+    CreationScope() : outermost(creationDepth++ == 0) {}
+    ~CreationScope() { --creationDepth; }
+};
+
+inline MemoryClass ClassifyMemory(const D3D12_HEAP_PROPERTIES& properties)
+{
+    if (properties.Type == D3D12_HEAP_TYPE_DEFAULT)
+        return MemoryClass::Default;
+    if (properties.Type == D3D12_HEAP_TYPE_UPLOAD || properties.Type == D3D12_HEAP_TYPE_READBACK)
+        return MemoryClass::CpuVisible;
+    return MemoryClass::Unclassified;
+}
+inline Caller ClassifyCaller(void* address, AllocationMetadata* metadata = nullptr)
+{
+    const auto module = Util::GetCallerModule(address);
+    if (metadata != nullptr)
+    {
+        metadata->moduleBase = reinterpret_cast<uintptr_t>(module);
+        const auto addressValue = reinterpret_cast<uintptr_t>(address);
+        metadata->callerRva = module != nullptr && addressValue >= metadata->moduleBase ?
+                              addressValue - metadata->moduleBase : 0;
+    }
+    if (module == nullptr) return Caller::Unknown;
+    if (module == XeFGProxy::Module()) return Caller::XeFG;
+    if (module == XeSSProxy::Module()) return Caller::XeSS;
+    if (module == FfxApiProxy::Dx12Module() || module == FfxApiProxy::Dx12Module_SR() ||
+        module == FfxApiProxy::Dx12Module_FG() || module == FfxApiProxy::Dx12Module_Denoiser() ||
+        module == FfxApiProxy::Dx12Module_Radiance()) return Caller::FFX;
+    if (module == StreamlineProxy::Module()) return Caller::Streamline;
+    // The executable and this DLL remain loaded for this diagnostic's lifetime.
+    // Cache only those identities; arbitrary caller modules are still resolved.
+    static const auto gameModule = GetModuleHandleW(nullptr);
+    static const auto ownModule = Util::GetCallerModule(reinterpret_cast<void*>(&ClassifyCaller));
+    if (module == gameModule) return Caller::Game;
+    if (module == ownModule) return Caller::OptiScaler;
+    return Caller::Other;
+}
+
+inline void OnDestroyed(void* opaqueToken)
+{
+    SampledDiagnosticTimer timer(TimingStage::Destruction);
+    // The context is an opaque 64-bit token on this project's x64 target, never
+    // a resource pointer. Generation matching makes duplicate/stale calls inert.
+    auto ledger = Instance();
+    if (ledger != nullptr)
+        ledger->Retire(static_cast<uint64_t>(reinterpret_cast<uintptr_t>(opaqueToken)));
+}
+inline bool PinCallbackModule()
+{
+    static const bool pinned = []()
+    {
+        HMODULE module = nullptr;
+        return GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                                  reinterpret_cast<LPCWSTR>(&OnDestroyed), &module) != FALSE;
+    }();
+    return pinned;
+}
+inline void ObserveObject(void* returnedInterface, uint64_t bytes, Kind kind, MemoryClass memory, void* caller,
+                          AllocationMetadata metadata = AllocationMetadata())
+{
+    if (!ObservationEnabled()) return;
+    if (bytes == 0 || bytes == UINT64_MAX)
+    {
+        RecordSkip(Skip::SizeUnknown);
+        return;
+    }
+    if (bytes < MinimumTrackedBytes)
+    {
+        RecordSkip(Skip::Small);
+        return;
+    }
+    ID3DDestructionNotifier* notifier = nullptr;
+    auto object = reinterpret_cast<IUnknown*>(returnedInterface);
+    if (object == nullptr || FAILED(object->QueryInterface(IID_PPV_ARGS(&notifier))) || notifier == nullptr)
+    {
+        RecordSkip(Skip::NotifierUnsupported);
+        return;
+    }
+    // Only this DLL is pinned, never a GPU object. The QI reference below is
+    // returned on every path; no object reference is retained in the ledger.
+    if (!PinCallbackModule())
+    {
+        RecordSkip(Skip::PinFailed);
+        notifier->Release();
+        return;
+    }
+    auto ledger = Instance();
+    if (ledger == nullptr)
+    {
+        RecordSkip(Skip::CounterUnavailable);
+        notifier->Release();
+        return;
+    }
+    metadata.createdMs = MonotonicMilliseconds();
+    const auto category = ClassifyCaller(caller, &metadata);
+    const auto token = ledger->Track(category, kind, memory, bytes, metadata);
+    if (token != 0)
+    {
+        UINT callbackId = 0;
+        const auto result = notifier->RegisterDestructionCallback(
+            OnDestroyed, reinterpret_cast<void*>(static_cast<uintptr_t>(token)), &callbackId);
+        if (FAILED(result))
+        {
+            ledger->Cancel(token);
+            RecordSkip(Skip::RegistrationFailed);
+        }
+    }
+    notifier->Release();
+}
+inline bool IsCreated(HRESULT result, void** output)
+{
+    if (FAILED(result))
+    {
+        RecordSkip(Skip::AllocationFailed);
+        return false;
+    }
+    // S_FALSE capability probes and failed/null outputs do not allocate.
+    return result == S_OK && output != nullptr && *output != nullptr;
+}
+inline void CopyHeapProperties(AllocationMetadata& metadata, const D3D12_HEAP_PROPERTIES& properties,
+                               uint32_t flags, bool flagsKnown)
+{
+    metadata.heapType = static_cast<uint32_t>(properties.Type);
+    metadata.cpuPageProperty = static_cast<uint32_t>(properties.CPUPageProperty);
+    metadata.memoryPoolPreference = static_cast<uint32_t>(properties.MemoryPoolPreference);
+    metadata.creationNodeMask = properties.CreationNodeMask;
+    metadata.visibleNodeMask = properties.VisibleNodeMask;
+    metadata.heapFlags = flags;
+    metadata.heapFlagsKnown = flagsKnown;
+}
+template<class Description>
+inline AllocationMetadata CopyResourceMetadata(const Description& description,
+                                               const D3D12_HEAP_PROPERTIES& properties,
+                                               uint32_t heapFlags, bool heapFlagsKnown)
+{
+    AllocationMetadata metadata;
+    metadata.descriptorKnown = true;
+    metadata.dimension = static_cast<uint32_t>(description.Dimension);
+    metadata.alignment = description.Alignment;
+    metadata.width = description.Width;
+    metadata.height = description.Height;
+    metadata.depthOrArray = description.DepthOrArraySize;
+    metadata.mipLevels = description.MipLevels;
+    metadata.format = static_cast<uint32_t>(description.Format);
+    metadata.sampleCount = description.SampleDesc.Count;
+    metadata.sampleQuality = description.SampleDesc.Quality;
+    metadata.layout = static_cast<uint32_t>(description.Layout);
+    metadata.resourceFlags = static_cast<uint32_t>(description.Flags);
+    CopyHeapProperties(metadata, properties, heapFlags, heapFlagsKnown);
+    return metadata;
+}
+inline void ObserveCommitted0(HRESULT result, ID3D12Device* device, const D3D12_HEAP_PROPERTIES* properties,
+                              const D3D12_RESOURCE_DESC* description, void** output, void* caller,
+                              uint32_t heapFlags = 0, bool heapFlagsKnown = false)
+{
+    if (!ObservationEnabled()) return;
+    SampledDiagnosticTimer timer(TimingStage::Observation);
+    if (!IsCreated(result, output)) return;
+    if (properties == nullptr || description == nullptr)
+    {
+        RecordSkip(Skip::SizeUnknown);
+        return;
+    }
+    if (description->Dimension == D3D12_RESOURCE_DIMENSION_BUFFER && description->Width < MinimumTrackedBytes)
+    {
+        // Threshold is deliberately defined by logical buffer width here. This
+        // avoids allocation-info queries even if driver heap alignment is larger.
+        RecordSkip(Skip::Small);
+        return;
+    }
+    // A normal C++ virtual call preserves the SDK's struct-return ABI. Texture
+    // sizes are never guessed from formats: alignment/compression may differ.
+    const auto info = device->GetResourceAllocationInfo(0, 1, description);
+    ObserveObject(*output, info.SizeInBytes, Kind::Committed, ClassifyMemory(*properties), caller,
+                  CopyResourceMetadata(*description, *properties, heapFlags, heapFlagsKnown));
+}
+inline void ObserveCommitted2(HRESULT result, ID3D12Device8* device, const D3D12_HEAP_PROPERTIES* properties,
+                              const D3D12_RESOURCE_DESC1* description, void** output, void* caller,
+                              uint32_t heapFlags = 0, bool heapFlagsKnown = false)
+{
+    if (!ObservationEnabled()) return;
+    SampledDiagnosticTimer timer(TimingStage::Observation);
+    if (!IsCreated(result, output)) return;
+    if (properties == nullptr || description == nullptr)
+    {
+        RecordSkip(Skip::SizeUnknown);
+        return;
+    }
+    if (description->Dimension == D3D12_RESOURCE_DIMENSION_BUFFER && description->Width < MinimumTrackedBytes)
+    {
+        RecordSkip(Skip::Small);
+        return;
+    }
+    const auto info = device->GetResourceAllocationInfo2(0, 1, description, nullptr);
+    ObserveObject(*output, info.SizeInBytes, Kind::Committed, ClassifyMemory(*properties), caller,
+                  CopyResourceMetadata(*description, *properties, heapFlags, heapFlagsKnown));
+}
+inline void ObserveHeap(HRESULT result, const D3D12_HEAP_DESC* description, void** output, void* caller)
+{
+    if (!ObservationEnabled()) return;
+    SampledDiagnosticTimer timer(TimingStage::Observation);
+    if (!IsCreated(result, output)) return;
+    if (description == nullptr)
+    {
+        RecordSkip(Skip::SizeUnknown);
+        return;
+    }
+    AllocationMetadata metadata;
+    metadata.descriptorKnown = true;
+    metadata.alignment = description->Alignment;
+    CopyHeapProperties(metadata, description->Properties, static_cast<uint32_t>(description->Flags), true);
+    ObserveObject(*output, description->SizeInBytes, Kind::Heap, ClassifyMemory(description->Properties), caller, metadata);
+}
+
+static HRESULT hkCommitted1(ID3D12Device4* device, const D3D12_HEAP_PROPERTIES* properties, D3D12_HEAP_FLAGS flags,
+                            const D3D12_RESOURCE_DESC* description, D3D12_RESOURCE_STATES state,
+                            const D3D12_CLEAR_VALUE* clear, ID3D12ProtectedResourceSession* session,
+                            REFIID iid, void** output)
+{
+    CreationScope scope;
+    auto result = committed1(device, properties, flags, description, state, clear, session, iid, output);
+    if (scope.outermost) ObserveCommitted0(result, device, properties, description, output, _ReturnAddress(), static_cast<uint32_t>(flags), true);
+    return result;
+}
+static HRESULT hkCommitted2(ID3D12Device8* device, const D3D12_HEAP_PROPERTIES* properties, D3D12_HEAP_FLAGS flags,
+                            const D3D12_RESOURCE_DESC1* description, D3D12_RESOURCE_STATES state,
+                            const D3D12_CLEAR_VALUE* clear, ID3D12ProtectedResourceSession* session,
+                            REFIID iid, void** output)
+{
+    CreationScope scope;
+    auto result = committed2(device, properties, flags, description, state, clear, session, iid, output);
+    if (scope.outermost) ObserveCommitted2(result, device, properties, description, output, _ReturnAddress(), static_cast<uint32_t>(flags), true);
+    return result;
+}
+static HRESULT hkCommitted3(ID3D12Device10* device, const D3D12_HEAP_PROPERTIES* properties, D3D12_HEAP_FLAGS flags,
+                            const D3D12_RESOURCE_DESC1* description, D3D12_BARRIER_LAYOUT layout,
+                            const D3D12_CLEAR_VALUE* clear, ID3D12ProtectedResourceSession* session,
+                            UINT32 formatCount, const DXGI_FORMAT* formats, REFIID iid, void** output)
+{
+    CreationScope scope;
+    auto result = committed3(device, properties, flags, description, layout, clear, session, formatCount, formats, iid, output);
+    if (scope.outermost)
+    {
+        // Castable-format allocations need GetResourceAllocationInfo3 (Device12).
+        // Do not attribute an inaccurate older-API size when that list is used.
+        if (formatCount != 0 && ObservationEnabled() && IsCreated(result, output)) RecordSkip(Skip::SizeUnknown);
+        else if (formatCount == 0) ObserveCommitted2(result, device, properties, description, output, _ReturnAddress(), static_cast<uint32_t>(flags), true);
+    }
+    return result;
+}
+static HRESULT hkHeap0(ID3D12Device* device, const D3D12_HEAP_DESC* description, REFIID iid, void** output)
+{
+    CreationScope scope;
+    auto result = heap0(device, description, iid, output);
+    if (scope.outermost) ObserveHeap(result, description, output, _ReturnAddress());
+    return result;
+}
+static HRESULT hkHeap1(ID3D12Device4* device, const D3D12_HEAP_DESC* description,
+                       ID3D12ProtectedResourceSession* session, REFIID iid, void** output)
+{
+    CreationScope scope;
+    auto result = heap1(device, description, session, iid, output);
+    if (scope.outermost) ObserveHeap(result, description, output, _ReturnAddress());
+    return result;
+}
+
+VALIDATE_MEMBER_HOOK(hkCommitted1, Committed1Fn)
+VALIDATE_MEMBER_HOOK(hkCommitted2, Committed2Fn)
+VALIDATE_MEMBER_HOOK(hkCommitted3, Committed3Fn)
+VALIDATE_MEMBER_HOOK(hkHeap0, Heap0Fn)
+VALIDATE_MEMBER_HOOK(hkHeap1, Heap1Fn)
+
+inline void Install(ID3D12Device* device, Committed0Fn* baseOriginal, Committed0Fn baseHook, bool baseAlreadyHooked)
+{
+    std::lock_guard lock(installationMutex);
+    if (!ObservationEnabled()) return;
+    if (installed || installationAttempts >= 3 || device == nullptr) return;
+    ++installationAttempts;
+    // Prepare the fixed CPU ledger outside Present/periodic reporting.
+    if (!PrepareDiagnostics()) RecordSkip(Skip::CounterUnavailable);
+    auto baseVtable = *reinterpret_cast<void***>(device);
+    struct Hook { PVOID* original; PVOID replacement; PVOID target; uint32_t bit; };
+    std::array<Hook, 6> hooks {{
+        { reinterpret_cast<PVOID*>(baseOriginal), reinterpret_cast<PVOID>(baseHook), baseVtable[27], 1 },
+        { reinterpret_cast<PVOID*>(&heap0), reinterpret_cast<PVOID>(hkHeap0), baseVtable[28], 2 },
+        { reinterpret_cast<PVOID*>(&committed1), reinterpret_cast<PVOID>(hkCommitted1), nullptr, 4 },
+        { reinterpret_cast<PVOID*>(&heap1), reinterpret_cast<PVOID>(hkHeap1), nullptr, 8 },
+        { reinterpret_cast<PVOID*>(&committed2), reinterpret_cast<PVOID>(hkCommitted2), nullptr, 16 },
+        { reinterpret_cast<PVOID*>(&committed3), reinterpret_cast<PVOID>(hkCommitted3), nullptr, 32 }
+    }};
+    ID3D12Device4* device4 = nullptr;
+    if (SUCCEEDED(device->QueryInterface(IID_PPV_ARGS(&device4))) && device4 != nullptr)
+    {
+        auto vtable = *reinterpret_cast<void***>(device4);
+        hooks[2].target = vtable[53]; hooks[3].target = vtable[54];
+        device4->Release();
+    }
+    ID3D12Device8* device8 = nullptr;
+    if (SUCCEEDED(device->QueryInterface(IID_PPV_ARGS(&device8))) && device8 != nullptr)
+    {
+        hooks[4].target = (*reinterpret_cast<void***>(device8))[69];
+        device8->Release();
+    }
+    ID3D12Device10* device10 = nullptr;
+    if (SUCCEEDED(device->QueryInterface(IID_PPV_ARGS(&device10))) && device10 != nullptr)
+    {
+        hooks[5].target = (*reinterpret_cast<void***>(device10))[76];
+        device10->Release();
+    }
+    uint32_t supported = 0, selected = 0, failed = 0;
+    for (size_t i = 0; i < hooks.size(); ++i)
+    {
+        auto& hook = hooks[i];
+        if (hook.target == nullptr) continue;
+        supported |= hook.bit;
+        bool duplicate = false;
+        for (size_t j = 0; j < hooks.size(); ++j)
+            if (j != i && hooks[j].target == hook.target) duplicate = true;
+        // Different COM signatures may share an unsupported-method thunk. Do
+        // not hook either signature in a collision group. A pre-existing UE
+        // hook remains its owner's responsibility and is never attached twice.
+        if (duplicate && (i != 0 || !baseAlreadyHooked)) { failed |= hook.bit; continue; }
+        selected |= hook.bit;
+        if (i != 0 || !baseAlreadyHooked) *hook.original = hook.target;
+    }
+    auto result = DetourTransactionBegin();
+    if (result == NO_ERROR)
+    {
+        result = DetourUpdateThread(GetCurrentThread());
+        for (size_t i = 0; result == NO_ERROR && i < hooks.size(); ++i)
+            if ((selected & hooks[i].bit) != 0 && (i != 0 || !baseAlreadyHooked))
+                result = DetourAttach(hooks[i].original, hooks[i].replacement);
+        if (result == NO_ERROR) result = DetourTransactionCommit();
+        else DetourTransactionAbort();
+    }
+    baseCommittedHooked = baseAlreadyHooked || (result == NO_ERROR && (selected & 1u) != 0);
+    if (result != NO_ERROR)
+    {
+        for (size_t i = 0; i < hooks.size(); ++i)
+            if (i != 0 || !baseAlreadyHooked) *hooks[i].original = nullptr;
+        failed |= selected;
+        selected = baseAlreadyHooked ? 1u : 0u;
+    }
+    else
+    {
+        installed = true;
+        for (size_t i = 0; i < hooks.size(); ++i)
+            if ((selected & hooks[i].bit) == 0 && (i != 0 || !baseAlreadyHooked)) *hooks[i].original = nullptr;
+    }
+    currentApiMask = selected;
+    RecordApiSupport(supported, selected, failed);
+    LOG_INFO("GPU allocation observation: supportedMask=0x{:X}, installedMask=0x{:X}, failedMask=0x{:X}, detour={}, threshold=1MiB, slots=4096; partial caller allocation estimates, not residency",
+             supported, selected, failed, result);
+}
+// The existing device hooks own the surrounding transaction and Committed0.
+// If any detach fails the caller aborts, retaining every original trampoline.
+inline LONG AppendDetachInTransaction()
+{
+    struct Hook { PVOID* original; PVOID replacement; uint32_t bit; };
+    const std::array<Hook, 5> hooks {{
+        { reinterpret_cast<PVOID*>(&heap0), reinterpret_cast<PVOID>(hkHeap0), 2 },
+        { reinterpret_cast<PVOID*>(&committed1), reinterpret_cast<PVOID>(hkCommitted1), 4 },
+        { reinterpret_cast<PVOID*>(&heap1), reinterpret_cast<PVOID>(hkHeap1), 8 },
+        { reinterpret_cast<PVOID*>(&committed2), reinterpret_cast<PVOID>(hkCommitted2), 16 },
+        { reinterpret_cast<PVOID*>(&committed3), reinterpret_cast<PVOID>(hkCommitted3), 32 }
+    }};
+    for (const auto& hook : hooks)
+        if ((currentApiMask & hook.bit) != 0 && *hook.original != nullptr)
+        {
+            const auto result = DetourDetach(hook.original, hook.replacement);
+            if (result != NO_ERROR) return result;
+        }
+    return NO_ERROR;
+}
+inline void FinishDetachSuccess()
+{
+    heap0 = nullptr; heap1 = nullptr;
+    committed1 = nullptr; committed2 = nullptr; committed3 = nullptr;
+    baseCommittedHooked = false;
+    currentApiMask = 0;
+    installed = false;
+    installationAttempts = 0;
+    installedApiMask.store(0, std::memory_order_release);
+}
+
