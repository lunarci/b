+{
+    bool found = false;
+    uint64_t submittedThroughGeneration;
+    {
+        std::lock_guard lock(_pendingCommandMutex);
+        if (_pendingCommandListCount == 0)
+            return 0;
+        submittedThroughGeneration = _pendingGeneration;
+    }
+    for (UINT i = 0; i < count && !found; ++i)
+    {
+        ID3D12CommandList* realList = nullptr;
+        if (!CheckForRealObject(__FUNCTION__, lists[i], (IUnknown**) &realList))
+            realList = lists[i];
+        std::lock_guard lock(_pendingCommandMutex);
+        for (size_t j = 0; j < _pendingCommandListCount; ++j)
+            if (realList == _pendingCommandLists[j].identity)
+            {
+                found = true;
+                break;
+            }
