+        const auto progress = XeFGProgress::ReadSnapshot();
+        const auto lifecycle = XeFGProgress::ReadLifecycleSnapshot();
+        const auto now = XeFGDiagnostics::WorkNowMs();
+        const auto age = [now](std::uint64_t tick) -> std::int64_t {
+            return tick != 0 && now >= tick ? static_cast<std::int64_t>(now - tick) : -1;
+        };
+        // At most eight records, formatted only on a bounded log event. A
+        // completed marker covers work before that signal on that queue only.
+        std::string queues;
+        queues.reserve(1536);
+        if (progress.valid)
+            for (unsigned i = 0; i < progress.queues.size(); ++i)
+            {
+                const auto& q = progress.queues[i];
+                if (!q.tracked) continue;
+                queues += std::format(" q{}={}/{}/{}/{}/{}/{}/{}/{}/{}/{}/{}/{}/{}/{:08X}/{}",
+                    i, q.queueId, q.queueType, q.fenceReady, q.stopped,
+                    q.signalCount, q.completionCount, age(q.pendingSinceMs), age(q.lastSubmissionTickMs),
+                    age(q.lastPollTickMs), q.completionObservationMaxMs, q.createFailures, q.signalFailures, q.deviceRemoved,
+                    static_cast<std::uint32_t>(q.lastError), q.coalesced);
