+bool XeFG_Dx12::DrainLifetimeQueues()
+{
+    LongSession::WaitScope drainScope(LongSession::WaitStage::GpuFence);
+    size_t count;
+    {
+        std::lock_guard lock(_lifetimeQueueMutex);
+        if (!_queueTrackingComplete)
+            return false;
+        count = _lifetimeQueueCount;
+    }
+
+    // Called only at context lifecycle boundaries, never in the frame loop.
+    // QuiesceWork has stopped tags/recording, observed their pending submissions,
+    // and closed submission admission before this stable queue snapshot.
+    // One deadline covers all queues rather than allowing 5 seconds per queue.
+    const auto deadline = GetTickCount64() + 5000;
+    for (size_t i = 0; i < count; ++i)
+    {
+        auto& entry = _lifetimeQueues[i];
+        if (entry.fence == nullptr)
+        {
+            ID3D12Device* device = nullptr;
+            auto result = entry.queue->GetDevice(IID_PPV_ARGS(&device));
+            if (FAILED(result))
+                return false;
+            result = device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&entry.fence));
+            device->Release();
+            if (FAILED(result))
+                return false;
+        }
+        if (entry.event == nullptr)
+        {
+            entry.event = CreateEvent(nullptr, FALSE, FALSE, nullptr);
+            if (entry.event == nullptr)
+                return false;
+        }
+        const auto value = ++entry.value;
+        if (FAILED(entry.queue->Signal(entry.fence, value)))
+        {
+            LOG_ERROR("XeFG teardown fence signal failed; preserving owned resources");
+            return false;
+        }
     }
 
+    // Signal all used queues before waiting; no queue can be mistaken for idle
+    // just because another queue has completed.
+    for (size_t i = 0; i < count; ++i)
+    {
+        auto& entry = _lifetimeQueues[i];
+        auto completed = entry.fence->GetCompletedValue();
+        if (completed == UINT64_MAX)
+        {
+            LOG_ERROR("XeFG teardown detected device removal; preserving owned resources");
+            return false;
+        }
+        if (completed < entry.value)
+        {
+            ResetEvent(entry.event);
+            if (FAILED(entry.fence->SetEventOnCompletion(entry.value, entry.event)))
+                return false;
+            const auto now = GetTickCount64();
+            const DWORD remaining = now < deadline ? static_cast<DWORD>(deadline - now) : 0;
+            const auto wait = WaitForSingleObject(entry.event, remaining);
+            completed = entry.fence->GetCompletedValue();
+            if (wait != WAIT_OBJECT_0 || completed == UINT64_MAX || completed < entry.value)
+            {
+                // Preserve the event/fence until its completion callback ends.
+                LOG_ERROR("XeFG teardown fence did not complete; queue {}, target {}, completed {}, wait {}",
+                          i, entry.value, completed, wait);
+                return false;
+            }
+        }
+    }
     return true;
 }
