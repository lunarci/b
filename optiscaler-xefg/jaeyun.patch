+             "allocation_est_live_peak={}/{}B unknown={} alloc_release={}/{} allocation_fail={} alias_preserved={} "
+             "missing_depth_velocity_both={}/{}/{} bursts_recovered_current_peak={}/{}/{}/{} accounting_errors={}",
+             report.contextId, report.startLiveCopies, report.startLiveBytes, s.liveCopies, s.peakCopies,
+             s.liveBytes, s.peakBytes, s.unknownSizeCopies, s.allocations, s.releases, s.allocationFailures,
+             s.aliasPreserved, s.missingDepthOnly, s.missingVelocityOnly, s.missingBoth, s.missingBursts,
+             s.recoveredBursts, s.currentMissingBurst, s.peakMissingBurst, s.accountingErrors);
+}
