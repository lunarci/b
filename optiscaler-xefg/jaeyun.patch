+void XeFG_Dx12::SetCommandQueue(FG_ResourceType type, ID3D12CommandQueue* queue)
+{
+    auto work = AcquireWork();
+    if (!work)
+        return;
+    TrackLifetimeQueue(queue);
+    if (!ResTrack_Dx12::LifetimeObserversReady(nullptr, queue))
+    {
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::ObserverUnavailable);
+        return;
+    }
+    _gameCommandQueue = queue;
+}
+
+bool XeFG_Dx12::TrackPendingCommandList(ID3D12GraphicsCommandList* cmdList)
+{
+    if (!ResTrack_Dx12::LifetimeObserversReady(cmdList, _gameCommandQueue))
+    {
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::ObserverUnavailable);
+        return false; // No GPU commands or falsely unobservable pending entry.
+    }
+    ID3D12GraphicsCommandList* realList = nullptr;
+    if (!CheckForRealObject(__FUNCTION__, cmdList, (IUnknown**) &realList))
+        realList = cmdList;
+    std::lock_guard lock(_pendingCommandMutex);
+    for (size_t i = 0; i < _pendingCommandListCount; ++i)
+        if (_pendingCommandLists[i].identity == realList)
+            return true;
+    if (_pendingCommandListCount == MaxPendingCommandLists)
+    {
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::PendingUnsubmitted);
+        return false; // Reject before recording; existing tracking remains complete.
+    }
+    _pendingCommandLists[_pendingCommandListCount++] = {realList, ++_pendingGeneration, XeFGDiagnostics::WorkNowMs()};
+    ++_pendingStats.registered;
+    PublishPendingLocked();
+    return true;
+}
+
+void XeFG_Dx12::BeforeCommandSubmission(ID3D12CommandQueue* queue, UINT count,
+                                       ID3D12CommandList* const* lists)
+{
+    bool found = false;
+    {
+        std::lock_guard lock(_pendingCommandMutex);
+        if (_pendingCommandListCount == 0)
+            return;
+    }
+    for (UINT i = 0; i < count && !found; ++i)
+    {
+        ID3D12CommandList* realList = nullptr;
+        if (!CheckForRealObject(__FUNCTION__, lists[i], (IUnknown**) &realList))
+            realList = lists[i];
+        std::lock_guard lock(_pendingCommandMutex);
+        for (size_t j = 0; j < _pendingCommandListCount; ++j)
+            if (realList == _pendingCommandLists[j].identity)
+            {
+                found = true;
+                break;
+            }
+    }
+    // Registration precedes the real ExecuteCommandLists and is covered by its
+    // submission token. A teardown snapshot cannot miss this queue.
+    if (found)
+        TrackLifetimeQueue(queue);
+}
+
+void XeFG_Dx12::AfterCommandSubmission(UINT count, ID3D12CommandList* const* lists)
+{
+    {
+        std::lock_guard lock(_pendingCommandMutex);
+        if (_pendingCommandListCount == 0) return;
+    }
+    for (UINT i = 0; i < count; ++i)
+    {
+        ID3D12CommandList* realList = nullptr;
+        if (!CheckForRealObject(__FUNCTION__, lists[i], (IUnknown**) &realList)) realList = lists[i];
+        std::lock_guard lock(_pendingCommandMutex);
+        for (size_t j = 0; j < _pendingCommandListCount;)
+            if (realList == _pendingCommandLists[j].identity)
+            {
+                _pendingCommandLists[j] = _pendingCommandLists[--_pendingCommandListCount];
+                ++_pendingStats.submitted;
+            }
+            else ++j;
+        PublishPendingLocked();
+    }
+}
+
+void XeFG_Dx12::DiscardPendingCommandList(ID3D12GraphicsCommandList* cmdList)
+{
+    ID3D12CommandList* realList = nullptr;
+    if (!CheckForRealObject(__FUNCTION__, cmdList, (IUnknown**) &realList)) realList = cmdList;
+    std::lock_guard lock(_pendingCommandMutex);
+    for (size_t i = 0; i < _pendingCommandListCount;)
+        if (_pendingCommandLists[i].identity == realList)
+        {
+            _pendingCommandLists[i] = _pendingCommandLists[--_pendingCommandListCount];
+            ++_pendingStats.resetDiscarded;
+        }
+        else ++i;
+    PublishPendingLocked();
+}
+
+uint64_t XeFG_Dx12::CapturePendingCommandListGeneration(const void* nativeIdentity)
+{
+    // Called from native Release. Never QI/dereference here: QI's temporary
+    // Release would re-enter this hook while the registry lock is held.
+    std::lock_guard lock(_pendingCommandMutex);
+    for (size_t i = 0; i < _pendingCommandListCount; ++i)
+        if (_pendingCommandLists[i].identity == nativeIdentity)
+            return _pendingCommandLists[i].generation;
+    return 0;
+}
+
+void XeFG_Dx12::RetirePendingCommandList(const void* nativeIdentity, uint64_t generation)
+{
+    if (generation == 0) return;
+    std::lock_guard lock(_pendingCommandMutex);
+    for (size_t i = 0; i < _pendingCommandListCount; ++i)
+        if (_pendingCommandLists[i].identity == nativeIdentity && _pendingCommandLists[i].generation == generation)
+        {
+            _pendingCommandLists[i] = _pendingCommandLists[--_pendingCommandListCount];
+            ++_pendingStats.destroyed;
+            PublishPendingLocked();
+            return;
+        }
+}
+
+void XeFG_Dx12::PublishPendingLocked()
+{
+    _pendingStats.current = _pendingCommandListCount;
+    _pendingStats.peak = (std::max)(_pendingStats.peak, static_cast<uint64_t>(_pendingCommandListCount));
+    _pendingStats.oldestObservedTickMs = 0;
+    for (size_t i = 0; i < _pendingCommandListCount; ++i)
+    {
+        const auto tick = _pendingCommandLists[i].firstSeenTickMs;
+        if (_pendingStats.oldestObservedTickMs == 0 || tick < _pendingStats.oldestObservedTickMs)
+            _pendingStats.oldestObservedTickMs = tick;
+    }
+    _workDiagnostics.PublishPendingSnapshot(_pendingStats);
+}
+
+void XeFG_Dx12::RecordCopyAllocation(int index, FG_ResourceType type, ID3D12Resource* previous)
+{
+    auto resource = _resourceCopy[index][type];
+    if (resource == previous || resource == nullptr)
+        return;
+    CopyAllocationInfo allocation;
+    const auto desc = resource->GetDesc();
+    if (_device != nullptr)
+    {
+        const auto info = _device->GetResourceAllocationInfo(0, 1, &desc);
+        allocation.known = info.SizeInBytes != UINT64_MAX;
+        allocation.bytes = allocation.known ? info.SizeInBytes : 0;
+    }
+    // Include the replacement overlap. These are allocation estimates and owned
+    // references, not current residency or proof of an immediate driver free.
+    _resourceDiagnostics.OnAllocate(allocation.bytes, allocation.known);
+    if (previous != nullptr)
+    {
+        const auto old = _copyAllocationInfo[index][type];
+        _resourceDiagnostics.OnRelease(old.bytes, old.known);
+    }
+    _copyAllocationInfo[index][type] = allocation;
+}
+
+void XeFG_Dx12::ReportResourceDiagnostics()
+{
+    XeFGDiagnostics::Report report;
+    if (!_resourceDiagnostics.TryReport(GetTickCount64(), report))
+        return;
+    const auto& s = report.counters;
+    LOG_WARN("[XeFGResources] scope=owned_resourceCopy_only context={} start_live={}/{}B live_peak={}/{} "
+             "allocation_est_live_peak={}/{}B unknown={} alloc_release={}/{} allocation_fail={} alias_preserved={} "
+             "missing_depth_velocity_both={}/{}/{} bursts_recovered_current_peak={}/{}/{}/{} accounting_errors={}",
+             report.contextId, report.startLiveCopies, report.startLiveBytes, s.liveCopies, s.peakCopies,
+             s.liveBytes, s.peakBytes, s.unknownSizeCopies, s.allocations, s.releases, s.allocationFailures,
+             s.aliasPreserved, s.missingDepthOnly, s.missingVelocityOnly, s.missingBoth, s.missingBursts,
+             s.recoveredBursts, s.currentMissingBurst, s.peakMissingBurst, s.accountingErrors);
+}
+
+bool XeFG_Dx12::TryCloseCpuAdmission()
+{
+    _workWasClosed = _workGate.IsClosed();
+    _presentWasClosed = _providerPresentGate.IsClosed();
+    _submissionWasClosed = _submissionGate.IsClosed();
+    _submissionClosedByLifecycle = false;
+    if (!_workGate.TryCloseWhenIdle())
+    {
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::CpuBusy);
+        return false;
+    }
+    if (!_providerPresentGate.TryCloseWhenIdle())
+    {
+        if (!_workWasClosed) _workGate.Open();
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::CpuBusy);
+        return false;
+    }
+    // Execute/Reset/final Release observation must stay alive even while the
+    // provider is paused: native game API calls always continue to execute.
+    return true;
+}
+
+void XeFG_Dx12::RestoreCpuAdmission()
+{
+    if (_submissionClosedByLifecycle && !_submissionWasClosed) _submissionGate.Open();
+    _submissionClosedByLifecycle = false;
+    if (!_presentWasClosed) _providerPresentGate.Open();
+    if (!_workWasClosed) _workGate.Open();
+}
+
+void XeFG_Dx12::RestoreProviderState(bool wasActive)
+{
+    if (!wasActive || _isActive || _swapChainContext == nullptr) return;
+    if (XeFGProxy::SetEnabled()(_swapChainContext, true) == XEFG_SWAPCHAIN_RESULT_SUCCESS)
+        _isActive = true;
+    else
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::ProviderDisableFailed);
+}
+
+bool XeFG_Dx12::QuiesceWork()
+{
+    if (!TryCloseCpuAdmission()) return false;
+    bool pending;
+    {
+        std::lock_guard lock(_pendingCommandMutex);
+        PublishPendingLocked();
+        pending = !_pendingTrackingComplete || _pendingCommandListCount != 0;
+    }
+    if (pending)
+    {
+        RestoreCpuAdmission();
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::PendingUnsubmitted);
+        return false;
+    }
+    // Work admission is closed, so no new tracked recording can be added.
+    // Close observers only after pending == 0. If a callback is in flight,
+    // defer without closing it or losing its actual native API observation.
+    if (!_submissionGate.TryCloseWhenIdle())
+    {
+        RestoreCpuAdmission();
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::CpuBusy);
+        return false;
+    }
+    _submissionClosedByLifecycle = true;
+    {
+        std::lock_guard lock(_pendingCommandMutex);
+        if (!_pendingTrackingComplete || _pendingCommandListCount != 0)
+        {
+            RestoreCpuAdmission();
+            _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::PendingUnsubmitted);
+            return false;
+        }
+    }
+    return true;
+}
 
