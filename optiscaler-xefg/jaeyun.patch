diff --git a/OptiScaler/misc/GpuAllocationDiagnostics.h b/OptiScaler/misc/GpuAllocationDiagnostics.h
new file mode 100644
index 00000000..19ddc87a
--- /dev/null
+++ b/OptiScaler/misc/GpuAllocationDiagnostics.h
@@ -0,0 +1,440 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <atomic>
+#include <cstdint>
+#include <cstddef>
+#include <limits>
+#include <mutex>
+#include <new>
+#include <tuple>
+
+// Partial accounting of observed creation callers, not logical ownership or
+// residency. Explicit heaps and committed resources are counted; placed and
+// reserved resources are not added again. No game object pointers are retained.
+namespace GpuAllocationDiagnostics
+{
+inline constexpr uint64_t MinimumTrackedBytes = 1024 * 1024;
+inline constexpr size_t SlotCount = 4096;
+enum class Caller : uint8_t { Game, XeFG, XeSS, FFX, OptiScaler, Streamline, Other, Unknown, Count };
+inline constexpr size_t CallerCount = static_cast<size_t>(Caller::Count);
+enum class Kind : uint8_t { Committed, Heap };
+enum class MemoryClass : uint8_t { Default, CpuVisible, Unclassified };
+enum class Skip : uint8_t { Small, PoolFull, NotifierUnsupported, RegistrationFailed, AllocationFailed, SizeUnknown,
+                            PinFailed, CounterUnavailable, Count };
+enum class Api : uint32_t { Committed0 = 1u, Heap0 = 2u, Committed1 = 4u, Heap1 = 8u,
+                            Committed2 = 16u, Committed3 = 32u };
+
+inline const char* CallerName(Caller caller)
+{
+    constexpr const char* names[] = { "game", "xefg", "xess", "ffx", "optiscaler", "streamline", "other", "unknown" };
+    const auto index = static_cast<size_t>(caller);
+    return names[index < CallerCount ? index : CallerCount - 1];
+}
+
+// Only the first explicit initialization changes the startup setting. Existing
+// callbacks always retire their tokens; this flag is never a cleanup command.
+inline std::atomic<uint8_t> observationMode { 0 }; // 0 unset, 1 off, 2 on
+inline void InitializeObservation(bool enabled)
+{
+    uint8_t expected = 0;
+    observationMode.compare_exchange_strong(expected, enabled ? 2 : 1, std::memory_order_release);
+}
+inline bool ObservationEnabled() { return observationMode.load(std::memory_order_acquire) != 1; }
+inline uint64_t MonotonicMilliseconds()
+{
+    return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+// Copied creation arguments, never queried through retained resource pointers.
+// moduleBase identifies an immediate calling module in this process; RVA is
+// meaningful with that exact binary. Neither field establishes logical ownership.
+struct AllocationMetadata
+{
+    uint64_t moduleBase = 0, callerRva = 0, createdMs = 0, width = 0, alignment = 0;
+    uint32_t dimension = 0, height = 0, depthOrArray = 0, mipLevels = 0, format = 0;
+    uint32_t sampleCount = 0, sampleQuality = 0, layout = 0, resourceFlags = 0;
+    uint32_t heapType = 0, heapFlags = 0, cpuPageProperty = 0, memoryPoolPreference = 0;
+    uint32_t creationNodeMask = 0, visibleNodeMask = 0;
+    bool descriptorKnown = false, heapFlagsKnown = false;
+};
+inline auto MetadataKey(const AllocationMetadata& m)
+{
+    // Creation time is deliberately excluded: otherwise each object forms a group.
+    return std::tie(m.moduleBase, m.callerRva, m.width, m.alignment, m.dimension,
+                    m.height, m.depthOrArray, m.mipLevels, m.format, m.sampleCount,
+                    m.sampleQuality, m.layout, m.resourceFlags, m.heapType, m.heapFlags,
+                    m.cpuPageProperty, m.memoryPoolPreference, m.creationNodeMask,
+                    m.visibleNodeMask, m.descriptorKnown, m.heapFlagsKnown);
+}
+inline constexpr size_t TopGroupCount = 8;
+struct GroupSnapshot
+{
+    Caller caller = Caller::Unknown;
+    Kind kind = Kind::Committed;
+    MemoryClass memory = MemoryClass::Unclassified;
+    AllocationMetadata metadata {};
+    uint64_t liveBytes = 0, liveCount = 0, oldestAgeMs = 0, youngestAgeMs = 0;
+};
+struct GrowthGroupSnapshot
+{
+    GroupSnapshot group {};
+    uint64_t baselineBytes = 0, growthBytes = 0;
+};
+struct DetailSnapshot
+{
+    std::array<GroupSnapshot, TopGroupCount> groups {};
+    std::array<GrowthGroupSnapshot, TopGroupCount> growthGroups {};
+    uint32_t growthGroupCount = 0;
+    bool growthBaselineAvailable = false;
+    uint64_t growthBaselineCapturedMs = 0, growthIntervalMs = 0;
+    uint32_t groupCount = 0, liveObjects = 0;
+    uint64_t observedBytes = 0, capturedMs = 0;
+};
+enum class TimingStage : uint8_t { Observation, Destruction, DetailSnapshot, Count };
+inline constexpr size_t TimingStageCount = static_cast<size_t>(TimingStage::Count);
+struct TimingSnapshot { uint64_t samples = 0, totalNanoseconds = 0, maximumNanoseconds = 0; };
+struct TimingCounters
+{
+    std::atomic<uint64_t> samples { 0 }, totalNanoseconds { 0 }, maximumNanoseconds { 0 };
+};
+inline std::array<TimingCounters, TimingStageCount> timings {};
+// Two clock reads per 64 calls on each thread/stage. Original driver creation
+// calls occur before this scope. Max is sampled, and contended CAS is bounded.
+class SampledDiagnosticTimer
+{
+    TimingStage stage;
+    bool selected;
+    std::chrono::steady_clock::time_point start;
+  public:
+    explicit SampledDiagnosticTimer(TimingStage value) : stage(value)
+    {
+        static thread_local std::array<uint8_t, TimingStageCount> calls {};
+        auto& count = calls[static_cast<size_t>(stage)];
+        count = static_cast<uint8_t>((count + 1) & 63);
+        selected = count == 0;
+        if (selected) start = std::chrono::steady_clock::now();
+    }
+    ~SampledDiagnosticTimer()
+    {
+        if (!selected) return;
+        const auto elapsed = std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now() - start).count();
+        const auto ns = static_cast<uint64_t>(elapsed > 0 ? elapsed : 0);
+        auto& counter = timings[static_cast<size_t>(stage)];
+        counter.samples.fetch_add(1, std::memory_order_relaxed);
+        counter.totalNanoseconds.fetch_add(ns, std::memory_order_relaxed);
+        auto maximum = counter.maximumNanoseconds.load(std::memory_order_relaxed);
+        for (unsigned attempt = 0; attempt < 4 && maximum < ns; ++attempt)
+            if (counter.maximumNanoseconds.compare_exchange_weak(maximum, ns, std::memory_order_relaxed)) break;
+    }
+};
+
+struct CallerSnapshot
+{
+    uint64_t liveCommittedBytes = 0, liveHeapBytes = 0;
+    // These are subsets of liveCommittedBytes + liveHeapBytes, not extra heaps.
+    uint64_t liveDefaultBytes = 0, liveCpuVisibleBytes = 0, liveUnclassifiedBytes = 0;
+    // Peak includes briefly observed, successfully created allocations whose
+    // notifier registration later fails; the live and cumulative tracked totals
+    // are rolled back in that case. It is never a peak-resident-VRAM value.
+    uint64_t liveCount = 0, peakBytes = 0, allocatedBytes = 0, releasedBytes = 0, allocations = 0, releases = 0;
+};
+struct Snapshot
+{
+    std::array<CallerSnapshot, CallerCount> callers {};
+    std::array<TimingSnapshot, TimingStageCount> timing {};
+    bool observationInitialized = false, observationEnabled = true;
+    uint64_t smallSkipped = 0, poolExhausted = 0, notifierUnsupported = 0, registrationFailed = 0;
+    uint64_t allocationFailed = 0, sizeUnknown = 0, pinFailed = 0, counterUnavailable = 0;
+    uint32_t supportedApiMask = 0, installedApiMask = 0, failedApiMask = 0;
+};
+
+inline std::array<std::atomic<uint64_t>, static_cast<size_t>(Skip::Count)> skipped {};
+inline std::atomic<uint32_t> supportedApiMask { 0 }, installedApiMask { 0 }, failedApiMask { 0 };
+inline void RecordSkip(Skip reason) { skipped[static_cast<size_t>(reason)].fetch_add(1, std::memory_order_relaxed); }
+inline void RecordApiSupport(uint32_t supported, uint32_t installed, uint32_t failed)
+{
+    supportedApiMask.fetch_or(supported, std::memory_order_relaxed);
+    installedApiMask.store(installed, std::memory_order_release);
+    failedApiMask.fetch_or(failed, std::memory_order_relaxed);
+}
+
+class Ledger
+{
+    struct Slot
+    {
+        uint64_t generation = 0, bytes = 0;
+        Caller caller = Caller::Unknown;
+        Kind kind = Kind::Committed;
+        MemoryClass memory = MemoryClass::Unclassified;
+        bool active = false;
+        AllocationMetadata metadata {};
+    };
+    std::mutex mutex;
+    std::array<Slot, SlotCount> slots {};
+    std::array<uint16_t, SlotCount> freeSlots {};
+    std::array<CallerSnapshot, CallerCount> callers {};
+    size_t available = SlotCount;
+    uint64_t generation = 0;
+
+    bool Remove(uint64_t token, bool cancelled)
+    {
+        const auto index = static_cast<size_t>(token & (SlotCount - 1));
+        const auto expectedGeneration = token >> 12;
+        if (expectedGeneration == 0)
+            return false;
+        std::lock_guard lock(mutex);
+        auto& slot = slots[index];
+        if (!slot.active || slot.generation != expectedGeneration)
+            return false;
+        auto& totals = callers[static_cast<size_t>(slot.caller)];
+        auto& typeBytes = slot.kind == Kind::Committed ? totals.liveCommittedBytes : totals.liveHeapBytes;
+        typeBytes -= slot.bytes;
+        auto& memoryBytes = slot.memory == MemoryClass::Default ? totals.liveDefaultBytes :
+                            slot.memory == MemoryClass::CpuVisible ? totals.liveCpuVisibleBytes : totals.liveUnclassifiedBytes;
+        memoryBytes -= slot.bytes;
+        --totals.liveCount;
+        if (cancelled)
+        {
+            totals.allocatedBytes -= slot.bytes;
+            --totals.allocations;
+        }
+        else
+        {
+            totals.releasedBytes += slot.bytes;
+            ++totals.releases;
+        }
+        slot.active = false;
+        freeSlots[available++] = static_cast<uint16_t>(index);
+        return true;
+    }
+
+  public:
+    Ledger()
+    {
+        for (size_t i = 0; i < SlotCount; ++i)
+            freeSlots[i] = static_cast<uint16_t>(SlotCount - i - 1);
+    }
+    uint64_t Track(Caller caller, Kind kind, MemoryClass memory, uint64_t bytes,
+                   const AllocationMetadata& metadata = {})
+    {
+        if (bytes < MinimumTrackedBytes || bytes == std::numeric_limits<uint64_t>::max())
+            return 0;
+        std::lock_guard lock(mutex);
+        // Tokens carry a generation and 12-bit slot index. Never wrap a token.
+        if (available == 0 || generation == (std::numeric_limits<uint64_t>::max() >> 12))
+        {
+            RecordSkip(Skip::PoolFull);
+            return 0;
+        }
+        const auto index = freeSlots[--available];
+        auto& slot = slots[index];
+        slot = { ++generation, bytes, caller, kind, memory, true, metadata };
+        auto& totals = callers[static_cast<size_t>(caller)];
+        (kind == Kind::Committed ? totals.liveCommittedBytes : totals.liveHeapBytes) += bytes;
+        auto& memoryBytes = memory == MemoryClass::Default ? totals.liveDefaultBytes :
+                            memory == MemoryClass::CpuVisible ? totals.liveCpuVisibleBytes : totals.liveUnclassifiedBytes;
+        memoryBytes += bytes;
+        ++totals.liveCount;
+        ++totals.allocations;
+        totals.allocatedBytes += bytes;
+        const auto live = totals.liveCommittedBytes + totals.liveHeapBytes;
+        if (live > totals.peakBytes)
+            totals.peakBytes = live;
+        // Publish the fully-accounted slot before RegisterDestructionCallback.
+        return (slot.generation << 12) | index;
+    }
+    bool Retire(uint64_t token) { return Remove(token, false); }
+    bool Cancel(uint64_t token) { return Remove(token, true); }
+    struct LiveEntry
+    {
+        Caller caller = Caller::Unknown;
+        Kind kind = Kind::Committed;
+        MemoryClass memory = MemoryClass::Unclassified;
+        uint64_t bytes = 0;
+        AllocationMetadata metadata {};
+    };
+    bool TryCopyLive(std::array<LiveEntry, SlotCount>& destination, size_t& count)
+    {
+        std::unique_lock lock(mutex, std::try_to_lock);
+        if (!lock.owns_lock()) return false;
+        count = 0;
+        for (const auto& slot : slots)
+            if (slot.active)
+                destination[count++] = { slot.caller, slot.kind, slot.memory, slot.bytes, slot.metadata };
+        return true;
+    }
+    bool TryRead(std::array<CallerSnapshot, CallerCount>& destination)
+    {
+        std::unique_lock lock(mutex, std::try_to_lock);
+        if (!lock.owns_lock())
+            return false;
+        destination = callers;
+        return true;
+    }
+};
+
+// Deliberately process-lived: callbacks may arrive during static destruction.
+// This is one fixed CPU allocation; it retains no COM or GPU object references.
+inline Ledger* Instance()
+{
+    static Ledger* const ledger = new (std::nothrow) Ledger;
+    return ledger;
+}
+inline bool TryReadSnapshot(Snapshot& snapshot)
+{
+    snapshot = {};
+    snapshot.observationInitialized = observationMode.load(std::memory_order_acquire) != 0;
+    snapshot.observationEnabled = ObservationEnabled();
+    if (snapshot.observationEnabled)
+    {
+        auto ledger = Instance();
+        if (ledger == nullptr || !ledger->TryRead(snapshot.callers)) return false;
+    }
+    for (size_t i = 0; i < TimingStageCount; ++i)
+    {
+        snapshot.timing[i].samples = timings[i].samples.load(std::memory_order_relaxed);
+        snapshot.timing[i].totalNanoseconds = timings[i].totalNanoseconds.load(std::memory_order_relaxed);
+        snapshot.timing[i].maximumNanoseconds = timings[i].maximumNanoseconds.load(std::memory_order_relaxed);
+    }
+    snapshot.smallSkipped = skipped[static_cast<size_t>(Skip::Small)].load(std::memory_order_relaxed);
+    snapshot.poolExhausted = skipped[static_cast<size_t>(Skip::PoolFull)].load(std::memory_order_relaxed);
+    snapshot.notifierUnsupported = skipped[static_cast<size_t>(Skip::NotifierUnsupported)].load(std::memory_order_relaxed);
+    snapshot.registrationFailed = skipped[static_cast<size_t>(Skip::RegistrationFailed)].load(std::memory_order_relaxed);
+    snapshot.allocationFailed = skipped[static_cast<size_t>(Skip::AllocationFailed)].load(std::memory_order_relaxed);
+    snapshot.sizeUnknown = skipped[static_cast<size_t>(Skip::SizeUnknown)].load(std::memory_order_relaxed);
+    snapshot.pinFailed = skipped[static_cast<size_t>(Skip::PinFailed)].load(std::memory_order_relaxed);
+    snapshot.counterUnavailable = skipped[static_cast<size_t>(Skip::CounterUnavailable)].load(std::memory_order_relaxed);
+    snapshot.supportedApiMask = supportedApiMask.load(std::memory_order_relaxed);
+    snapshot.installedApiMask = installedApiMask.load(std::memory_order_relaxed);
+    snapshot.failedApiMask = failedApiMask.load(std::memory_order_relaxed);
+    return true;
+}
+// Large work space stays off the render-thread stack. It is prepared alongside
+// the ledger at hook installation and never retains a GPU pointer/reference.
+struct DetailWorkspace
+{
+    std::mutex mutex;
+    std::array<Ledger::LiveEntry, SlotCount> entries {};
+    std::array<Ledger::LiveEntry, SlotCount> previousGroups {};
+    size_t previousGroupCount = 0;
+    uint64_t previousCapturedMs = 0;
+    bool havePrevious = false;
+};
+inline DetailWorkspace* DetailWorkspaceInstance()
+{
+    static DetailWorkspace* const workspace = new (std::nothrow) DetailWorkspace;
+    return workspace;
+}
+inline bool PrepareDiagnostics()
+{
+    return Instance() != nullptr && DetailWorkspaceInstance() != nullptr;
+}
+inline bool TryReadDetailSnapshot(DetailSnapshot& result, uint64_t nowMs = MonotonicMilliseconds())
+{
+    result = {};
+    result.capturedMs = nowMs;
+    if (!ObservationEnabled()) return true;
+    SampledDiagnosticTimer timer(TimingStage::DetailSnapshot);
+    auto workspace = DetailWorkspaceInstance();
+    auto ledger = Instance();
+    if (workspace == nullptr || ledger == nullptr) return false;
+    std::unique_lock workspaceLock(workspace->mutex, std::try_to_lock);
+    if (!workspaceLock.owns_lock()) return false;
