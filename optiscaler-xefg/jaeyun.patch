+void XeFG_Dx12::SetCommandQueue(FG_ResourceType type, ID3D12CommandQueue* queue)
+{
+    auto work = AcquireWork();
+    if (!work)
+        return;
+    TrackLifetimeQueue(queue);
+    if (!ResTrack_Dx12::LifetimeObserversReady(nullptr, queue))
+    {
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::ObserverUnavailable);
+        return;
+    }
+    _gameCommandQueue = queue;
+}
+
+bool XeFG_Dx12::TrackPendingCommandList(ID3D12GraphicsCommandList* cmdList)
+{
+    if (!ResTrack_Dx12::LifetimeObserversReady(cmdList, _gameCommandQueue))
+    {
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::ObserverUnavailable);
+        return false; // No GPU commands or falsely unobservable pending entry.
+    }
+    ID3D12GraphicsCommandList* realList = nullptr;
+    if (!CheckForRealObject(__FUNCTION__, cmdList, (IUnknown**) &realList))
+        realList = cmdList;
+    std::lock_guard lock(_pendingCommandMutex);
+    for (size_t i = 0; i < _pendingCommandListCount; ++i)
+        if (_pendingCommandLists[i].identity == realList)
+            return true;
+    if (_pendingCommandListCount == MaxPendingCommandLists)
+    {
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::PendingUnsubmitted);
+        return false; // Reject before recording; existing tracking remains complete.
+    }
+    _pendingCommandLists[_pendingCommandListCount++] = {realList, ++_pendingGeneration, XeFGDiagnostics::WorkNowMs()};
+    ++_pendingStats.registered;
+    PublishPendingLocked();
     return true;
 }
 
