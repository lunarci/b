+void XeFG_Dx12::PreserveObjectsAfterFailedShutdown()
+{
+    // Destructors cannot report failure to their caller. Do not turn a failed
+    // drain/provider destroy into use-after-free through automatic destructors.
+    // This is an exceptional process-lifetime retention, not routine eviction.
+    if (!State::Instance().isShuttingDown)
+        LOG_ERROR("XeFG shutdown incomplete; retaining GPU-owned objects until process exit");
+    _preserveObjectsOnFailedShutdown = true;
+    _renderUI.release();
+    _hudlessCompare.release();
+    _mvFlip.release();
+    _depthFlip.release();
+    _depthInvert.release();
+}
