+void XeFG_Dx12::RecordCopyAllocation(int index, FG_ResourceType type, ID3D12Resource* previous)
+{
+    auto resource = _resourceCopy[index][type];
+    if (resource == previous || resource == nullptr)
+        return;
+    CopyAllocationInfo allocation;
+    const auto desc = resource->GetDesc();
+    if (_device != nullptr)
+    {
+        const auto info = _device->GetResourceAllocationInfo(0, 1, &desc);
+        allocation.known = info.SizeInBytes != UINT64_MAX;
+        allocation.bytes = allocation.known ? info.SizeInBytes : 0;
+    }
+    // Include the replacement overlap. These are allocation estimates and owned
+    // references, not current residency or proof of an immediate driver free.
+    _resourceDiagnostics.OnAllocate(allocation.bytes, allocation.known);
+    if (previous != nullptr)
+    {
+        const auto old = _copyAllocationInfo[index][type];
+        _resourceDiagnostics.OnRelease(old.bytes, old.known);
+    }
+    _copyAllocationInfo[index][type] = allocation;
+}
