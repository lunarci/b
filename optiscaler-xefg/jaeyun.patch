+uint64_t XeFG_Dx12::CapturePendingCommandListGeneration(const void* nativeIdentity)
+{
+    // Called from native Release. Never QI/dereference here: QI's temporary
+    // Release would re-enter this hook while the registry lock is held.
+    std::lock_guard lock(_pendingCommandMutex);
+    for (size_t i = 0; i < _pendingCommandListCount; ++i)
+        if (_pendingCommandLists[i].identity == nativeIdentity)
+            return _pendingCommandLists[i].generation;
+    return 0;
+}
+
+void XeFG_Dx12::RetirePendingCommandList(const void* nativeIdentity, uint64_t generation)
+{
+    if (generation == 0) return;
+    std::lock_guard lock(_pendingCommandMutex);
+    for (size_t i = 0; i < _pendingCommandListCount; ++i)
+        if (_pendingCommandLists[i].identity == nativeIdentity && _pendingCommandLists[i].generation == generation)
+        {
+            _pendingCommandLists[i] = _pendingCommandLists[--_pendingCommandListCount];
+            ++_pendingStats.destroyed;
+            PublishPendingLocked();
+            return;
+        }
+}
+
+void XeFG_Dx12::PublishPendingLocked()
+{
+    _pendingStats.current = _pendingCommandListCount;
+    _pendingStats.peak = (std::max)(_pendingStats.peak, static_cast<uint64_t>(_pendingCommandListCount));
+    _pendingStats.oldestObservedTickMs = 0;
+    for (size_t i = 0; i < _pendingCommandListCount; ++i)
+    {
+        const auto tick = _pendingCommandLists[i].firstSeenTickMs;
+        if (_pendingStats.oldestObservedTickMs == 0 || tick < _pendingStats.oldestObservedTickMs)
+            _pendingStats.oldestObservedTickMs = tick;
+    }
+    _workDiagnostics.PublishPendingSnapshot(_pendingStats);
+}
