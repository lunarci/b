+    if (!ledger->TryCopyLive(workspace->entries, count)) return false;
+    // The ledger lock is released before sorting/aggregation. Other reporters
+    // skip this snapshot rather than waiting for the work-space lock.
+    auto& entries = workspace->entries;
+    const auto sameKey = [](const Ledger::LiveEntry& a, const Ledger::LiveEntry& b)
+    {
+        return a.caller == b.caller && a.kind == b.kind && a.memory == b.memory &&
+               MetadataKey(a.metadata) == MetadataKey(b.metadata);
+    };
+    const auto keyLess = [](const auto& a, const auto& b)
+    {
+        return std::tie(a.caller, a.kind, a.memory) != std::tie(b.caller, b.kind, b.memory) ?
+               std::tie(a.caller, a.kind, a.memory) < std::tie(b.caller, b.kind, b.memory) :
+               MetadataKey(a.metadata) < MetadataKey(b.metadata);
+    };
+    std::sort(entries.begin(), entries.begin() + count, keyLess);
+    result.growthBaselineAvailable = workspace->havePrevious && nowMs >= workspace->previousCapturedMs;
+    if (result.growthBaselineAvailable)
+    {
+        result.growthBaselineCapturedMs = workspace->previousCapturedMs;
+        result.growthIntervalMs = nowMs - workspace->previousCapturedMs;
+    }
+    size_t compactedGroups = 0;
+    result.liveObjects = static_cast<uint32_t>(count);
+    for (size_t first = 0; first < count;)
+    {
+        GroupSnapshot group;
+        const auto& entry = entries[first];
+        group.caller = entry.caller; group.kind = entry.kind; group.memory = entry.memory;
+        group.metadata = entry.metadata;
+        group.metadata.createdMs = 0; // aggregate age fields below are authoritative
+        group.youngestAgeMs = std::numeric_limits<uint64_t>::max();
+        size_t end = first;
+        do
+        {
+            const auto& item = entries[end];
+            group.liveBytes += item.bytes;
+            ++group.liveCount;
+            const auto age = nowMs >= item.metadata.createdMs ? nowMs - item.metadata.createdMs : 0;
+            group.oldestAgeMs = std::max(group.oldestAgeMs, age);
+            group.youngestAgeMs = std::min(group.youngestAgeMs, age);
+            ++end;
+        } while (end < count && sameKey(entry, entries[end]));
+        result.observedBytes += group.liveBytes;
+        if (result.growthBaselineAvailable)
+        {
+            const auto previousEnd = workspace->previousGroups.begin() + workspace->previousGroupCount;
+            const auto previous = std::lower_bound(workspace->previousGroups.begin(), previousEnd, entry, keyLess);
+            const auto baselineBytes = previous != previousEnd && sameKey(*previous, entry) ? previous->bytes : 0;
+            if (group.liveBytes > baselineBytes)
+            {
+                GrowthGroupSnapshot growth { group, baselineBytes, group.liveBytes - baselineBytes };
+                size_t position = 0;
+                while (position < result.growthGroupCount &&
+                       result.growthGroups[position].growthBytes >= growth.growthBytes) ++position;
+                if (position < TopGroupCount)
+                {
+                    const auto last = std::min<size_t>(result.growthGroupCount, TopGroupCount - 1);
+                    for (size_t i = last; i > position; --i) result.growthGroups[i] = result.growthGroups[i - 1];
+                    result.growthGroups[position] = growth;
+                    if (result.growthGroupCount < TopGroupCount) ++result.growthGroupCount;
+                }
+            }
+        }
+        size_t position = 0;
+        while (position < result.groupCount &&
+               (result.groups[position].liveBytes > group.liveBytes ||
+                (result.groups[position].liveBytes == group.liveBytes &&
+                 result.groups[position].oldestAgeMs >= group.oldestAgeMs))) ++position;
+        if (position < TopGroupCount)
+        {
+            const auto last = std::min<size_t>(result.groupCount, TopGroupCount - 1);
+            for (size_t i = last; i > position; --i) result.groups[i] = result.groups[i - 1];
+            result.groups[position] = group;
+            if (result.groupCount < TopGroupCount) ++result.groupCount;
+        }
+        // Reuse the already-processed front of the entries array for compacted
+        // current groups. No unread entry is overwritten (compactedGroups <= first).
+        entries[compactedGroups++] = { group.caller, group.kind, group.memory, group.liveBytes, group.metadata };
+        first = end;
+    }
+    // Publish a new baseline only after a successful complete snapshot. A failed
+    // try-lock never shortens the next reported growth interval. This observes
+    // net live allocation changes; intervening churn and residency are unknown.
+    std::copy_n(entries.begin(), compactedGroups, workspace->previousGroups.begin());
+    workspace->previousGroupCount = compactedGroups;
+    workspace->previousCapturedMs = nowMs;
+    workspace->havePrevious = true;
+    return true;
+}
+
+}
diff --git a/OptiScaler/misc/LongSessionMonitor.h b/OptiScaler/misc/LongSessionMonitor.h
new file mode 100644
index 00000000..bd0d8de4
--- /dev/null
+++ b/OptiScaler/misc/LongSessionMonitor.h
@@ -0,0 +1,671 @@
+#pragma once
+
+#include "LongSessionState.h"
+#include "LongSessionTiming.h"
+#include "XeFGResourceDiagnostics.h"
+#include "XeFGWorkDiagnostics.h"
+#include "XeFGPresentDiagnostics.h"
+#include "GpuAllocationDiagnostics.h"
+#include "ResidencyDiagnostics.h"
+#include "XeFGProgressDiagnostics.h"
+#include "Logger.h"
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <format>
+#include <string>
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <psapi.h>
+
+// Observational only: never changes render resources, FG settings, residency,
+// frame pacing, or the driver's synchronization. All CPU timings are wall times.
+namespace LongSession
+{
+struct Sample
+{
+    std::uint64_t elapsedMs = 0;
+    std::uint64_t localUsage = 0;
+    std::uint64_t localBudget = 0;
+    std::uint64_t nonlocalUsage = 0;
+    std::uint64_t nonlocalBudget = 0;
+    std::uint64_t processPrivateBytes = 0;
+    std::uint64_t processWorkingSetBytes = 0;
+    std::uint64_t availablePhysicalBytes = 0;
+    std::uint64_t processCommitLimitBytes = 0;
+    std::uint64_t processAvailableCommitBytes = 0;
+    double presentMaxMs = 0.0;
+    double gapMaxMs = 0.0;
+    std::array<double, static_cast<unsigned>(WaitStage::Count)> waitMaxMs {};
+    std::array<std::uint64_t, static_cast<unsigned>(WaitStage::Count)> waitCalls {};
+    std::array<double, static_cast<unsigned>(WaitStage::Count)> waitSumMs {};
+    MemoryWindowSnapshot memoryWindow {};
+    CaptureEvent captureEvent = CaptureEvent::None;
+    std::uint64_t pressureEpoch = 0, pressureAgeMs = 0;
+    unsigned pressureRecoverySamples = 0;
+    Pressure pressure = Pressure::Normal;
+    bool localValid = false;
+    bool nonlocalValid = false;
+    bool processValid = false;
+    bool physicalValid = false;
+    bool hitch = false;
+};
+
+class Monitor
+{
+  public:
+    static Monitor& Instance()
+    {
+        static Monitor monitor;
+        return monitor;
+    }
+
+    // Both pointers are borrowed for this call. Only the adapter COM interface is retained.
+    // Pass a game-facing swapchain and the D3D12 device belonging to that swapchain.
+    void Observe(IDXGISwapChain* swapchain, ID3D12Device* device, double presentMs)
+    {
+        if (swapchain == nullptr || device == nullptr || !TryAcquireSRWLockExclusive(&_lock))
+            return;
+        LockRelease release { &_lock };
+
+        const auto now = Clock::now();
+        if (std::isfinite(presentMs) && presentMs > _windowPresentMaxMs)
+            _windowPresentMaxMs = presentMs;
+        if (_lastPresent != Clock::time_point {})
+        {
+            const double gap = std::chrono::duration<double, std::milli>(now - _lastPresent).count();
+            if (gap > _windowGapMaxMs)
+                _windowGapMaxMs = gap;
+        }
+        _lastPresent = now;
+
+        if (_lastSample != Clock::time_point {} && now - _lastSample < std::chrono::seconds(1))
+            return;
+        _lastSample = now;
+        const auto sampleCpuStarted = Clock::now();
+        EnsureAdapter(swapchain, device);
+
+        Sample sample {};
+        sample.elapsedMs = static_cast<std::uint64_t>(
+            std::chrono::duration_cast<std::chrono::milliseconds>(now - _started).count());
+        sample.presentMaxMs = _windowPresentMaxMs;
+        sample.gapMaxMs = _windowGapMaxMs;
+        _windowPresentMaxMs = 0.0;
+        _windowGapMaxMs = 0.0;
+
+        if (_adapter != nullptr)
+        {
+            DXGI_QUERY_VIDEO_MEMORY_INFO local {};
+            DXGI_QUERY_VIDEO_MEMORY_INFO nonlocal {};
+            sample.localValid = SUCCEEDED(_adapter->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &local));
+            sample.nonlocalValid = SUCCEEDED(_adapter->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, &nonlocal));
+            if (sample.localValid)
+            {
+                sample.localUsage = local.CurrentUsage;
+                sample.localBudget = local.Budget;
+            }
+            if (sample.nonlocalValid)
+            {
+                sample.nonlocalUsage = nonlocal.CurrentUsage;
+                sample.nonlocalBudget = nonlocal.Budget;
+            }
+        }
+
+        if (_getProcessMemoryInfo != nullptr)
+        {
+            PROCESS_MEMORY_COUNTERS_EX memory {};
+            memory.cb = sizeof(memory);
+            sample.processValid = _getProcessMemoryInfo(GetCurrentProcess(),
+                reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&memory), sizeof(memory)) != FALSE;
+            if (sample.processValid)
+            {
+                sample.processPrivateBytes = static_cast<std::uint64_t>(memory.PrivateUsage);
+                sample.processWorkingSetBytes = static_cast<std::uint64_t>(memory.WorkingSetSize);
+            }
+        }
+        MEMORYSTATUSEX physical {};
+        physical.dwLength = sizeof(physical);
+        sample.physicalValid = GlobalMemoryStatusEx(&physical) != FALSE;
+        if (sample.physicalValid)
+        {
+            sample.availablePhysicalBytes = physical.ullAvailPhys;
+            // MEMORYSTATUSEX reports the smaller system/process commit limit
+            // and the amount THIS process may commit; neither is free VRAM.
+            sample.processCommitLimitBytes = physical.ullTotalPageFile;
+            sample.processAvailableCommitBytes = physical.ullAvailPageFile;
+        }
+
+        const auto oldPressure = _pressure.Value();
+        sample.pressure = _pressure.Update(sample.localUsage, sample.localValid ? sample.localBudget : 0);
+        sample.hitch = _hitch.Update(sample.presentMaxMs, sample.gapMaxMs);
+        for (unsigned i = 0; i < sample.waitMaxMs.size(); ++i)
+        {
+            sample.waitMaxMs[i] = static_cast<double>(
+                WaitCounters()[i].maximumUs.exchange(0, std::memory_order_relaxed)) / 1000.0;
+            sample.waitCalls[i] = WaitCounters()[i].calls.exchange(0, std::memory_order_relaxed);
+            sample.waitSumMs[i] = static_cast<double>(
+                WaitCounters()[i].totalUs.exchange(0, std::memory_order_relaxed)) / 1000.0;
+        }
+        _memoryWindow.Observe(sample.elapsedMs, sample.localValid, sample.localUsage, sample.localBudget);
+        sample.captureEvent = _capture.Observe(sample.elapsedMs, sample.pressure, sample.hitch,
+                                               sample.waitMaxMs[static_cast<unsigned>(WaitStage::NativePresent)],
+                                               _memoryWindow.LatestObservedChange());
+        sample.pressureEpoch = _capture.Epoch();
+        sample.pressureAgeMs = _capture.PressureAgeMs(sample.elapsedMs);
+        sample.pressureRecoverySamples = _pressure.RecoverySamples();
+        _publishedPressure.store(sample.pressure, std::memory_order_relaxed);
+        _samples[_writeIndex] = sample;
+        _writeIndex = (_writeIndex + 1) % _samples.size();
+        if (sample.presentMaxMs > _logPresentMaxMs)
+            _logPresentMaxMs = sample.presentMaxMs;
+        if (sample.gapMaxMs > _logGapMaxMs)
+            _logGapMaxMs = sample.gapMaxMs;
+        for (unsigned i = 0; i < sample.waitMaxMs.size(); ++i)
+        {
+            if (sample.waitMaxMs[i] > _logWaitMaxMs[i])
+                _logWaitMaxMs[i] = sample.waitMaxMs[i];
+            _logWaitCalls[i] += sample.waitCalls[i];
+            _logWaitSumMs[i] += sample.waitSumMs[i];
+        }
+
+        const bool changed = sample.pressure != oldPressure || sample.hitch != _lastHitch;
+        _lastHitch = sample.hitch;
+        // Collection/state work is measured separately from formatting/enqueue.
+        // Counter snapshots are approximate at concurrent window boundaries.
+        RecordWait(WaitStage::DiagnosticSample,
+                   std::chrono::duration<double, std::milli>(Clock::now() - sampleCpuStarted).count());
+        if (sample.captureEvent != CaptureEvent::None)
+        {
+            Sample summary = sample;
+            summary.presentMaxMs = _logPresentMaxMs;
+            summary.gapMaxMs = _logGapMaxMs;
+            summary.waitMaxMs = _logWaitMaxMs;
+            summary.waitCalls = _logWaitCalls;
+            summary.waitSumMs = _logWaitSumMs;
+            summary.memoryWindow = _memoryWindow.Snapshot();
+            Log(summary, changed);
+            _logPresentMaxMs = 0.0;
+            _logGapMaxMs = 0.0;
+            _logWaitMaxMs = {};
+            _logWaitCalls = {};
+            _logWaitSumMs = {};
+            _memoryWindow.ResetWindow();
+        }
+    }
+
+    // Optional explicit teardown at a point where presentation has stopped.
+    // No waiting if another presentation is collecting a sample; the retained
+    // adapter is released on the next successful Reset or when this object dies.
+    void Reset()
+    {
+        if (!TryAcquireSRWLockExclusive(&_lock))
+            return;
+        LockRelease release { &_lock };
+        ReleaseAdapter();
+        _haveLuid = false;
+        _lastPresent = {};
+        _lastSample = {};
+        _pressure = {};
+        _hitch = {};
+        _lastHitch = false;
+        _windowPresentMaxMs = 0.0;
+        _windowGapMaxMs = 0.0;
+        _logPresentMaxMs = 0.0;
+        _logGapMaxMs = 0.0;
+        _logWaitMaxMs = {};
+        _logWaitCalls = {};
+        _logWaitSumMs = {};
+        _memoryWindow = {};
+        _capture = {};
+        _detailLogged = false;
+        _lastDetailLogMs = 0;
+        _publishedPressure.store(Pressure::Normal, std::memory_order_relaxed);
+    }
+
+    Pressure CurrentPressure() const { return _publishedPressure.load(std::memory_order_relaxed); }
+
+    ~Monitor() { ReleaseAdapter(); }
+
+  private:
+    struct LockRelease
+    {
+        SRWLOCK* lock;
+        ~LockRelease() { ReleaseSRWLockExclusive(lock); }
+    };
+
+    using GetProcessMemoryInfoFn = BOOL(WINAPI*)(HANDLE, PPROCESS_MEMORY_COUNTERS, DWORD);
+
+    Monitor()
+    {
+        // K32 export is already loaded; no LoadLibrary, background thread, or PSAPI link dependency.
+        const HMODULE kernel = GetModuleHandleW(L"kernel32.dll");
+        if (kernel != nullptr)
+            _getProcessMemoryInfo = reinterpret_cast<GetProcessMemoryInfoFn>(GetProcAddress(kernel, "K32GetProcessMemoryInfo"));
+    }
+
+    void ReleaseAdapter()
+    {
+        if (_adapter != nullptr)
+        {
+            _adapter->Release();
+            _adapter = nullptr;
+        }
+    }
+
+    void EnsureAdapter(IDXGISwapChain* swapchain, ID3D12Device* device)
+    {
+        const LUID luid = device->GetAdapterLuid();
+        if (_haveLuid && luid.LowPart == _adapterLuid.LowPart && luid.HighPart == _adapterLuid.HighPart)
+            return;
+        ReleaseAdapter();
+        _adapterLuid = luid;
+        _haveLuid = true;
+
+        IDXGIFactory4* factory = nullptr;
+        if (SUCCEEDED(swapchain->GetParent(IID_PPV_ARGS(&factory))) && factory != nullptr)
+        {
+            // Query the device's exact adapter; never assume adapter zero is the rendering GPU.
+            const HRESULT result = factory->EnumAdapterByLuid(luid, IID_PPV_ARGS(&_adapter));
+            if (FAILED(result))
+                ReleaseAdapter();
+            factory->Release();
+        }
+        else if (factory != nullptr)
+            factory->Release();
+        // Unsupported GetParent/adapter lookup disables budget sampling for this LUID.
+        // Do not retry COM discovery on every frame or add a second DXGI factory path.
+    }
+
+    bool BeginLogEntry()
+    {
+        if (!_logBudget.Take())
+            return false;
+        if (_logBudget.IsFinalEntry())
+        {
+            LOG_WARN("[LongSession] Log entry limit reached; bounded in-memory sampling continues.");
+            return false;
+        }
+        return true;
+    }
+
+    void Log(const Sample& sample, bool changed)
+    {
+        if (!BeginLogEntry()) return;
+        WaitScope logCpu(WaitStage::DiagnosticLog);
+        constexpr double mib = 1024.0 * 1024.0;
+        const auto ownedCopies = XeFGDiagnostics::GlobalSnapshot();
+        const auto observers = XeFGDiagnostics::ReadObserverSnapshot();
+        XeFGDiagnostics::WorkSnapshot work;
+        const bool workValid = XeFGDiagnostics::TryReadLatestWorkSnapshot(work);
+        const auto workNow = XeFGDiagnostics::WorkNowMs();
+        const bool ageKnown = workValid && work.pending.current != 0 && work.pending.oldestObservedTickMs != 0 &&
+                              workNow >= work.pending.oldestObservedTickMs;
+        const auto pendingAgeMs = ageKnown ? workNow - work.pending.oldestObservedTickMs : 0;
+        const auto snapshotAgeMs = workValid && workNow >= work.publishedTickMs ? workNow - work.publishedTickMs : 0;
+        const char* pressure = sample.pressure == Pressure::Critical ? "critical" :
+                               sample.pressure == Pressure::Elevated ? "elevated" : "normal";
+        // Memory fields are the latest reading. Time maxima cover ALL one-second
+        // samples since the preceding log, so intermediate slow calls are not lost.
+        // These are process budget/usage, not whole-board VRAM occupancy. A gap includes
+        // game work and scheduling; neither it nor a CPU API time measures GPU utilization.
+        // R3 uses the warning log level so routine existing trace/info traffic stays
+        // disabled. This explicitly tagged diagnostic is not a claim of a GPU fault.
+        const auto& memory = sample.memoryWindow;
+        const auto mean = [&](unsigned i) { return sample.waitCalls[i] ? sample.waitSumMs[i] / sample.waitCalls[i] : 0.0; };
+        LOG_WARN("[LongSession] t={}s changed={} pressure={} hitch={} "
+                 "capture={} pressure_epoch_age_ms={}/{} pressure_hysteresis_recovery_samples={} "
+                 "local_over_budget_now={} memory_scope=sampled_since_previous_log memory_samples={} "
+                 "memory_first_last_ms={}/{} local_observed_usage_min_max_MiB={:.1f}/{:.1f} "
+                 "local_observed_budget_min_max_MiB={:.1f}/{:.1f} "
+                 "local_largest_observed_increase_decrease_MiB={:.1f}/{:.1f} observed_delta_intervals_ms={}/{} "
+                 "local_valid={} local_MiB={:.1f}/{:.1f} nonlocal_valid={} nonlocal_MiB={:.1f}/{:.1f} "
+                 "private_valid={} private_MiB={:.1f} ram_valid={} available_ram_MiB={:.1f} "
+                 "process_working_set_MiB={:.1f} process_commit_limit_available_MiB={:.1f}/{:.1f} "
+                 "local_headroom_MiB={:.1f} timing_scope=since_previous_log "
+                 "present_max_ms={:.2f} gap_max_ms={:.2f} "
+                 "pacing_max_ms={:.2f} fence_max_ms={:.2f} tracking_max_ms={:.2f} fg_call_max_ms={:.2f} "
+                 "lifecycle_cpu_max_ms={:.2f} native_present_cpu_max_ms={:.2f} "
+                 "provider_status_cpu_max_ms={:.2f} provider_status_calls={} "
+                 "native_present_cpu_mean_sum_ms={:.2f}/{:.2f} cpu_mean_scope=approx_window zero_samples=unmeasured "
+                 "diagnostic_sample_cpu_max_mean_ms_calls={:.3f}/{:.3f}/{} "
+                 "diagnostic_log_cpu_max_mean_ms_calls={:.3f}/{:.3f}/{} "
+                 "gpu_progress_observer_cpu_max_mean_ms_calls={:.3f}/{:.3f}/{} "
+                 "tracked_release_cpu_scope=sample1of64_max_lower_bound "
+                 "release_mutex_probe_native_max_mean_ms_samples={:.3f}/{:.3f}/{}/{:.3f}/{:.3f}/{}/{:.3f}/{:.3f}/{} "
+                 "timing_calls_pacing_fence_tracking_fg_lifecycle_native={}/{}/{}/{}/{}/{} "
+                 "xefg_scope=owned_resourceCopy_global xefg_live_peak_copies={}/{} "
+                 "xefg_live_peak_alloc_est_MiB={:.2f}/{:.2f} xefg_unknown_size_copies={} "
+                 "xefg_alloc_release={}/{} xefg_cum_alloc_release_est_MiB={:.2f}/{:.2f} "
+                 "xefg_alloc_fail={} xefg_alias_preserved={} xefg_missing_depth_velocity_both={}/{}/{} "
+                 "xefg_missing_bursts_recovered_peak={}/{}/{} xefg_accounting_errors={} "
+                 "observer_ever_attempt_ok_fail_seen_masks={:X}/{:X}/{:X}/{:X} "
+                 "observer_calls_submit_reset_release={}/{}/{} "
+                 "work_scope=latest_published_context work_valid={} work_context={} work_snapshot_age_ms={} "
+                 "pending_current_peak={}/{} pending_registered_submitted_reset_destroyed={}/{}/{}/{} "
+                 "pending_age_known={} pending_oldest_observed_age_ms={} "
+                 "cleanup_state={} cleanup_reason={} cleanup_attempt_defer_complete_recover={}/{}/{}/{}",
+                 sample.elapsedMs / 1000, changed, pressure, sample.hitch,
+                 CaptureEventName(sample.captureEvent), sample.pressureEpoch, sample.pressureAgeMs,
+                 sample.pressureRecoverySamples, sample.localValid && sample.localBudget != 0 && sample.localUsage > sample.localBudget,
+                 memory.samples, memory.firstTickMs, memory.lastTickMs,
+                 memory.usageMin / mib, memory.usageMax / mib, memory.budgetMin / mib, memory.budgetMax / mib,
+                 memory.observedIncrease / mib, memory.observedDecrease / mib,
+                 memory.increaseIntervalMs, memory.decreaseIntervalMs,
+                 sample.localValid, sample.localUsage / mib, sample.localBudget / mib,
+                 sample.nonlocalValid, sample.nonlocalUsage / mib, sample.nonlocalBudget / mib,
+                 sample.processValid, sample.processPrivateBytes / mib,
+                 sample.physicalValid, sample.availablePhysicalBytes / mib,
+                 sample.processWorkingSetBytes / mib, sample.processCommitLimitBytes / mib,
+                 sample.processAvailableCommitBytes / mib,
+                 (static_cast<double>(sample.localBudget) - static_cast<double>(sample.localUsage)) / mib,
+                 sample.presentMaxMs, sample.gapMaxMs,
+                 sample.waitMaxMs[0], sample.waitMaxMs[1], sample.waitMaxMs[2], sample.waitMaxMs[3],
+                 sample.waitMaxMs[4], sample.waitMaxMs[5],
+                 sample.waitMaxMs[6], sample.waitCalls[6], mean(5), sample.waitSumMs[5],
+                 sample.waitMaxMs[7], mean(7), sample.waitCalls[7],
+                 sample.waitMaxMs[8], mean(8), sample.waitCalls[8],
+                 sample.waitMaxMs[9], mean(9), sample.waitCalls[9],
+                 sample.waitMaxMs[10], mean(10), sample.waitCalls[10],
+                 sample.waitMaxMs[11], mean(11), sample.waitCalls[11],
+                 sample.waitMaxMs[12], mean(12), sample.waitCalls[12],
+                 sample.waitCalls[0], sample.waitCalls[1], sample.waitCalls[2], sample.waitCalls[3],
+                 sample.waitCalls[4], sample.waitCalls[5],
+                 ownedCopies.liveCopies, ownedCopies.peakCopies,
+                 ownedCopies.liveBytes / mib, ownedCopies.peakBytes / mib, ownedCopies.unknownSizeCopies,
+                 ownedCopies.allocations, ownedCopies.releases,
+                 ownedCopies.allocatedBytes / mib, ownedCopies.releasedBytes / mib,
+                 ownedCopies.allocationFailures, ownedCopies.aliasPreserved,
+                 ownedCopies.missingDepthOnly, ownedCopies.missingVelocityOnly, ownedCopies.missingBoth,
+                 ownedCopies.missingBursts, ownedCopies.recoveredBursts, ownedCopies.peakMissingBurst,
+                 ownedCopies.accountingErrors,
+                 observers.attemptedMask, observers.installedMask, observers.failedMask, observers.observedMask,
+                 observers.callbacks[0], observers.callbacks[1], observers.callbacks[2],
+                 workValid, work.contextId, snapshotAgeMs, work.pending.current, work.pending.peak,
+                 work.pending.registered, work.pending.submitted, work.pending.resetDiscarded, work.pending.destroyed,
+                 ageKnown, pendingAgeMs, XeFGDiagnostics::CleanupStateName(work.state),
+                 XeFGDiagnostics::CleanupReasonName(work.reason),
+                 work.cleanupAttempts, work.cleanupDeferred, work.cleanupCompleted, work.cleanupRecovered);
+        LogProvider(sample.elapsedMs);
+        LogAllocations(sample.elapsedMs);
+        LogProgress(sample.elapsedMs);
+        const bool pressureTransition = sample.captureEvent >= CaptureEvent::PressureEnter &&
+                                        sample.captureEvent <= CaptureEvent::PressureNormalized;
+        if (!_detailLogged || pressureTransition || sample.elapsedMs < _lastDetailLogMs ||
+            sample.elapsedMs - _lastDetailLogMs >= 30000)
+        {
+            _detailLogged = true;
