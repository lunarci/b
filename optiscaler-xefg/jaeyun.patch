diff --git a/OptiScaler/misc/LongSessionMonitor.h b/OptiScaler/misc/LongSessionMonitor.h
new file mode 100644
index 0000000..e1497ed
--- /dev/null
+++ b/OptiScaler/misc/LongSessionMonitor.h
@@ -0,0 +1,312 @@
+#pragma once
+
+#include "LongSessionState.h"
+#include "LongSessionTiming.h"
+#include "Logger.h"
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <psapi.h>
+
+// Observational only: never changes render resources, FG settings, residency,
+// frame pacing, or the driver's synchronization. All CPU timings are wall times.
+namespace LongSession
+{
+struct Sample
+{
+    std::uint64_t elapsedMs = 0;
+    std::uint64_t localUsage = 0;
+    std::uint64_t localBudget = 0;
+    std::uint64_t nonlocalUsage = 0;
+    std::uint64_t nonlocalBudget = 0;
+    std::uint64_t processPrivateBytes = 0;
+    std::uint64_t availablePhysicalBytes = 0;
+    double presentMaxMs = 0.0;
+    double gapMaxMs = 0.0;
+    std::array<double, static_cast<unsigned>(WaitStage::Count)> waitMaxMs {};
+    Pressure pressure = Pressure::Normal;
+    bool localValid = false;
+    bool nonlocalValid = false;
+    bool processValid = false;
+    bool physicalValid = false;
+    bool hitch = false;
+};
+
+class Monitor
+{
+  public:
+    static Monitor& Instance()
+    {
+        static Monitor monitor;
+        return monitor;
+    }
+
+    // Both pointers are borrowed for this call. Only the adapter COM interface is retained.
+    // Pass a game-facing swapchain and the D3D12 device belonging to that swapchain.
+    void Observe(IDXGISwapChain* swapchain, ID3D12Device* device, double presentMs)
+    {
+        if (swapchain == nullptr || device == nullptr || !TryAcquireSRWLockExclusive(&_lock))
+            return;
+        LockRelease release { &_lock };
+
+        const auto now = Clock::now();
+        if (std::isfinite(presentMs) && presentMs > _windowPresentMaxMs)
+            _windowPresentMaxMs = presentMs;
+        if (_lastPresent != Clock::time_point {})
+        {
+            const double gap = std::chrono::duration<double, std::milli>(now - _lastPresent).count();
+            if (gap > _windowGapMaxMs)
+                _windowGapMaxMs = gap;
+        }
+        _lastPresent = now;
+
+        if (_lastSample != Clock::time_point {} && now - _lastSample < std::chrono::seconds(1))
+            return;
+        _lastSample = now;
+        EnsureAdapter(swapchain, device);
+
+        Sample sample {};
+        sample.elapsedMs = static_cast<std::uint64_t>(
+            std::chrono::duration_cast<std::chrono::milliseconds>(now - _started).count());
+        sample.presentMaxMs = _windowPresentMaxMs;
+        sample.gapMaxMs = _windowGapMaxMs;
+        _windowPresentMaxMs = 0.0;
+        _windowGapMaxMs = 0.0;
+
+        if (_adapter != nullptr)
+        {
+            DXGI_QUERY_VIDEO_MEMORY_INFO local {};
+            DXGI_QUERY_VIDEO_MEMORY_INFO nonlocal {};
+            sample.localValid = SUCCEEDED(_adapter->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_LOCAL, &local));
+            sample.nonlocalValid = SUCCEEDED(_adapter->QueryVideoMemoryInfo(0, DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL, &nonlocal));
+            if (sample.localValid)
+            {
+                sample.localUsage = local.CurrentUsage;
+                sample.localBudget = local.Budget;
+            }
+            if (sample.nonlocalValid)
+            {
+                sample.nonlocalUsage = nonlocal.CurrentUsage;
+                sample.nonlocalBudget = nonlocal.Budget;
+            }
+        }
+
+        if (_getProcessMemoryInfo != nullptr)
+        {
+            PROCESS_MEMORY_COUNTERS_EX memory {};
+            memory.cb = sizeof(memory);
+            sample.processValid = _getProcessMemoryInfo(GetCurrentProcess(),
+                reinterpret_cast<PROCESS_MEMORY_COUNTERS*>(&memory), sizeof(memory)) != FALSE;
+            if (sample.processValid)
+                sample.processPrivateBytes = static_cast<std::uint64_t>(memory.PrivateUsage);
+        }
+        MEMORYSTATUSEX physical {};
+        physical.dwLength = sizeof(physical);
+        sample.physicalValid = GlobalMemoryStatusEx(&physical) != FALSE;
+        if (sample.physicalValid)
+            sample.availablePhysicalBytes = physical.ullAvailPhys;
+
+        const auto oldPressure = _pressure.Value();
+        sample.pressure = _pressure.Update(sample.localUsage, sample.localValid ? sample.localBudget : 0);
+        sample.hitch = _hitch.Update(sample.presentMaxMs, sample.gapMaxMs);
+        for (unsigned i = 0; i < sample.waitMaxMs.size(); ++i)
+            sample.waitMaxMs[i] = static_cast<double>(
+                WaitCounters()[i].maximumUs.exchange(0, std::memory_order_relaxed)) / 1000.0;
+        _publishedPressure.store(sample.pressure, std::memory_order_relaxed);
+        _samples[_writeIndex] = sample;
+        _writeIndex = (_writeIndex + 1) % _samples.size();
+        if (sample.presentMaxMs > _logPresentMaxMs)
+            _logPresentMaxMs = sample.presentMaxMs;
+        if (sample.gapMaxMs > _logGapMaxMs)
+            _logGapMaxMs = sample.gapMaxMs;
+        for (unsigned i = 0; i < sample.waitMaxMs.size(); ++i)
+            if (sample.waitMaxMs[i] > _logWaitMaxMs[i])
+                _logWaitMaxMs[i] = sample.waitMaxMs[i];
+
+        const bool changed = sample.pressure != oldPressure || sample.hitch != _lastHitch;
+        _lastHitch = sample.hitch;
+        if (changed || _lastLog == Clock::time_point {} || now - _lastLog >= std::chrono::seconds(30))
+        {
+            Sample summary = sample;
+            summary.presentMaxMs = _logPresentMaxMs;
+            summary.gapMaxMs = _logGapMaxMs;
+            summary.waitMaxMs = _logWaitMaxMs;
+            _lastLog = now;
+            Log(summary, changed);
+            _logPresentMaxMs = 0.0;
+            _logGapMaxMs = 0.0;
+            _logWaitMaxMs = {};
+        }
+    }
+
+    // Optional explicit teardown at a point where presentation has stopped.
+    // No waiting if another presentation is collecting a sample; the retained
+    // adapter is released on the next successful Reset or when this object dies.
+    void Reset()
+    {
+        if (!TryAcquireSRWLockExclusive(&_lock))
+            return;
+        LockRelease release { &_lock };
+        ReleaseAdapter();
+        _haveLuid = false;
+        _lastPresent = {};
+        _lastSample = {};
+        _pressure = {};
+        _hitch = {};
+        _lastHitch = false;
+        _windowPresentMaxMs = 0.0;
+        _windowGapMaxMs = 0.0;
+        _logPresentMaxMs = 0.0;
+        _logGapMaxMs = 0.0;
+        _logWaitMaxMs = {};
+        _publishedPressure.store(Pressure::Normal, std::memory_order_relaxed);
+    }
+
+    Pressure CurrentPressure() const { return _publishedPressure.load(std::memory_order_relaxed); }
+
+    ~Monitor() { ReleaseAdapter(); }
+
+  private:
+    struct LockRelease
+    {
+        SRWLOCK* lock;
+        ~LockRelease() { ReleaseSRWLockExclusive(lock); }
+    };
+
+    using GetProcessMemoryInfoFn = BOOL(WINAPI*)(HANDLE, PPROCESS_MEMORY_COUNTERS, DWORD);
+
+    Monitor()
+    {
+        // K32 export is already loaded; no LoadLibrary, background thread, or PSAPI link dependency.
+        const HMODULE kernel = GetModuleHandleW(L"kernel32.dll");
+        if (kernel != nullptr)
+            _getProcessMemoryInfo = reinterpret_cast<GetProcessMemoryInfoFn>(GetProcAddress(kernel, "K32GetProcessMemoryInfo"));
+    }
+
+    void ReleaseAdapter()
+    {
+        if (_adapter != nullptr)
+        {
+            _adapter->Release();
+            _adapter = nullptr;
+        }
+    }
+
+    void EnsureAdapter(IDXGISwapChain* swapchain, ID3D12Device* device)
+    {
+        const LUID luid = device->GetAdapterLuid();
+        if (_haveLuid && luid.LowPart == _adapterLuid.LowPart && luid.HighPart == _adapterLuid.HighPart)
+            return;
+        ReleaseAdapter();
+        _adapterLuid = luid;
+        _haveLuid = true;
+
+        IDXGIFactory4* factory = nullptr;
+        if (SUCCEEDED(swapchain->GetParent(IID_PPV_ARGS(&factory))) && factory != nullptr)
+        {
+            // Query the device's exact adapter; never assume adapter zero is the rendering GPU.
+            const HRESULT result = factory->EnumAdapterByLuid(luid, IID_PPV_ARGS(&_adapter));
+            if (FAILED(result))
+                ReleaseAdapter();
+            factory->Release();
+        }
+        else if (factory != nullptr)
+            factory->Release();
+        // Unsupported GetParent/adapter lookup disables budget sampling for this LUID.
+        // Do not retry COM discovery on every frame or add a second DXGI factory path.
+    }
+
+    void Log(const Sample& sample, bool changed)
+    {
+        if (!_logBudget.Take())
+            return;
+        if (_logBudget.IsFinalEntry())
+        {
+            LOG_WARN("[LongSession] Log entry limit reached; bounded in-memory sampling continues.");
+            return;
+        }
+        constexpr double mib = 1024.0 * 1024.0;
+        const char* pressure = sample.pressure == Pressure::Critical ? "critical" :
+                               sample.pressure == Pressure::Elevated ? "elevated" : "normal";
+        // Memory fields are the latest reading. Time maxima cover ALL one-second
+        // samples since the preceding log, so intermediate slow calls are not lost.
+        // These are process budget/usage, not whole-board VRAM occupancy. A gap includes
+        // game work and scheduling; neither it nor a CPU API time measures GPU utilization.
+        // R3 uses the warning log level so routine existing trace/info traffic stays
