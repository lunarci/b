 #include <menu/menu_overlay_dx.h>
 #include <resource_tracking/ResTrack_dx12.h>
@@ -26,6 +28,93 @@ static int GameRequestedInterpolationCount()
     return StreamlineHooks::GameRequestedInterpolationCount();
 }
 
+void XeFG_Dx12::LogCapacityRequirements(const xefg_swapchain_d3d12_init_params_t& params,
+                                        uint32_t width, uint32_t height, DXGI_FORMAT format)
+{
+    // Queries describe SDK heap requirements, not measured resident VRAM. Run
+    // only at initialization; no allocation or resource release is requested.
+    const auto query = XeFGProxy::D3D12GetProperties();
+    if (query == nullptr)
+        return;
+#ifndef DONT_USE_XMX
+    ScopedSkipSpoofingGlobal skipSpoofingGlobal {};
+#endif
+    for (const uint32_t count : { 2u, 3u, 5u })
+    {
+        if (count > static_cast<uint32_t>(_maxInterpolationCount))
+            continue;
+        auto candidate = params;
+        candidate.maxInterpolatedFrames = count;
+        xefg_swapchain_properties_t props {};
+        const auto result = query(_swapChainContext, &candidate, width, height, format, &props);
+        LOG_INFO("[XeFGCapacity] heap_query requested={}X result={} buffer={} texture={} constants={} "
+                 "scope=sdk_requirements_not_resident_vram",
+                 count + 1, static_cast<int32_t>(result), props.tempBufferHeapSize,
+                 props.tempTextureHeapSize, props.constantBufferSize);
+    }
+}
+
+void XeFG_Dx12::RecordInitializedCapacity(const xefg_swapchain_d3d12_init_params_t& params)
+{
+    int capacity = static_cast<int>(params.maxInterpolatedFrames);
+    bool readbackValid = false;
+    int32_t readbackResult = 0;
+#ifndef DONT_USE_XMX
+    ScopedSkipSpoofingGlobal skipSpoofingGlobal {};
+#endif
+    if (const auto readback = XeFGProxy::D3D12GetInitializationParameters(); readback != nullptr)
+    {
+        xefg_swapchain_d3d12_init_params_t actual {};
+        const auto result = readback(_swapChainContext, &actual);
+        readbackResult = static_cast<int32_t>(result);
+        if (result == XEFG_SWAPCHAIN_RESULT_SUCCESS && actual.maxInterpolatedFrames >= 1 &&
+            actual.maxInterpolatedFrames <= static_cast<uint32_t>(_maxInterpolationCount))
+        {
+            capacity = static_cast<int>(actual.maxInterpolatedFrames);
+            readbackValid = true;
+        }
+    }
+    _initializedInterpolationCapacity.store(capacity, std::memory_order_release);
+    _lastCapacityRequest = -1;
+    auto* config = Config::Instance();
+    XeFGDiagnostics::RecordInterpolationCapacity(static_cast<uint32_t>(capacity),
+        config->FGXeFGInterpolationCount.value_or_default(), config->FGXeFGInterpolationCount.has_value());
+    // Old SDKs use the initialized count directly; dynamic SDKs report an
+    // applied count after the first successful SetNumInterpolatedFrames call.
+    if (XeFGProxy::SetNumInterpolatedFrames() == nullptr)
+    {
+        _framesToInterpolate = capacity;
+        XeFGDiagnostics::RecordInterpolationActive(static_cast<uint32_t>(capacity));
+    }
+    else
