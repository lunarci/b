diff --git a/OptiScaler/proxies/FfxContextRegistry.h b/OptiScaler/proxies/FfxContextRegistry.h
new file mode 100644
index 00000000..371f4d34
--- /dev/null
+++ b/OptiScaler/proxies/FfxContextRegistry.h
@@ -0,0 +1,43 @@
+#pragma once
+
+#include <mutex>
+
+// Old upscaler contexts are destroyed on detached workers while new contexts
+// can be created on the render thread. Copy routing metadata under a short lock;
+// callers must invoke the external provider only after these methods return.
+template <typename Map> class FfxContextRegistry
+{
+    Map _types;
+    mutable std::mutex _mutex;
+
+  public:
+    using Key = typename Map::key_type;
+    using Type = typename Map::mapped_type;
+
+    void Set(const Key& context, Type type)
+    {
+        std::lock_guard lock(_mutex);
+        _types[context] = type;
+    }
+
+    bool Find(const Key& context, Type& type) const
+    {
+        std::lock_guard lock(_mutex);
+        const auto found = _types.find(context);
+        if (found == _types.end())
+            return false;
+        type = found->second;
+        return true;
+    }
+
+    bool Take(const Key& context, Type& type)
+    {
+        std::lock_guard lock(_mutex);
+        const auto found = _types.find(context);
+        if (found == _types.end())
+            return false;
+        type = found->second;
+        _types.erase(context);
+        return true;
+    }
+};
