diff --git a/OptiScaler/proxies/XeFGPacingGuard.h b/OptiScaler/proxies/XeFGPacingGuard.h
new file mode 100644
index 00000000..5eb61d41
--- /dev/null
+++ b/OptiScaler/proxies/XeFGPacingGuard.h
@@ -0,0 +1,92 @@
+#pragma once
+
+#include <cstdint>
+#include <limits>
+
+// Pure policy used by the present-thread watchdog. None of these decisions
+// authorizes skipping a GPU fence, reusing an allocator, or freeing a resource.
+namespace XeFGPacingGuard
+{
+constexpr int64_t HitchFloorNs = 250000000LL;
+constexpr int64_t HitchRatio = 8;
+constexpr int32_t MinimumSamples = 3;
+
+inline bool Add(int64_t a, int64_t b, int64_t& out)
+{
+    if (a < 0 || b < 0 || a > (std::numeric_limits<int64_t>::max)() - b)
+        return false;
+    out = a + b;
+    return true;
+}
+
+inline bool Multiply(int64_t a, int64_t b, int64_t& out)
+{
+    if (a < 0 || b < 0 || (b != 0 && a > (std::numeric_limits<int64_t>::max)() / b))
+        return false;
+    out = a * b;
+    return true;
+}
+
+inline int64_t Scale(int64_t value, int64_t numerator, int64_t denominator)
+{
+    if (value <= 0 || numerator <= 0 || denominator <= 0)
+        return 0;
+    // The former value*numerator overflowed before division. Check the
+    // floating conversion's boundary before casting (also on MSVC, where
+    // long double has double precision).
+    const long double scaled = static_cast<long double>(value) * numerator / denominator;
+    if (scaled >= static_cast<long double>((std::numeric_limits<int64_t>::max)()))
+        return (std::numeric_limits<int64_t>::max)();
+    return static_cast<int64_t>(scaled);
+}
+
+inline bool Discontinuous(int64_t period, int64_t reference, int32_t samples)
+{
+    if (period <= 0 || reference <= 0 || samples < MinimumSamples)
+        return false;
+    const int64_t shorter = period < reference ? period : reference;
+    const int64_t longer = period > reference ? period : reference;
+    // Division avoids overflow in ratio*shorter. Both a large ratio and
+    // a substantial interval are required. Stable low FPS remains valid.
+    return longer > HitchFloorNs && shorter <= (longer - 1) / HitchRatio;
+}
+
+inline int64_t WaitBudget(int64_t period)
+{
+    int64_t doubled = 0;
+    int64_t result = 0;
+    if (period <= 0)
+        return 0;
+    if (!Multiply(period, 2, doubled) || !Add(doubled, HitchFloorNs, result))
+        return (std::numeric_limits<int64_t>::max)();
+    return result;
+}
+
+enum class WaitDecision { Continue, Complete, Abort };
+
+inline WaitDecision CheckWait(uint64_t expectedEpoch, uint64_t actualEpoch, int64_t start,
+                              int64_t now, int64_t target, int64_t budget)
+{
+    if (expectedEpoch != actualEpoch || start < 0 || now < start || target < 0 || budget <= 0)
+        return WaitDecision::Abort;
+    if (now >= target)
+        return WaitDecision::Complete;
+    if (target - now > budget || now - start >= budget)
+        return WaitDecision::Abort;
+    return WaitDecision::Continue;
+}
+
+inline bool FirstDeadline(int64_t native, int64_t unit, int64_t nativeUnit, uint32_t index, int64_t& out)
+{
+    if (unit <= 0 || nativeUnit < 0 || nativeUnit > unit || index < 1 || index > 5)
+        return false;
+    int64_t correction = 0;
+    return Multiply(unit - nativeUnit, index, correction) && Add(native, correction, out);
+}
+
+inline void Increment(uint32_t& value)
+{
+    if (value != (std::numeric_limits<uint32_t>::max)())
+        ++value;
+}
+} // namespace XeFGPacingGuard
