+            if (_gameCommandQueue == nullptr || _device == nullptr)
+                return false;
+            if (_uiSlotFences[i] == nullptr &&
+                FAILED(_device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&_uiSlotFences[i]))))
+                return false;
+            // UI reserves its next fence value when recording begins. Satisfy
+            // that value by a real queue marker before discarding the recording.
+            if (FAILED(_gameCommandQueue->Signal(_uiSlotFences[i], _uiAllocatorFenceValues[i])))
+                return false;
+            const auto result = _uiCommandList[i]->Close();
+            _uiCommandListResetted[i] = false;
+            if (FAILED(result))
+                LOG_WARN("Discarded invalid UI recording, slot {}, result {:X}", i, (UINT) result);
+        }
+        if (_scCommandListResetted[i])
+        {
+            const auto result = _scCommandList[i]->Close();
+            _scCommandListResetted[i] = false;
+            // SC values are assigned only at submission. Leave the last real
+            // fence value unchanged; GetSCCommandList checks it before Reset.
+            if (FAILED(result))
+                LOG_WARN("Discarded invalid SC recording, slot {}, result {:X}", i, (UINT) result);
+        }
+    }
+    return true;
+}
