diff --git a/OptiScaler/framegen/IFGFeature_Reset.h b/OptiScaler/framegen/IFGFeature_Reset.h
new file mode 100644
index 00000000..8bee2d98
--- /dev/null
+++ b/OptiScaler/framegen/IFGFeature_Reset.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+
+// A reset survives paused frames and failed dispatches. Only the dispatch that
+// observed a request may acknowledge it; a newer request must remain pending.
+class FGHistoryResetLatch
+{
+    std::atomic<bool> _pending { false };
+    mutable std::mutex _mutex;
+    uint64_t _generation = 0;
+    uint64_t _requestFrame = 0;
+
+  public:
+    void Request(uint64_t frame)
+    {
+        std::lock_guard lock(_mutex);
+        ++_generation;
+        _requestFrame = frame;
+        _pending.store(true, std::memory_order_release);
+    }
+
+    uint64_t PendingToken(uint64_t dispatchFrame) const
+    {
+        if (!_pending.load(std::memory_order_acquire))
+            return 0;
+
+        std::lock_guard lock(_mutex);
+        if (!_pending.load(std::memory_order_relaxed) || dispatchFrame < _requestFrame)
+            return 0;
+
+        return _generation;
+    }
+
+    void RebasePending(uint64_t frame)
+    {
+        if (!_pending.load(std::memory_order_acquire))
+            return;
+
+        std::lock_guard lock(_mutex);
+        if (_pending.load(std::memory_order_relaxed) && _requestFrame > frame)
+        {
+            // Incoming frame IDs can restart. Preserve an existing request in
+            // the new frame domain without letting an old dispatch clear it.
+            ++_generation;
+            _requestFrame = frame;
+        }
+    }
+
+    void Acknowledge(uint64_t token)
+    {
+        if (token == 0)
+            return;
+
+        std::lock_guard lock(_mutex);
+        if (token == _generation)
+            _pending.store(false, std::memory_order_release);
+    }
+};
diff --git a/OptiScaler/framegen/xefg/XeFGCapacityPolicy.h b/OptiScaler/framegen/xefg/XeFGCapacityPolicy.h
new file mode 100644
index 00000000..c422e116
--- /dev/null
+++ b/OptiScaler/framegen/xefg/XeFGCapacityPolicy.h
@@ -0,0 +1,24 @@
+#pragma once
+
+// Counts are interpolated frames: two means 3X, three means 4X.
+// Keep device support separate from the capacity of an existing SDK context.
+namespace XeFGCapacity
+{
+constexpr int SelectInitialCapacity(int supported, int requested, bool explicitRequest,
+                                    bool dynamicApi, bool lowMemory)
+{
+    if (supported < 1)
+        supported = 1;
+    if (!dynamicApi)
+        return requested >= 1 && requested <= supported ? requested : 1;
+    // Auto can receive a higher game request after swapchain initialization.
+    if (!lowMemory || !explicitRequest || requested < 1 || requested > 3)
+        return supported;
+    return supported < 3 ? supported : 3;
+}
+
+constexpr bool CanApply(int requested, int capacity)
+{
+    return requested >= 1 && capacity >= 1 && requested <= capacity;
+}
+}
diff --git a/OptiScaler/framegen/xefg/XeFGRecovery.h b/OptiScaler/framegen/xefg/XeFGRecovery.h
new file mode 100644
index 00000000..d416cd50
--- /dev/null
+++ b/OptiScaler/framegen/xefg/XeFGRecovery.h
@@ -0,0 +1,246 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <cstdint>
+#include <mutex>
+
+// Recovery never owns graphics resources. Each trial must gather new SDK tags
+// after a successful enable, and only its own native Present can confirm it.
+class XeFGRecovery
+{
+  public:
+    enum class Phase { Healthy, NeedDisable, Backoff, Enabling, Trial, Stopped };
+    static constexpr uint32_t Depth = 1u << 0;
+    static constexpr uint32_t Velocity = 1u << 1;
+    static constexpr uint32_t Hudless = 1u << 2;
+    static constexpr uint32_t Constants = 1u << 5;
+
+  private:
+    mutable std::mutex _mutex;
+    Phase _phase = Phase::Healthy;
+    uint64_t _generation = 1;
+    uint64_t _failedFrame = 0;
+    uint64_t _retryAt = 0;
+    uint64_t _trialStart = 0;
+    uint64_t _dispatchToken = 0;
+    bool _coherentToken = false;
+    uint64_t _tokenSequence = 0;
+    struct FrameEvidence
+    {
+        uint64_t frame = (std::numeric_limits<uint64_t>::max)();
+        uint32_t accepted = 0;
+        uint32_t required = Depth | Velocity | Constants;
+    };
+    std::array<FrameEvidence, 4> _frames {};
+    unsigned _failures = 0;
+    unsigned _disabledStatuses = 0;
+    bool _disableInFlight = false;
+    uint64_t _disableOwner = 0;
+    bool _terminal = false;
+
+    uint64_t RetryDelay() const { return (std::min)(uint64_t(1000), uint64_t(32) << (std::min)(_failures, 5u)); }
+    FrameEvidence* Evidence(uint64_t frame)
+    {
+        auto& evidence = _frames[frame % _frames.size()];
+        if (evidence.frame != frame)
+        {
+            if (evidence.frame != (std::numeric_limits<uint64_t>::max)() && evidence.frame > frame)
+                return nullptr; // A stale call must not overwrite a newer ring slot.
+            evidence = { frame, 0, Depth | Velocity | Constants };
+        }
+        return &evidence;
+    }
+    const FrameEvidence* Find(uint64_t frame) const
+    {
+        const auto& evidence = _frames[frame % _frames.size()];
+        return evidence.frame == frame ? &evidence : nullptr;
+    }
+    void ClearEvidence(bool keepConstants = false)
+    {
+        for (auto& evidence : _frames)
+            if (keepConstants)
+            {
+                evidence.accepted &= Constants;
+                evidence.required = Depth | Velocity | Constants;
+            }
+            else evidence = {};
+    }
+
+  public:
+    void Reset()
+    {
+        std::lock_guard lock(_mutex);
+        _phase = Phase::Healthy;
+        ++_generation;
+        _failedFrame = _retryAt = _trialStart = _dispatchToken = 0;
+        ClearEvidence();
+        _failures = _disabledStatuses = 0;
+        _disableInFlight = false;
+        _disableOwner = 0;
+        _terminal = false;
+    }
+    void Rebase(uint64_t frame, uint64_t now)
+    {
+        std::lock_guard lock(_mutex);
+        ++_generation;
+        _failedFrame = frame;
+        _trialStart = _dispatchToken = 0;
+        ClearEvidence();
+        _disabledStatuses = 0;
+        if (_phase != Phase::Healthy && _phase != Phase::Stopped)
+        {
+            _phase = Phase::NeedDisable;
+            _retryAt = now;
+        }
+    }
+    void PreparePresent() { std::lock_guard lock(_mutex); _dispatchToken = 0; }
+    bool Recovering() const { std::lock_guard lock(_mutex); return _phase != Phase::Healthy; }
+    bool RequiresNewContext() const { std::lock_guard lock(_mutex); return _terminal; }
+    Phase State() const { std::lock_guard lock(_mutex); return _phase; }
+    bool Fault(uint64_t frame, uint64_t now, bool terminal = false)
+    {
+        std::lock_guard lock(_mutex);
+        if (_phase == Phase::NeedDisable || _phase == Phase::Backoff || _phase == Phase::Stopped)
+            return false;
+        _terminal = terminal;
+        _phase = Phase::NeedDisable;
+        ++_generation;
+        _failedFrame = frame;
+        ++_failures;
+        _retryAt = now;
+        _dispatchToken = 0;
+        ClearEvidence(true);
+        _disabledStatuses = 0;
+        return true;
+    }
+    uint64_t DisableTicket(uint64_t now)
+    {
+        std::lock_guard lock(_mutex);
+        if (_phase != Phase::NeedDisable || _disableInFlight || now < _retryAt) return 0;
+        _disableInFlight = true;
+        _disableOwner = _generation;
+        return _generation;
+    }
+    void Disabled(uint64_t ticket, bool success, uint64_t now, bool terminal = false)
+    {
+        std::lock_guard lock(_mutex);
+        if (ticket == _disableOwner) { _disableInFlight = false; _disableOwner = 0; }
+        if (ticket != _generation || _phase != Phase::NeedDisable) return;
+        _retryAt = now + RetryDelay();
+        _terminal = _terminal || terminal;
+        if (_terminal) _phase = Phase::Stopped;
+        else if (success) _phase = Phase::Backoff;
+    }
+    uint64_t BeginTrial(uint64_t frame, uint64_t now)
+    {
+        std::lock_guard lock(_mutex);
+        if (_phase != Phase::Backoff || now < _retryAt || frame <= _failedFrame) return 0;
+        _phase = Phase::Enabling;
+        _trialStart = frame;
+        ClearEvidence(true); // Metadata stays local; SDK resource tags must be new.
+        _dispatchToken = 0;
+        return ++_generation;
+    }
+    void Enabled(uint64_t ticket, bool success, uint64_t now, bool terminal = false)
+    {
+        std::lock_guard lock(_mutex);
+        if (ticket != _generation || _phase != Phase::Enabling) return;
+        _terminal = _terminal || terminal;
+        _phase = _terminal ? Phase::Stopped : (success ? Phase::Trial : Phase::Backoff);
+        if (!success)
+        {
+            ++_failures;
+            _retryAt = now + RetryDelay();
+        }
+    }
+    bool AllowsInput(uint64_t frame) const
+    {
+        std::lock_guard lock(_mutex);
+        return _phase == Phase::Healthy || (_phase == Phase::Trial && frame >= _trialStart && frame > _failedFrame);
+    }
+    void ConstantsReady(uint64_t frame)
+    {
+        std::lock_guard lock(_mutex);
+        if (auto evidence = Evidence(frame)) evidence->accepted |= Constants;
+    }
+    void Observe(uint64_t frame, uint32_t bit)
+    {
+        std::lock_guard lock(_mutex);
+        if (_phase != Phase::Trial || frame < _trialStart || frame <= _failedFrame) return;
+        if (auto evidence = Evidence(frame); evidence != nullptr && bit == Hudless)
+            evidence->required |= Hudless;
+    }
+    void Accepted(uint64_t frame, uint32_t bit)
+    {
+        std::lock_guard lock(_mutex);
+        if (_phase != Phase::Trial || frame < _trialStart || frame <= _failedFrame) return;
+        if (auto evidence = Evidence(frame)) evidence->accepted |= bit;
+    }
+    void Incomplete(uint64_t frame, uint32_t bit)
+    {
+        std::lock_guard lock(_mutex);
+        if (_phase == Phase::Trial)
+            if (auto evidence = Evidence(frame))
+            {
+                evidence->accepted &= ~bit;
+                _dispatchToken = 0;
+            }
+    }
+    bool Ready(uint64_t frame, bool includeHudless) const
+    {
+        std::lock_guard lock(_mutex);
+        if (_phase == Phase::Healthy) return true;
+        const auto evidence = Find(frame);
+        if (_phase != Phase::Trial || evidence == nullptr || frame < _trialStart || frame <= _failedFrame)
+            return false;
+        const auto required = includeHudless ? evidence->required : (Depth | Velocity | Constants);
+        return (evidence->accepted & required) == required;
+    }
+    void Dispatched(uint64_t frame)
+    {
+        std::lock_guard lock(_mutex);
+        const auto evidence = Find(frame);
+        if (_phase == Phase::Healthy ||
+            (_phase == Phase::Trial && evidence != nullptr && frame >= _trialStart && frame > _failedFrame &&
+             (evidence->accepted & evidence->required) == evidence->required))
+        {
+            _dispatchToken = ++_tokenSequence;
+            _coherentToken = true;
+        }
+    }
+    uint64_t PresentToken(bool expectedEnabled = false)
+    {
+        std::lock_guard lock(_mutex);
+        if (_dispatchToken == 0 && expectedEnabled && (_phase == Phase::Healthy || _phase == Phase::Trial))
+        {
+            _dispatchToken = ++_tokenSequence;
+            _coherentToken = false; // May detect a fault, never prove a recovered frame.
+        }
+        return _dispatchToken;
+    }
+    // 1 = coherent trial confirmed; -1 = confirmed provider divergence/error.
+    // Warnings, missing status and zero generated frames never cause toggles.
+    int Presented(uint64_t token, bool nativeOk, int32_t queryResult, uint32_t frames, int32_t result, bool enabled)
+    {
+        std::lock_guard lock(_mutex);
+        if (token == 0 || token != _dispatchToken ||
+            (_phase != Phase::Trial && _phase != Phase::Healthy)) return 0;
+        const bool coherent = _coherentToken;
+        _dispatchToken = 0;
+        _coherentToken = false;
+        if (!nativeOk || queryResult != 0) return 0;
+        if (result < 0 && coherent) return -1;
+        if (!enabled)
+            return ++_disabledStatuses >= 2 ? -1 : 0;
+        _disabledStatuses = 0;
+        // A skipped/incomplete dispatch can legitimately report missing input
+        // or call-order errors. Observation-only tokens cannot fault on those.
+        if (!coherent || result != 0 || frames <= 1) return 0;
+        const bool wasTrial = _phase == Phase::Trial;
+        _phase = Phase::Healthy;
+        _failures = 0;
+        return wasTrial ? 1 : 0;
+    }
+};
