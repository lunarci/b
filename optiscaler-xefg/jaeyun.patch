+                 XeFGDiagnostics::CleanupReasonName(work.reason),
+                 work.cleanupAttempts, work.cleanupDeferred, work.cleanupCompleted, work.cleanupRecovered);
+    }
+
+    SRWLOCK _lock = SRWLOCK_INIT;
+    IDXGIAdapter3* _adapter = nullptr;
+    LUID _adapterLuid {};
+    bool _haveLuid = false;
+    GetProcessMemoryInfoFn _getProcessMemoryInfo = nullptr;
+    Clock::time_point _started = Clock::now();
+    Clock::time_point _lastSample {};
+    Clock::time_point _lastPresent {};
+    Clock::time_point _lastLog {};
+    double _windowPresentMaxMs = 0.0;
+    double _windowGapMaxMs = 0.0;
+    double _logPresentMaxMs = 0.0;
+    double _logGapMaxMs = 0.0;
+    std::array<double, static_cast<unsigned>(WaitStage::Count)> _logWaitMaxMs {};
+    std::array<std::uint64_t, static_cast<unsigned>(WaitStage::Count)> _logWaitCalls {};
+    bool _lastHitch = false;
+    PressureState _pressure;
+    HitchState _hitch;
+    LogBudget _logBudget;
+    std::atomic<Pressure> _publishedPressure { Pressure::Normal };
+    std::array<Sample, 60> _samples {};
+    std::size_t _writeIndex = 0;
+};
+
+// Put one scope around an original game Present/Present1 call. Nested calls on
+// the same thread are intentionally ignored; do not instrument generated frames.
+class PresentScope
+{
+  public:
+    PresentScope(IDXGISwapChain* swapchain, ID3D12Device* device) :
+        _swapchain(swapchain), _device(device), _outermost(Depth()++ == 0)
+    {
+        if (_outermost)
+            _start = Clock::now();
+    }
+
+    ~PresentScope()
+    {
+        --Depth();
+        if (_outermost)
+            Monitor::Instance().Observe(_swapchain, _device,
+                std::chrono::duration<double, std::milli>(Clock::now() - _start).count());
+    }
+
+    PresentScope(const PresentScope&) = delete;
+    PresentScope& operator=(const PresentScope&) = delete;
+
+  private:
+    static unsigned& Depth()
+    {
+        static thread_local unsigned depth = 0;
+        return depth;
+    }
+    IDXGISwapChain* _swapchain;
+    ID3D12Device* _device;
+    bool _outermost;
+    Clock::time_point _start {};
+};
+} // namespace LongSession
diff --git a/OptiScaler/misc/LongSessionState.h b/OptiScaler/misc/LongSessionState.h
new file mode 100644
index 00000000..7c79aa8d
--- /dev/null
+++ b/OptiScaler/misc/LongSessionState.h
@@ -0,0 +1,105 @@
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+
+// No Windows types here: the state transitions can be tested without a GPU.
+namespace LongSession
+{
+enum class Pressure : unsigned char
+{
+    Normal,
+    Elevated,
+    Critical
+};
+
+class PressureState
+{
+  public:
+    Pressure Update(std::uint64_t usage, std::uint64_t budget)
+    {
+        // An unavailable/zero budget is not evidence that pressure has recovered.
+        if (budget == 0)
+        {
+            _recoverySamples = 0;
+            return _value;
+        }
+
+        const double fraction = static_cast<double>(usage) / static_cast<double>(budget);
+        if (fraction >= 0.95)
+        {
+            _value = Pressure::Critical;
+            _recoverySamples = 0;
+        }
+        else if (_value == Pressure::Normal && fraction >= 0.90)
+        {
+            _value = Pressure::Elevated;
+            _recoverySamples = 0;
+        }
+        else
+        {
+            const bool canRecover = (_value == Pressure::Critical && fraction < 0.90) ||
+                                    (_value == Pressure::Elevated && fraction < 0.85);
+            if (canRecover && ++_recoverySamples >= 3)
+            {
+                _value = fraction < 0.85 ? Pressure::Normal : Pressure::Elevated;
+                _recoverySamples = 0;
+            }
+            else if (!canRecover)
+                _recoverySamples = 0;
+        }
+        return _value;
+    }
+
+    Pressure Value() const { return _value; }
+
+  private:
+    Pressure _value = Pressure::Normal;
+    unsigned _recoverySamples = 0;
+};
+
+class HitchState
+{
+  public:
+    bool Update(double presentMaxMs, double gapMaxMs)
+    {
+        const bool bad = (std::isfinite(presentMaxMs) && presentMaxMs >= 250.0) ||
+                         (std::isfinite(gapMaxMs) && gapMaxMs >= 500.0);
+        if (bad)
+        {
+            _active = true;
+            _recoverySamples = 0;
+        }
+        else if (_active && ++_recoverySamples >= 3)
+        {
+            _active = false;
+            _recoverySamples = 0;
+        }
+        return _active;
+    }
+
+  private:
+    bool _active = false;
+    unsigned _recoverySamples = 0;
+};
+
+// Limit this feature's contribution to the existing log, including its final cap message.
+class LogBudget
+{
+  public:
+    static constexpr unsigned MaximumEntries = 1024;
+
+    bool Take()
+    {
+        if (_entries >= MaximumEntries)
+            return false;
+        ++_entries;
+        return true;
+    }
+
+    bool IsFinalEntry() const { return _entries == MaximumEntries; }
+
+  private:
+    unsigned _entries = 0;
+};
+} // namespace LongSession
diff --git a/OptiScaler/misc/LongSessionTiming.h b/OptiScaler/misc/LongSessionTiming.h
new file mode 100644
index 00000000..35022c67
--- /dev/null
+++ b/OptiScaler/misc/LongSessionTiming.h
@@ -0,0 +1,72 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdint>
+
+// Small, platform-neutral CPU timing counters. No logger, graphics API, or waits.
+namespace LongSession
+{
+using Clock = std::chrono::steady_clock;
+
+enum class WaitStage : unsigned char
+{
+    Pacing,
+    GpuFence,
+    ResourceTracking,
+    FrameGeneration,
+    Lifecycle,
+    NativePresent,
+    Count
+};
+
+struct WaitCounter
+{
+    std::atomic<std::uint64_t> maximumUs { 0 };
+    std::atomic<std::uint64_t> calls { 0 };
+};
+
+inline std::array<WaitCounter, static_cast<unsigned>(WaitStage::Count)>& WaitCounters()
+{
+    static std::array<WaitCounter, static_cast<unsigned>(WaitStage::Count)> counters {};
+    return counters;
+}
+
+inline void RecordWait(WaitStage stage, double milliseconds)
+{
+    const auto index = static_cast<unsigned>(stage);
+    if (index >= static_cast<unsigned>(WaitStage::Count) || !std::isfinite(milliseconds) || milliseconds < 0.0)
+        return;
+
+    WaitCounters()[index].calls.fetch_add(1, std::memory_order_relaxed);
+
+    // Saturate before converting to an integer. A 24-hour stall is ample range.
+    constexpr double maximumMs = 86400000.0;
+    const auto us = static_cast<std::uint64_t>((milliseconds < maximumMs ? milliseconds : maximumMs) * 1000.0);
+    auto& maximum = WaitCounters()[index].maximumUs;
+    auto old = maximum.load(std::memory_order_relaxed);
+    // Diagnostic contention must not extend a render critical section.
+    for (unsigned attempt = 0; attempt < 4 && old < us; ++attempt)
+        if (maximum.compare_exchange_weak(old, us, std::memory_order_relaxed))
+            break;
+}
+
+class WaitScope
+{
+  public:
+    explicit WaitScope(WaitStage stage) : _stage(stage), _start(Clock::now()) {}
+    ~WaitScope()
+    {
+        RecordWait(_stage, std::chrono::duration<double, std::milli>(Clock::now() - _start).count());
+    }
+    WaitScope(const WaitScope&) = delete;
+    WaitScope& operator=(const WaitScope&) = delete;
+
+  private:
+    WaitStage _stage;
+    Clock::time_point _start;
+};
+
+} // namespace LongSession
diff --git a/OptiScaler/misc/XeFGResourceDiagnostics.h b/OptiScaler/misc/XeFGResourceDiagnostics.h
new file mode 100644
index 00000000..db2479ae
--- /dev/null
+++ b/OptiScaler/misc/XeFGResourceDiagnostics.h
@@ -0,0 +1,347 @@
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <limits>
+
+// Observational accounting for XeFG_Dx12::_resourceCopy only. These are owned
+// references and D3D12 allocation-size estimates, NOT resident VRAM readings.
+// Game resources, shader-helper buffers and Intel's internal allocations are excluded.
+// No Windows, logger, graphics API, dynamic allocation, or synchronization waits.
+namespace XeFGDiagnostics
+{
+struct Snapshot
+{
+    std::uint64_t liveCopies = 0;
+    std::uint64_t peakCopies = 0;
+    std::uint64_t liveBytes = 0;
+    std::uint64_t peakBytes = 0;
+    std::uint64_t unknownSizeCopies = 0;
+    std::uint64_t allocations = 0;
+    std::uint64_t releases = 0;
+    std::uint64_t allocatedBytes = 0;
+    std::uint64_t releasedBytes = 0;
+    std::uint64_t allocationFailures = 0;
+    std::uint64_t aliasPreserved = 0;
+    std::uint64_t missingDepthOnly = 0;
+    std::uint64_t missingVelocityOnly = 0;
+    std::uint64_t missingBoth = 0;
+    std::uint64_t missingFrames = 0;
+    std::uint64_t missingBursts = 0;
+    std::uint64_t recoveredBursts = 0;
+    std::uint64_t currentMissingBurst = 0;
+    std::uint64_t peakMissingBurst = 0;
+    std::uint64_t accountingErrors = 0;
+};
+
+namespace Detail
+{
+inline void RaisePeak(std::atomic<std::uint64_t>& peak, std::uint64_t value)
+{
+    auto previous = peak.load(std::memory_order_relaxed);
+    while (previous < value &&
+           !peak.compare_exchange_weak(previous, value, std::memory_order_relaxed))
+    {
+    }
+}
+
+class Counters
+{
+  public:
+    void Allocate(std::uint64_t bytes, bool known)
+    {
+        const auto copies = _liveCopies.fetch_add(1, std::memory_order_relaxed) + 1;
+        RaisePeak(_peakCopies, copies);
+        _allocations.fetch_add(1, std::memory_order_relaxed);
+        if (known)
+        {
+            const auto total = _liveBytes.fetch_add(bytes, std::memory_order_relaxed) + bytes;
+            RaisePeak(_peakBytes, total);
+            _allocatedBytes.fetch_add(bytes, std::memory_order_relaxed);
+        }
+        else
+            _unknownSizeCopies.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    bool Release(std::uint64_t bytes, bool known)
+    {
+        // Defensive accounting guard only; it never changes a resource lifetime.
+        if (!Subtract(_liveCopies, 1))
+        {
+            _accountingErrors.fetch_add(1, std::memory_order_relaxed);
+            return false;
+        }
+        _releases.fetch_add(1, std::memory_order_relaxed);
+        if (known)
+        {
+            if (Subtract(_liveBytes, bytes))
+                _releasedBytes.fetch_add(bytes, std::memory_order_relaxed);
+            else
+                _accountingErrors.fetch_add(1, std::memory_order_relaxed);
+        }
+        else if (!Subtract(_unknownSizeCopies, 1))
+            _accountingErrors.fetch_add(1, std::memory_order_relaxed);
+        return true;
+    }
+
+    void AllocationFailure() { _allocationFailures.fetch_add(1, std::memory_order_relaxed); }
+    void AliasPreserved() { _aliasPreserved.fetch_add(1, std::memory_order_relaxed); }
+    void AccountingError() { _accountingErrors.fetch_add(1, std::memory_order_relaxed); }
+
+    void Missing(bool depth, bool velocity)
+    {
+        _missingFrames.fetch_add(1, std::memory_order_relaxed);
+        if (depth && velocity)
+            _missingBoth.fetch_add(1, std::memory_order_relaxed);
+        else if (depth)
+            _missingDepthOnly.fetch_add(1, std::memory_order_relaxed);
+        else if (velocity)
+            _missingVelocityOnly.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    std::uint64_t ExtendBurst()
+    {
+        const auto count = _currentMissingBurst.fetch_add(1, std::memory_order_relaxed) + 1;
+        RaisePeak(_peakMissingBurst, count);
+        if (count == 1)
+            _missingBursts.fetch_add(1, std::memory_order_relaxed);
+        return count;
+    }
+
+    void RecordContextBurst(std::uint64_t count)
+    {
+        // Global longest burst is the longest single-context burst, not a mixture
+        // of unrelated contexts. The global currentMissingBurst stays zero.
+        RaisePeak(_peakMissingBurst, count);
+        if (count == 1)
+            _missingBursts.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    bool EndBurst()
+    {
+        if (_currentMissingBurst.exchange(0, std::memory_order_relaxed) == 0)
+            return false;
+        _recoveredBursts.fetch_add(1, std::memory_order_relaxed);
+        return true;
+    }
+
+    void RecordContextRecovery() { _recoveredBursts.fetch_add(1, std::memory_order_relaxed); }
+
+    Snapshot Read() const
+    {
+        // Individual atomic readings can straddle a concurrent allocation/release.
+        // No lock is held and no transactionally consistent snapshot is claimed.
+        Snapshot result;
+        result.liveCopies = _liveCopies.load(std::memory_order_relaxed);
+        result.peakCopies = _peakCopies.load(std::memory_order_relaxed);
+        result.liveBytes = _liveBytes.load(std::memory_order_relaxed);
+        result.peakBytes = _peakBytes.load(std::memory_order_relaxed);
+        result.unknownSizeCopies = _unknownSizeCopies.load(std::memory_order_relaxed);
+        result.allocations = _allocations.load(std::memory_order_relaxed);
+        result.releases = _releases.load(std::memory_order_relaxed);
+        result.allocatedBytes = _allocatedBytes.load(std::memory_order_relaxed);
+        result.releasedBytes = _releasedBytes.load(std::memory_order_relaxed);
+        result.allocationFailures = _allocationFailures.load(std::memory_order_relaxed);
+        result.aliasPreserved = _aliasPreserved.load(std::memory_order_relaxed);
+        result.missingDepthOnly = _missingDepthOnly.load(std::memory_order_relaxed);
+        result.missingVelocityOnly = _missingVelocityOnly.load(std::memory_order_relaxed);
+        result.missingBoth = _missingBoth.load(std::memory_order_relaxed);
+        result.missingFrames = _missingFrames.load(std::memory_order_relaxed);
+        result.missingBursts = _missingBursts.load(std::memory_order_relaxed);
+        result.recoveredBursts = _recoveredBursts.load(std::memory_order_relaxed);
+        result.currentMissingBurst = _currentMissingBurst.load(std::memory_order_relaxed);
+        result.peakMissingBurst = _peakMissingBurst.load(std::memory_order_relaxed);
+        result.accountingErrors = _accountingErrors.load(std::memory_order_relaxed);
+        return result;
+    }
+
+    // BeginContext is called only at a serialized provider-context lifecycle
+    // boundary. Retain live owned copies, which are not freed by a counter reset.
+    Snapshot ResetContext()
+    {
+        const auto start = Read();
+        _peakCopies.store(start.liveCopies, std::memory_order_relaxed);
+        _peakBytes.store(start.liveBytes, std::memory_order_relaxed);
+        _allocations.store(0, std::memory_order_relaxed);
+        _releases.store(0, std::memory_order_relaxed);
+        _allocatedBytes.store(0, std::memory_order_relaxed);
+        _releasedBytes.store(0, std::memory_order_relaxed);
+        _allocationFailures.store(0, std::memory_order_relaxed);
+        _aliasPreserved.store(0, std::memory_order_relaxed);
+        _missingDepthOnly.store(0, std::memory_order_relaxed);
+        _missingVelocityOnly.store(0, std::memory_order_relaxed);
+        _missingBoth.store(0, std::memory_order_relaxed);
+        _missingFrames.store(0, std::memory_order_relaxed);
+        _missingBursts.store(0, std::memory_order_relaxed);
+        _recoveredBursts.store(0, std::memory_order_relaxed);
+        _currentMissingBurst.store(0, std::memory_order_relaxed);
+        _peakMissingBurst.store(0, std::memory_order_relaxed);
+        _accountingErrors.store(0, std::memory_order_relaxed);
+        return start;
+    }
+
+  private:
+    static bool Subtract(std::atomic<std::uint64_t>& counter, std::uint64_t amount)
+    {
+        auto previous = counter.load(std::memory_order_relaxed);
+        while (previous >= amount)
+            if (counter.compare_exchange_weak(previous, previous - amount, std::memory_order_relaxed))
+                return true;
+        return false;
+    }
+
+    std::atomic<std::uint64_t> _liveCopies { 0 }, _peakCopies { 0 }, _liveBytes { 0 }, _peakBytes { 0 };
+    std::atomic<std::uint64_t> _unknownSizeCopies { 0 }, _allocations { 0 }, _releases { 0 };
+    std::atomic<std::uint64_t> _allocatedBytes { 0 }, _releasedBytes { 0 }, _allocationFailures { 0 };
+    std::atomic<std::uint64_t> _aliasPreserved { 0 }, _missingDepthOnly { 0 }, _missingVelocityOnly { 0 };
+    std::atomic<std::uint64_t> _missingBoth { 0 }, _missingFrames { 0 }, _missingBursts { 0 };
+    std::atomic<std::uint64_t> _recoveredBursts { 0 }, _currentMissingBurst { 0 }, _peakMissingBurst { 0 };
+    std::atomic<std::uint64_t> _accountingErrors { 0 };
+};
+
+inline Counters& GlobalCounters()
+{
+    static Counters counters;
+    return counters;
+}
+
+inline std::uint64_t NextContextId()
+{
+    static std::atomic<std::uint64_t> generation { 0 };
+    return generation.fetch_add(1, std::memory_order_relaxed) + 1;
+}
+
+inline bool TakeGlobalLogEntry()
+{
+    static std::atomic<unsigned> entries { 0 };
+    auto previous = entries.load(std::memory_order_relaxed);
+    while (previous < 1024)
+        if (entries.compare_exchange_weak(previous, previous + 1, std::memory_order_relaxed))
+            return true;
+    return false;
+}
+} // namespace Detail
+
+inline Snapshot GlobalSnapshot() { return Detail::GlobalCounters().Read(); }
+
+// Pure clock-driven gate: first report, then at most once per five seconds for
+// a new burst/recovery/failure, otherwise once per 30 seconds. No per-frame log.
+class ReportGate
+{
+  public:
+    bool Take(std::uint64_t nowMs, bool changed)
+    {
+        constexpr auto unset = (std::numeric_limits<std::uint64_t>::max)();
+        auto previous = _lastMs.load(std::memory_order_relaxed);
+        if (previous != unset &&
+            (nowMs < previous || nowMs - previous < (changed ? 5000ULL : 30000ULL)))
+            return false;
+        return _lastMs.compare_exchange_strong(previous, nowMs, std::memory_order_relaxed);
+    }
+
+  private:
+    std::atomic<std::uint64_t> _lastMs { (std::numeric_limits<std::uint64_t>::max)() };
+};
+
+struct Report
+{
+    std::uint64_t contextId = 0;
+    std::uint64_t startLiveCopies = 0;
+    std::uint64_t startLiveBytes = 0;
+    std::uint64_t startUnknownSizeCopies = 0;
+    Snapshot counters;
+};
+
+class Context
+{
+  public:
+    void BeginContext()
+    {
+        const auto start = _counters.ResetContext();
+        _startLiveCopies.store(start.liveCopies, std::memory_order_relaxed);
+        _startLiveBytes.store(start.liveBytes, std::memory_order_relaxed);
+        _startUnknownSizeCopies.store(start.unknownSizeCopies, std::memory_order_relaxed);
+        _contextId.store(Detail::NextContextId(), std::memory_order_relaxed);
+        _revision.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    void OnAllocate(std::uint64_t allocationEstimateBytes, bool sizeKnown = true)
+    {
+        _counters.Allocate(allocationEstimateBytes, sizeKnown);
+        Detail::GlobalCounters().Allocate(allocationEstimateBytes, sizeKnown);
+    }
+
+    void OnRelease(std::uint64_t allocationEstimateBytes, bool sizeKnown = true)
+    {
+        if (_counters.Release(allocationEstimateBytes, sizeKnown))
+            Detail::GlobalCounters().Release(allocationEstimateBytes, sizeKnown);
+        else
+            Detail::GlobalCounters().AccountingError();
+    }
+
+    void OnAllocationFailure()
+    {
+        _counters.AllocationFailure();
+        Detail::GlobalCounters().AllocationFailure();
+        _revision.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    void OnAliasPreserved()
+    {
+        _counters.AliasPreserved();
+        Detail::GlobalCounters().AliasPreserved();
+    }
+
+    void OnMissingInputs(bool depthMissing, bool velocityMissing)
+    {
+        if (!depthMissing && !velocityMissing)
+            return;
+        _counters.Missing(depthMissing, velocityMissing);
+        Detail::GlobalCounters().Missing(depthMissing, velocityMissing);
+        const auto count = _counters.ExtendBurst();
+        Detail::GlobalCounters().RecordContextBurst(count);
+        if (count == 1)
+            _revision.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    void OnInputsReady()
+    {
+        if (_counters.EndBurst())
+        {
+            Detail::GlobalCounters().RecordContextRecovery();
+            _revision.fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+
+    Report Read() const
+    {
+        Report report;
+        report.contextId = _contextId.load(std::memory_order_relaxed);
+        report.startLiveCopies = _startLiveCopies.load(std::memory_order_relaxed);
+        report.startLiveBytes = _startLiveBytes.load(std::memory_order_relaxed);
+        report.startUnknownSizeCopies = _startUnknownSizeCopies.load(std::memory_order_relaxed);
+        report.counters = _counters.Read();
+        return report;
+    }
+
+    bool TryReport(std::uint64_t nowMs, Report& report)
+    {
+        const auto revision = _revision.load(std::memory_order_relaxed);
+        const bool changed = revision != _reportedRevision.load(std::memory_order_relaxed);
+        if (!_gate.Take(nowMs, changed) || !Detail::TakeGlobalLogEntry())
+            return false;
+        _reportedRevision.store(revision, std::memory_order_relaxed);
+        report = Read();
+        return true;
+    }
+
+    // Deliberately no destructor decrement: destroying an owner is not evidence
+    // that an undrained or deliberately retained GPU allocation was released.
+
+  private:
+    Detail::Counters _counters;
+    ReportGate _gate;
+    std::atomic<std::uint64_t> _contextId { 0 }, _startLiveCopies { 0 }, _startLiveBytes { 0 };
+    std::atomic<std::uint64_t> _startUnknownSizeCopies { 0 }, _revision { 0 }, _reportedRevision { 0 };
+};
+} // namespace XeFGDiagnostics
diff --git a/OptiScaler/misc/XeFGWorkDiagnostics.h b/OptiScaler/misc/XeFGWorkDiagnostics.h
new file mode 100644
index 00000000..8df886a7
--- /dev/null
+++ b/OptiScaler/misc/XeFGWorkDiagnostics.h
@@ -0,0 +1,295 @@
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+// Observation only. No resource lifetime decisions, age-based expiry, waits,
+// dynamic containers, or logger dependencies. All ages use WorkNowMs().
+namespace XeFGDiagnostics
+{
+inline std::uint64_t WorkNowMs()
+{
+    return static_cast<std::uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+
+enum class LifetimeObserver : unsigned
+{
+    CommandSubmission = 1u,
+    CommandReset = 2u,
+    CommandRelease = 4u
+};
+
+struct ObserverSnapshot
+{
+    // Cumulative observations in this process, not proof that every native
+    // implementation currently has coverage. Readiness remains the hook owner's
+    // decision. A Release callback counts entry, not final destruction.
+    unsigned attemptedMask = 0;
+    unsigned installedMask = 0;
+    unsigned failedMask = 0;
+    unsigned observedMask = 0;
+    std::array<std::uint64_t, 3> callbacks {};
+};
+
+namespace WorkDetail
+{
+struct ObserverCounters
+{
+    std::atomic<unsigned> attempted { 0 }, installed { 0 }, failed { 0 }, observed { 0 };
+    std::array<std::atomic<std::uint64_t>, 3> callbacks {};
+};
+
+inline ObserverCounters& Observers()
+{
+    static ObserverCounters counters;
+    return counters;
+}
+
+inline unsigned ObserverIndex(LifetimeObserver observer)
+{
+    switch (observer)
+    {
+    case LifetimeObserver::CommandSubmission: return 0;
+    case LifetimeObserver::CommandReset: return 1;
+    case LifetimeObserver::CommandRelease: return 2;
+    default: return 3;
+    }
+}
+} // namespace WorkDetail
+
+inline void RecordObserverInstallation(LifetimeObserver observer, bool success)
+{
+    if (WorkDetail::ObserverIndex(observer) >= 3)
+        return;
+    const auto bit = static_cast<unsigned>(observer);
+    auto& counters = WorkDetail::Observers();
+    counters.attempted.fetch_or(bit, std::memory_order_relaxed);
+    (success ? counters.installed : counters.failed).fetch_or(bit, std::memory_order_relaxed);
+}
+
+inline void RecordObserverCallback(LifetimeObserver observer)
+{
+    const auto index = WorkDetail::ObserverIndex(observer);
+    if (index >= 3)
+        return;
+    auto& counters = WorkDetail::Observers();
+    counters.observed.fetch_or(static_cast<unsigned>(observer), std::memory_order_relaxed);
+    counters.callbacks[index].fetch_add(1, std::memory_order_relaxed);
+}
+
+inline ObserverSnapshot ReadObserverSnapshot()
+{
+    auto& counters = WorkDetail::Observers();
+    ObserverSnapshot snapshot;
+    snapshot.attemptedMask = counters.attempted.load(std::memory_order_relaxed);
+    snapshot.installedMask = counters.installed.load(std::memory_order_relaxed);
+    snapshot.failedMask = counters.failed.load(std::memory_order_relaxed);
+    snapshot.observedMask = counters.observed.load(std::memory_order_relaxed);
+    for (unsigned i = 0; i < snapshot.callbacks.size(); ++i)
+        snapshot.callbacks[i] = counters.callbacks[i].load(std::memory_order_relaxed);
+    return snapshot;
+}
+
+enum class CleanupReason : unsigned char
+{
+    None,
+    CpuBusy,
+    ObserverUnavailable,
+    PendingUnsubmitted,
+    GpuIncomplete,
+    ProviderDisableFailed
+};
+
+enum class CleanupState : unsigned char
+{
+    Running,
+    Attempting,
+    Deferred,
+    Recovered
+};
+
+inline const char* CleanupReasonName(CleanupReason reason)
+{
+    switch (reason)
+    {
+    case CleanupReason::None: return "none";
+    case CleanupReason::CpuBusy: return "cpu_busy";
+    case CleanupReason::ObserverUnavailable: return "observer_unavailable";
+    case CleanupReason::PendingUnsubmitted: return "pending_unsubmitted";
+    case CleanupReason::GpuIncomplete: return "gpu_incomplete";
+    case CleanupReason::ProviderDisableFailed: return "provider_disable_failed";
+    default: return "unknown";
+    }
+}
+
+inline const char* CleanupStateName(CleanupState state)
+{
+    switch (state)
+    {
+    case CleanupState::Running: return "running";
+    case CleanupState::Attempting: return "attempting";
+    case CleanupState::Deferred: return "deferred";
+    case CleanupState::Recovered: return "recovered";
+    default: return "unknown";
+    }
+}
+
+struct PendingSnapshot
+{
+    std::uint64_t current = 0;
+    std::uint64_t peak = 0;
+    std::uint64_t registered = 0;
+    std::uint64_t submitted = 0;
+    std::uint64_t resetDiscarded = 0;
+    std::uint64_t destroyed = 0;
+    // 0 means unknown. This must describe an actual observed pending record,
+    // not the age of a nonempty registry containing continually changing work.
+    std::uint64_t oldestObservedTickMs = 0;
+};
+
+struct WorkSnapshot
+{
+    std::uint64_t contextId = 0;
+    std::uint64_t publishedTickMs = 0;
+    PendingSnapshot pending;
+    std::uint64_t cleanupAttempts = 0;
+    std::uint64_t cleanupDeferred = 0;
+    std::uint64_t cleanupCompleted = 0;
+    std::uint64_t cleanupRecovered = 0;
+    CleanupState state = CleanupState::Running;
+    CleanupReason reason = CleanupReason::None;
+};
+
+namespace WorkDetail
+{
+struct LatestWork
+{
+    std::atomic_flag guard = ATOMIC_FLAG_INIT;
+    WorkSnapshot snapshot;
+    bool hasData = false;
+};
+
+inline LatestWork& Latest()
+{
+    static LatestWork latest;
+    return latest;
+}
+
+inline void PublishLatest(const WorkSnapshot& snapshot)
+{
+    auto& latest = Latest();
+    // Best-effort diagnostic publication: contention never waits on rendering.
+    if (latest.guard.test_and_set(std::memory_order_acquire))
+        return;
+    latest.snapshot = snapshot;
+    latest.hasData = true;
+    latest.guard.clear(std::memory_order_release);
+}
+} // namespace WorkDetail
+
+inline bool TryReadLatestWorkSnapshot(WorkSnapshot& snapshot)
+{
+    auto& latest = WorkDetail::Latest();
+    if (latest.guard.test_and_set(std::memory_order_acquire))
+        return false;
+    const bool valid = latest.hasData;
+    if (valid)
+        snapshot = latest.snapshot;
+    latest.guard.clear(std::memory_order_release);
+    return valid;
+}
+
+class WorkDiagnostics
+{
+  public:
+    // Lifecycle boundary, serialized by the owner. Pending values are published
+    // by the authoritative registry; starting a context does not free/reset it.
+    void BeginContext(std::uint64_t contextId)
+    {
+        _contextId.store(contextId, std::memory_order_relaxed);
+        _attempts.store(0, std::memory_order_relaxed);
+        _deferred.store(0, std::memory_order_relaxed);
+        _completed.store(0, std::memory_order_relaxed);
+        _recovered.store(0, std::memory_order_relaxed);
+        _needsRecovery.store(false, std::memory_order_relaxed);
+        _state.store(CleanupState::Running, std::memory_order_relaxed);
+        _reason.store(CleanupReason::None, std::memory_order_relaxed);
+        Publish();
+    }
+
+    void PublishPendingSnapshot(const PendingSnapshot& pending)
+    {
+        _pendingCurrent.store(pending.current, std::memory_order_relaxed);
+        _pendingPeak.store(pending.peak, std::memory_order_relaxed);
+        _registered.store(pending.registered, std::memory_order_relaxed);
+        _submitted.store(pending.submitted, std::memory_order_relaxed);
+        _resetDiscarded.store(pending.resetDiscarded, std::memory_order_relaxed);
+        _destroyed.store(pending.destroyed, std::memory_order_relaxed);
+        _oldestTick.store(pending.oldestObservedTickMs, std::memory_order_relaxed);
+        Publish();
+    }
+
+    void OnCleanupAttempt()
+    {
+        _attempts.fetch_add(1, std::memory_order_relaxed);
+        _state.store(CleanupState::Attempting, std::memory_order_relaxed);
+        _reason.store(CleanupReason::None, std::memory_order_relaxed);
+        Publish();
+    }
+
+    void OnCleanupDeferred(CleanupReason reason)
+    {
+        _deferred.fetch_add(1, std::memory_order_relaxed);
+        _needsRecovery.store(true, std::memory_order_relaxed);
+        _reason.store(reason, std::memory_order_relaxed);
+        _state.store(CleanupState::Deferred, std::memory_order_relaxed);
+        Publish();
+    }
+
+    void OnCleanupRecovered()
+    {
+        _completed.fetch_add(1, std::memory_order_relaxed);
+        if (_needsRecovery.exchange(false, std::memory_order_relaxed))
+            _recovered.fetch_add(1, std::memory_order_relaxed);
+        _reason.store(CleanupReason::None, std::memory_order_relaxed);
+        _state.store(CleanupState::Recovered, std::memory_order_relaxed);
+        Publish();
+    }
+
+    WorkSnapshot Read() const
+    {
+        // Approximate concurrent observation, not a transaction with the registry.
+        WorkSnapshot snapshot;
+        snapshot.contextId = _contextId.load(std::memory_order_relaxed);
+        snapshot.publishedTickMs = WorkNowMs();
+        snapshot.pending.current = _pendingCurrent.load(std::memory_order_relaxed);
+        snapshot.pending.peak = _pendingPeak.load(std::memory_order_relaxed);
+        snapshot.pending.registered = _registered.load(std::memory_order_relaxed);
+        snapshot.pending.submitted = _submitted.load(std::memory_order_relaxed);
+        snapshot.pending.resetDiscarded = _resetDiscarded.load(std::memory_order_relaxed);
+        snapshot.pending.destroyed = _destroyed.load(std::memory_order_relaxed);
+        snapshot.pending.oldestObservedTickMs = _oldestTick.load(std::memory_order_relaxed);
+        snapshot.cleanupAttempts = _attempts.load(std::memory_order_relaxed);
+        snapshot.cleanupDeferred = _deferred.load(std::memory_order_relaxed);
+        snapshot.cleanupCompleted = _completed.load(std::memory_order_relaxed);
+        snapshot.cleanupRecovered = _recovered.load(std::memory_order_relaxed);
+        snapshot.state = _state.load(std::memory_order_relaxed);
+        snapshot.reason = _reason.load(std::memory_order_relaxed);
+        return snapshot;
+    }
+
+  private:
+    void Publish() { WorkDetail::PublishLatest(Read()); }
+
+    std::atomic<std::uint64_t> _contextId { 0 };
+    std::atomic<std::uint64_t> _pendingCurrent { 0 }, _pendingPeak { 0 }, _registered { 0 }, _submitted { 0 };
+    std::atomic<std::uint64_t> _resetDiscarded { 0 }, _destroyed { 0 }, _oldestTick { 0 };
+    std::atomic<std::uint64_t> _attempts { 0 }, _deferred { 0 }, _completed { 0 }, _recovered { 0 };
+    std::atomic<bool> _needsRecovery { false };
+    std::atomic<CleanupState> _state { CleanupState::Running };
+    std::atomic<CleanupReason> _reason { CleanupReason::None };
+};
