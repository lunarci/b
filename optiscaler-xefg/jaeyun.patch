+bool XeFG_Dx12::TryCloseCpuAdmission()
+{
+    _workWasClosed = _workGate.IsClosed();
+    _presentWasClosed = _providerPresentGate.IsClosed();
+    _submissionWasClosed = _submissionGate.IsClosed();
+    _submissionClosedByLifecycle = false;
+    if (!_workGate.TryCloseWhenIdle())
+    {
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::CpuBusy);
+        return false;
+    }
+    if (!_providerPresentGate.TryCloseWhenIdle())
+    {
+        if (!_workWasClosed) _workGate.Open();
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::CpuBusy);
+        return false;
+    }
+    // Execute/Reset/final Release observation must stay alive even while the
+    // provider is paused: native game API calls always continue to execute.
+    return true;
+}
+
+void XeFG_Dx12::RestoreCpuAdmission()
+{
+    if (_submissionClosedByLifecycle && !_submissionWasClosed) _submissionGate.Open();
+    _submissionClosedByLifecycle = false;
+    if (!_presentWasClosed) _providerPresentGate.Open();
+    if (!_workWasClosed) _workGate.Open();
+}
+
+void XeFG_Dx12::RestoreProviderState(bool wasActive)
+{
+    if (!wasActive || _isActive || _swapChainContext == nullptr) return;
+    const auto result = XeFGProxy::SetEnabled()(_swapChainContext, true);
+    XeFGDiagnostics::RecordActivation(true, static_cast<int32_t>(result),
+                                       XeFGDiagnostics::ActivationReason::LifecycleRestore);
+    if (result == XEFG_SWAPCHAIN_RESULT_SUCCESS)
+        _isActive = true;
+    else
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::ProviderDisableFailed);
+}
+
+bool XeFG_Dx12::QuiesceWork()
+{
+    if (!TryCloseCpuAdmission()) return false;
+    bool pending;
+    {
+        std::lock_guard lock(_pendingCommandMutex);
+        PublishPendingLocked();
+        pending = !_pendingTrackingComplete || _pendingCommandListCount != 0;
+    }
+    if (pending)
+    {
+        RestoreCpuAdmission();
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::PendingUnsubmitted);
+        return false;
+    }
+    // Work admission is closed, so no new tracked recording can be added.
+    // Close observers only after pending == 0. If a callback is in flight,
+    // defer without closing it or losing its actual native API observation.
+    if (!_submissionGate.TryCloseWhenIdle())
+    {
+        RestoreCpuAdmission();
+        _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::CpuBusy);
+        return false;
+    }
+    _submissionClosedByLifecycle = true;
+    {
+        std::lock_guard lock(_pendingCommandMutex);
+        if (!_pendingTrackingComplete || _pendingCommandListCount != 0)
+        {
+            RestoreCpuAdmission();
+            _workDiagnostics.OnCleanupDeferred(XeFGDiagnostics::CleanupReason::PendingUnsubmitted);
+            return false;
+        }
+    }
+    return true;
+}
 
