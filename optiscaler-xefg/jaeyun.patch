+void XeFG_Dx12::AfterCommandSubmission(UINT count, ID3D12CommandList* const* lists,
+                                      uint64_t submittedThroughGeneration)
+{
+    if (submittedThroughGeneration == 0) return;
+    {
+        std::lock_guard lock(_pendingCommandMutex);
+        if (_pendingCommandListCount == 0) return;
+    }
+    for (UINT i = 0; i < count; ++i)
+    {
+        ID3D12CommandList* realList = nullptr;
+        if (!CheckForRealObject(__FUNCTION__, lists[i], (IUnknown**) &realList)) realList = lists[i];
+        std::lock_guard lock(_pendingCommandMutex);
+        for (size_t j = 0; j < _pendingCommandListCount;)
+            // Reset/re-record on another CPU thread can start after native
+            // Execute returns but before this callback. Never retire that newer
+            // recording merely because its command-list identity was reused.
+            if (realList == _pendingCommandLists[j].identity &&
+                _pendingCommandLists[j].generation <= submittedThroughGeneration)
+            {
+                _pendingCommandLists[j] = _pendingCommandLists[--_pendingCommandListCount];
+                ++_pendingStats.submitted;
+            }
+            else ++j;
+        PublishPendingLocked();
+    }
