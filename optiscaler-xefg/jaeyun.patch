+void XeFG_Dx12::DiscardPendingCommandList(ID3D12GraphicsCommandList* cmdList)
+{
+    ID3D12CommandList* realList = nullptr;
+    if (!CheckForRealObject(__FUNCTION__, cmdList, (IUnknown**) &realList)) realList = cmdList;
+    std::lock_guard lock(_pendingCommandMutex);
+    for (size_t i = 0; i < _pendingCommandListCount;)
+        if (_pendingCommandLists[i].identity == realList)
+        {
+            _pendingCommandLists[i] = _pendingCommandLists[--_pendingCommandListCount];
+            ++_pendingStats.resetDiscarded;
+        }
+        else ++i;
+    PublishPendingLocked();
