  "upstream_commits": [
    "42dc02af3718b510c86a815eed8c9793cb6d95ca",
    "b0dd6b02ce00cd2197493f358b127ec61579ee84",
    "04bf0b08d0253b02e2820b5c406cef49d704d04d",
    "d794b18d1046090fd922abea295c2512910cd12a"
  ],
  "custom_changes": [
    "XeFG resource transition restore only after an emitted transition; restore on tagging failure",
    "Transactional exact-provider MFG unlock and pacing hook rollback",
    "R2: use configured game-facing interpolation maximum before initialization and provider/config minimum afterward",
    "R2: restore input frame time priority; request pacing epoch reset across FG lifecycle and successful multiplier changes",
    "R2: latch current-frame reset requests across pauses and acknowledge only after successful XeFG dispatch setup",
    "R2: learn only valid/current SL depth and motion flags as volatile values; preserve explicit defaults during serialization",
    "R2: preflight initialized FFX resource inputs, sanitize invalid pre-exposure, restore original crop color and actual transitioned mask on dispatch failures",
    "R3: preserve owned-copy slots on allocation failure and drop invalid per-frame references",
    "R3: drain tracked submission queues and destroy Intel context before releasing owned copies, fences and helpers; retain resources safely on exceptional failed teardown",
    "R3: reset pacing on large timing discontinuities and bound only extra CPU pacing waits with checked deadlines; preserve native synchronization and input-time priority",
    "R3: initialize descriptor heap metadata outside registry publication lock",
    "R3: bounded observational process DXGI memory budgets and CPU timing diagnostics without residency changes or automatic RAM spill",
    "R4: preserve owned copy and matching resource state when internally re-tagging the same frame entry; clear stale bindings only for fresh input",
    "R4: close work admission and quiesce CPU resource users, pending recordings, actual command submissions and provider Present/Present1 before GPU drain and context teardown",
    "R4: protect command submissions and external helper recording within the context work lifetime; guard copy-map cleanup against concurrent resource registration",
    "R4: bounded owned-copy allocation and release accounting, input-missing reason and recovery summaries; preserve quality, 6x maximum and existing R3 pacing behavior",
    "R5: install submission/reset/final-release lifetime observers independently of HUD capture and frame-generation input; validate native queue/list implementation coverage",
    "R5: retain resources during recoverable FG alias transitions, avoid blocking pending-list waits and recover CPU admission after deferred cleanup",
    "R5: honor failed swapchain cleanup at all wrapper release boundaries; never consume borrowed backbuffer or wrapper references",
    "R5: backport OptiScaler 349176128f5ce87fb81a4c636569c60c44557fec backbuffer reference ownership correction from latest upstream",
    "R5: bounded lifetime observer, pending-work, cleanup-recovery and native-present timing diagnostics; preserve quality profile, unlocked 6x maximum and Intel runtime binaries",
    "R6: accept changed Hudless formats with instance-owned state and history reset; remove deterministic repeated format rejection",
    "R6: invalidate failed resource metadata and recover through bounded fresh coherent input trials without global repeated pause or multiplier reduction",
    "R6: query Intel status after native Present; separate CPU submissions, provider queued frame counts and actual display-completion limitations",
    "R6: propagate real residency failures except narrowly identified Intel AMD E_INVALIDARG compatibility case; add bounded caller-attributed allocation lifetime diagnostics",
    "R6: serialize FFX context type registry access across deferred destruction and foreground creation without holding locks across SDK calls",
    "R6: preserve all R5 lifetime protections, original quality profile, Intel runtime binaries, and unlocked maximum 6x",
    "R7: bind submitted command-list retirement to a per-call generation watermark; preserve Reset/re-recorded pending work",
    "R7: observe completed markers nonblockingly on already tracked queues, at most once per second per queue; no probe authorizes resource destruction",
